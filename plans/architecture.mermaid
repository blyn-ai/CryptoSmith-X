flowchart LR
  %% Состояние на 5 сентября 2026. Сплошная линия — построено, пунктир — нет.
  %% Стрелка = кто инициирует. Hub и WebApp делят ОДНУ базу намеренно (решение A,
  %% см. docs/decisions.md): консоль читает Postgres напрямую, без слоя API.

  LEG["Легенда<br/>Сплошная — работает сегодня, пунктир — не построено<br/>Стрелка = кто кого вызывает<br/>Hub и WebApp делят одну базу: это решение, а не недоделка"]

  subgraph OURS["Одна площадка — docker compose"]
    direction TB
    HUB["Hub — воркер, HTTP не слушает<br/>Коллекторы: snapshot 10 с, candles и depth 60 с,<br/>discovery и funding 60 мин, rollup 60 с<br/>Обнаружение инструментов и их жизненный цикл<br/>Роллап: 5…1440 каскадом, watermark шагами<br/>Часовая микроструктура: OI, спред, глубина"]
    DB[("PostgreSQL 16<br/>Месячные партиции, BRIN<br/>Снапшоты ротируются 90 дней<br/>Свечи не ротируются никогда<br/>LISTEN/NOTIFY канал csx_live")]
    WEB["WebApp — три роли в одном процессе<br/>1. Админская консоль (Razor, сырой SQL)<br/>2. Публичная входная страница и прототипы<br/>3. Приём событий ботов /api/ingest/events"]
    API["Api — 5 читающих эндпоинтов /v1<br/>health, exchanges, instruments, snapshot, candles<br/>Заготовка публичного шлюза"]
  end

  subgraph EXT["Биржи — только публичные эндпоинты, ключей нет"]
    direction TB
    KF["Kraken Futures<br/>REST + WS"]
    WX["WEEX Futures<br/>REST"]
    HL["Hyperliquid<br/>REST + WS"]
    BN["Binance USD-M<br/>запланирована"]
  end

  U["Оператор<br/>браузер через VPN"]
  BOT["Боты — не построены<br/>tenant и bot существуют, но пусты"]

  HUB -->|"public REST + WS"| KF
  HUB -->|"public REST"| WX
  HUB -->|"public REST + WS"| HL
  HUB -.->|"адаптера ещё нет"| BN

  HUB -->|"пишет"| DB
  WEB -->|"читает и пишет напрямую, ~94 запроса"| DB
  WEB -->|"LISTEN csx_live, отдельное соединение"| DB
  API -->|"читает"| DB

  U -->|"консоль, SSE"| WEB
  BOT -.->|"POST событий, ключ тенанта"| WEB
  BOT -.->|"GET рыночных данных"| API

  classDef ours fill:#dbe9ff,stroke:#2b6cb0,stroke-width:2px,color:#111111
  classDef store fill:#e6f6ec,stroke:#2f855a,stroke-width:2px,color:#111111
  classDef ext fill:#eeeeee,stroke:#777777,stroke-width:1.5px,color:#111111
  classDef todo fill:#ffffff,stroke:#999999,stroke-width:1.5px,stroke-dasharray:5 4,color:#555555
  classDef plain fill:#ffffff,stroke:#555555,stroke-width:1.5px,color:#111111
  classDef leg fill:#fff6cc,stroke:#b8860b,stroke-width:1.5px,stroke-dasharray:4 3,color:#111111
  class HUB,WEB,API ours
  class DB store
  class KF,WX,HL ext
  class BN,BOT todo
  class U plain
  class LEG leg
