# Copy to deploy/.env and adjust. Compose reads it automatically.
POSTGRES_DB=marketdata
POSTGRES_USER=marketdata
POSTGRES_PASSWORD=marketdata

# The migrator, the hub and the api all read this one connection string.
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=marketdata;Username=marketdata;Password=marketdata

# WebApp runtime. Development loads the dev conveniences; set Production for a real deployment.
# (Human sign-in accounts live in the database — no password is stored in the repo either way.)
WEBAPP_ENVIRONMENT=Development

# Where Docker volumes live on the host. Locally, point this at an external disk;
# leave unset and data lands in deploy/data. One subfolder per volume: postgres/, webapp-keys/.
# CSX_DATA_ROOT=/Volumes/YourDisk/cryptosmith-x

# Host port for Postgres (loopback only), for DataGrip/psql on this machine.
POSTGRES_HOST_PORT=5432
