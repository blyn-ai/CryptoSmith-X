# Copy to deploy/.env and adjust. Compose reads it automatically.
POSTGRES_DB=marketdata
POSTGRES_USER=marketdata
POSTGRES_PASSWORD=marketdata

# The migrator, the hub and the api all read this one connection string.
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=marketdata;Username=marketdata;Password=marketdata

# Studio, the public showcase, reads its own string — and it must be studio_reader, never
# marketdata: a public surface must not hold a credential that can write. The role and its
# grant list are migration 0025, which also creates it with this password on a host where the
# schema owner is allowed to create roles. Rotate it on any real deployment.
STUDIO_DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=marketdata;Username=studio_reader;Password=studio_reader;Maximum Pool Size=20

# WebApp.Admin runtime. Development loads the dev conveniences; set Production for a real deployment.
# (Human sign-in accounts live in the database — no password is stored in the repo either way.)
WEBAPP_ENVIRONMENT=Development

# Same switch for Studio, kept separate so the public site can be moved to Production without
# taking the admin console's dev conveniences away at the same time.
STUDIO_ENVIRONMENT=Development

# Sentry error monitoring for hub, api, webapp-admin and studio (one shared project, separated by a
# component tag). Leave empty to keep Sentry off locally; set the DSN on the VPS for prod.
SENTRY_DSN=

# Where Docker volumes live on the host. Locally, point this at an external disk;
# leave unset and data lands in deploy/data. One subfolder per volume: postgres/, webapp-admin-keys/.
# CSX_DATA_ROOT=/Volumes/YourDisk/cryptosmith-x

# Host port for Postgres (loopback only), for DataGrip/psql on this machine.
POSTGRES_HOST_PORT=5432
