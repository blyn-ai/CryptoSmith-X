@{
    ViewData["Title"] = "Sign in";
    ViewData["PageClass"] = "p-login";
    var refused = TempData["LoginFailed"] is true;
}

<div class="rule"></div>

<div class="stage">
<div class="sheet">

<header class="head">
<div class="lockup">
<span class="plate">
<svg aria-hidden="true" viewBox="4.6 12.43 30.8 15.14" width="46" height="23" fill="none">
<path d="M20 23.54 L15.97 27.57 L12.43 24.03 L16.46 20 L12.43 15.97 L15.97 12.43 L20 16.46 L24.03 12.43 L27.57 15.97 L23.54 20 L27.57 24.03 L24.03 27.57 Z" fill="currentColor"></path>
<circle cx="6.6" cy="20" r="2" fill="currentColor" opacity=".55"></circle>
<circle cx="33.4" cy="20" r="2" fill="currentColor" opacity=".55"></circle>
</svg>
</span>
<span class="words">
<span class="wordmark">CryptoSmith X</span>
<span class="subline" aria-label="Multi-venue · trading agent"><i>M</i><i>U</i><i>L</i><i>T</i><i>I</i><i>-</i><i>V</i><i>E</i><i>N</i><i>U</i><i>E</i><i class="sp"></i><i>·</i><i class="sp"></i><i>T</i><i>R</i><i>A</i><i>D</i><i>I</i><i>N</i><i>G</i><i class="sp"></i><i>A</i><i>G</i><i>E</i><i>N</i><i>T</i></span>
</span>
</div>
</header>

<div class="body">
<div style="display:flex;flex-direction:column;gap:8px">
<span class="eyebrow">Owner sign-in</span>
<h1 class="statement">One bot. One account. Your keys.</h1>
</div>

<div class="hair"></div>

@if (refused)
{
    @* One message for both failures. Which of the two it was is not the visitor's business. *@
    <p class="refused" role="alert">Wrong account or password</p>
}

<form method="post" asp-action="Login">
<label class="field">
<span class="label">Username</span>
@* type="text", not email: the accounts in webapp_user are names like "denis", and a browser
   that refuses to submit one because it has no @ in it would look like a broken form. *@
<input type="text" name="username" autocomplete="username" autofocus placeholder="owner">
</label>

<label class="field">
<span class="labelrow">
<span class="label">Password</span>
<button type="button" class="reveal" id="reveal">show</button>
</span>
<input type="password" name="password" id="password" autocomplete="current-password" placeholder="••••••••••••">
</label>

<div class="row">
@* A real checkbox, visually hidden behind the design's own box, rather than the mockup's
   aria-pressed button: the mockup never had to post anything, and a <button> does not. *@
<label class="remember">
<input type="checkbox" name="rememberMe" value="true">
<span class="box" aria-hidden="true"></span>
<span class="mono-ui" style="color:var(--text-body)">Remember me</span>
</label>
<a href="mailto:hello@blynai.eu?subject=CSX%20Agent%20password" class="mono-ui">Forgot?</a>
</div>

<button type="submit" class="submit">Sign in</button>
</form>

<div style="display:flex;flex-direction:column;gap:14px">
<div class="or"><span class="line"></span><span class="word">OR</span><span class="line"></span></div>
@* Disabled, and they stay on the page because the layout is the owner's. None of the five is
   wired to an identity provider, and a button that silently does nothing is worse than one
   that says it cannot. *@
<div class="socials">
<button type="button" disabled data-name="Google" aria-label="Google (not available)" title="Not available — accounts are created by invitation">
<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.35 11.1H12v2.98h5.35c-.23 1.4-1.66 4.1-5.35 4.1-3.22 0-5.85-2.67-5.85-5.95S8.78 6.28 12 6.28c1.83 0 3.06.78 3.76 1.45l2.56-2.47C16.68 3.72 14.53 2.8 12 2.8 6.92 2.8 2.8 6.92 2.8 12s4.12 9.2 9.2 9.2c5.31 0 8.83-3.73 8.83-8.99 0-.6-.06-1.06-.15-1.51z"></path></svg>
</button>
<button type="button" disabled data-name="Apple" aria-label="Apple (not available)" title="Not available — accounts are created by invitation">
<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.36 12.72c-.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.7-3.19-1.73-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.87-.76-1.48.02-2.84.86-3.6 2.18-1.53 2.66-.39 6.6 1.1 8.76.73 1.06 1.6 2.25 2.74 2.2 1.1-.04 1.52-.71 2.85-.71 1.33 0 1.71.71 2.87.69 1.19-.02 1.94-1.08 2.66-2.14.84-1.23 1.19-2.42 1.2-2.48-.03-.01-2.3-.88-2.3-3.5zM14.2 6.3c.6-.74 1.01-1.76.9-2.78-.87.04-1.93.58-2.56 1.31-.56.65-1.06 1.7-.93 2.7.97.08 1.97-.49 2.59-1.23z"></path></svg>
</button>
<button type="button" disabled data-name="GitHub" aria-label="GitHub (not available)" title="Not available — accounts are created by invitation">
<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85 0 1.34-.01 2.42-.01 2.75 0 .27.18.58.69.48A10 10 0 0 0 22 12c0-5.52-4.48-10-10-10z"></path></svg>
</button>
<button type="button" disabled data-name="Facebook" aria-label="Facebook (not available)" title="Not available — accounts are created by invitation">
<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94z"></path></svg>
</button>
<button type="button" disabled data-name="X" aria-label="X (not available)" title="Not available — accounts are created by invitation">
<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.53 3h3.02l-6.6 7.54L21.75 21h-5.9l-4.62-6.04L5.94 21H2.92l7.06-8.07L2.5 3h6.05l4.18 5.52L17.53 3z"></path></svg>
</button>
</div>
</div>

<div class="hair"></div>

<p class="note">Accounts are created by invitation only. Alpha sign-up — <a href="mailto:alfa@blynai.eu">alfa@blynai.eu</a></p>
</div>

<footer class="foot">
<p>Not investment advice · Own funds only</p>
</footer>

</div>
</div>

@section Scripts {
<script src="~/login.js?v=2"></script>
}
