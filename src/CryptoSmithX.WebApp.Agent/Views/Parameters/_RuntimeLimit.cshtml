@using System.Globalization
@using CryptoSmithX.WebApp.Agent.Models
@model RuntimeLimitViewModel
<label class="field @(Model.Error is null ? null : "bad")">
<span class="label">@Model.Label</span>
<span class="affix">
<input type="number" name="@Model.BindingName" inputmode="decimal" min="@Model.Minimum.ToString(CultureInfo.InvariantCulture)" max="@Model.Maximum.ToString(CultureInfo.InvariantCulture)" step="@Model.Step.ToString(CultureInfo.InvariantCulture)" required value="@Model.Value.ToString($"F{Model.DecimalPlaces}", CultureInfo.InvariantCulture)">
<span class="unit">@Model.Unit</span>
</span>
@if (Model.Error is { } error)
{
    <span class="bad-msg">@error</span>
}
<span class="field-scale"><span>← @Model.LowerCaption</span><span>@Model.HigherCaption →</span></span>
<p class="field-description">@Model.Description</p>
<p class="field-example">@Model.Example</p>
<details class="field-details">
<summary>Išsamiau</summary>
<div>
<p>@Model.DetailIntro</p>
<dl>
<div><dt>Mažiau</dt><dd>@Model.LowerImpact</dd></div>
<div><dt>Daugiau</dt><dd>@Model.HigherImpact</dd></div>
<div><dt>Kaip tai veikia techniškai</dt><dd>@Model.Technical</dd></div>
</dl>
</div>
</details>
</label>
