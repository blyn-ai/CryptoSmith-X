@{
    ViewData["Title"] = "Nustatymų nepavyko parodyti";
    ViewData["PageClass"] = "p-params";
}

<header class="head">
<span class="brand"><span class="wordmark">CryptoSmith X</span></span>
<span class="account"><span class="who">@User.Identity?.Name</span></span>
</header>

<main>
<section class="panel">
<div class="panel-head"><span class="eyebrow">Strategijos nustatymai</span></div>
<p class="note-source" style="margin:14px 12px">Šio puslapio nepavyko surinkti. Boto nustatymai nepakeisti — nieko neįrašyta. Klaida užrašyta serverio žurnale; pabandyk perkrauti puslapį, o jei kartojasi — praneškite.</p>
</section>
</main>
