@using System.Globalization
@using CryptoSmithX.WebApp.Agent.Data
@using CryptoSmithX.WebApp.Agent.Models
@model ParametersViewModel
@{
    ViewData["Title"] = "Strategijos nustatymai";
    ViewData["PageClass"] = "p-params";

    string? Err(string key) => Model.Errors.TryGetValue(key, out var message) ? message : null;
    string? UniverseErr(string key) => Model.Universe.Errors.TryGetValue(key, out var message) ? message : null;
    StrategyParameterViewModel Parameter(string id) => Model.StrategyParameters.Single(p => p.Definition.Id == id);

    // Метка у сверта — из макета, и считается из самого значения: до 5× сбалансировано,
    // до 7× повышенно, дальше агрессивно. Единственное поле, у которого метка есть.
    string? LeverageTag(decimal x) => x <= 5m ? "Subalansuota" : x <= 7m ? "Padidinta" : "Agresyvu";

    FieldCard FromLimit(RuntimeLimitViewModel l) => new(
        l.BindingName, l.Label, l.Unit, l.Value, l.Minimum, l.Maximum, l.Step, l.DecimalPlaces,
        l.LowerCaption, l.HigherCaption, l.Description, l.Example,
        l.DetailIntro, l.LowerImpact, l.HigherImpact, l.Technical,
        Editable: true,
        Tag: string.Equals(l.Key, "leverage", StringComparison.Ordinal) ? LeverageTag(l.Value) : null,
        Hint: null, Error: l.Error);

    FieldCard FromParameter(StrategyParameterViewModel p)
    {
        var d = p.Definition;

        // A parameter the profile does not carry: no binding name, so the form cannot post it and
        // the server cannot be asked to write a key the bot was not reading. The card still appears
        // — hiding it would make the screen claim the strategy has nineteen parameters when it has
        // twenty, one of which is unaccounted for.
        var missing = p.Value is null;

        // Decided elsewhere — the markets count, when the Universe row sets it. Shown locked, with
        // the figure the worker actually runs and the section that decides it.
        var decidedElsewhere = p.LockReason is not null;

        return new FieldCard(
            missing ? null : $"Parameters[{d.Id}]",
            d.Label, d.Unit, p.Value ?? 0m, d.Minimum, d.Maximum, d.Step, d.DecimalPlaces,
            d.LowerCaption, d.HigherCaption, d.Description, d.Example,
            d.DetailIntro, d.LowerImpact, d.HigherImpact, d.Technical,
            Editable: !missing && !decidedElsewhere, Tag: null,
            Hint: missing
                ? "Šio nustatymo šiame strategijos profilyje nėra — boto worker jo neskaito."
                : p.LockReason,
            Error: p.Error,
            Missing: missing,
            // The exit mode not on screen: its cards are drawn, hidden with their group and with
            // disabled inputs, so they neither post nor block the form — and their stored values
            // stay in the profile untouched.
            Inactive: !p.IsEnabled,
            LockedNote: decidedElsewhere ? "Valdo „Prekybos poros“" : null);
    }

    var tradeParameters = new[] { "markets", "volume", "longScore", "shortScore", "spread", "btcDrop", "btcBars" }
        .Select(id => FromParameter(Parameter(id))).ToList();
    var fixedExitParameters = new[] { "fixedStop", "fixedTakeProfit", "fixedTrail" }
        .Select(id => FromParameter(Parameter(id))).ToList();
    var atrExitParameters = new[] { "stop", "trail", "atrTrail" }
        .Select(id => FromParameter(Parameter(id))).ToList();
    var exitParameters = new[] { "maxHold", "cooldown" }
        .Select(id => FromParameter(Parameter(id))).ToList();
    var atrMode = Model.ExitMode.AtrMode;

    var universe = Model.Universe;
    var autoInstrumentCard = new FieldCard(
        UniverseFields.AutoInstrumentCount, "Automatiškai renkamų porų skaičius", "porų",
        universe.AutoInstrumentCount, UniversePairList.MinimumAutoInstrumentCount, UniversePairList.MaximumAutoInstrumentCount, 1m, 0,
        "Tik pasirinktos poros", "Platesnė atranka",
        "Kiek aktyviausių futures porų botas kas ciklą atsirenka pats. 0 — automatinės atrankos nėra: lieka tik visada įtrauktos poros ir jau atidarytos pozicijos.",
        $"Dabar: {universe.SavedAutoInstrumentCount} automatiškai + {universe.SavedForceIncludeCount} visada įtrauktų · {universe.SavedForceExcludeCount} neįtrauktų.",
        "Botas kas ciklą surikiuoja registro futures poras pagal aktyvumą ir paima nurodytą skaičių. Visada įtrauktos poros pridedamos papildomai.",
        "Mažiau porų — ramesnis srautas, mažiau signalų.",
        "Daugiau porų — daugiau progų, bet ir daugiau triukšmo.",
        "Saugoma kaip bot_universe_preferences.auto_instrument_count. Worker šį skaičių taiko po strategijos profilio, todėl jis pakeičia profilio Trading.MaxActiveInstruments.",
        Editable: true, Tag: null, Hint: null, Error: UniverseErr(UniverseFields.AutoInstrumentCount));

    var exposure = Model.Profile.PositionMarginUsd * Model.Profile.Leverage * Model.Profile.MaxOpenPositions;
    var elevatedRisk = exposure >= 10_000m || Model.Profile.Leverage >= 8m;
}

<header class="head">
    <span class="brand">
        <svg aria-hidden="true" viewBox="4.6 12.43 30.8 15.14" width="26" height="13" fill="none">
            <path d="M20 23.54 L15.97 27.57 L12.43 24.03 L16.46 20 L12.43 15.97 L15.97 12.43 L20 16.46 L24.03 12.43 L27.57 15.97 L23.54 20 L27.57 24.03 L24.03 27.57 Z" fill="currentColor"></path>
            <circle cx="6.6" cy="20" r="2" fill="currentColor" opacity=".55"></circle>
            <circle cx="33.4" cy="20" r="2" fill="currentColor" opacity=".55"></circle>
        </svg>
        <span class="wordmark">CryptoSmith X</span>
    </span>
    <span class="account">
        <span class="who">@User.Identity?.Name</span>
        <form method="post" asp-controller="Home" asp-action="Logout"><button type="submit" class="logout">Atsijungti</button></form>
    </span>
</header>

@* Подшапка макета: какая стратегия открыта, менялось ли что-то с загрузки, и вход в список
   сохранённого. Прилипает под шапкой — отсюда --head-h. *@
<div class="subbar">
    <span class="subbar-eyebrow">Strategija</span>
    <span class="subbar-name">@Model.StrategyProfileName · rev. @Model.StrategyRevision</span>
    <span class="subbar-unsaved" hidden data-unsaved>Pakeista</span>
    <button type="button" class="subbar-load" data-open="saved">Išsaugoti nustatymai · @Model.RevisionHistory.Count</button>
</div>

<main>
<div class="modeler-heading">
    <h1>Strategijos nustatymai</h1>
    <span class="profile-line"><span>@Model.PublicAlias</span><span>@Model.BotInstanceId</span></span>
    <p>Viršuje — pinigai ir ekspozicija · žemiau — kaip agresyviai botas elgiasi ir išėjimo taisyklės · po jų — kuriomis poromis prekiaujama.</p>
</div>

@* PAUZĖ. Nulinė marža reiškia, kad naujų pozicijų atidaryti nėra iš ko, ir tai vienintelė šio
   ekrano reikšmė, kuri reiškia ne dydį, o būseną. Todėl ji sakoma garsiai ir viršuje — ne mažu
   šriftu prie lauko, kurį reikia susirasti. Jau atidarytos pozicijos gyvena toliau: jos nuo šio
   skaičiaus nepriklauso, ir tylėti apie tai reikštų pažadėti sustabdymą, kurio nėra. *@
@* Visada dokumente, paslėptas atributu — kad parameters.js galėtų jį uždegti TĄ PAČIĄ AKIMIRKĄ,
   kai į lauką įvedamas nulis, o ne tik po išsaugojimo. Serveris nustato pirmąją būseną, todėl be
   JS puslapis vis tiek sako tiesą apie tai, kas išsaugota. *@
<p class="paused" role="alert" data-paused hidden="@(Model.Profile.PositionMarginUsd == 0m ? null : "hidden")">
    <b>Botas pristabdytas</b>
    Pozicijos marža — 0. Naujų pozicijų botas neatidarys. Jau atidarytos pozicijos lieka atidarytos ir valdomos įprastai.
</p>
@if (Model.JustSaved)
{
    <p class="landed" role="status">Išsaugota. Nauji įėjimai naudos šią strategijos reviziją po kito worker atnaujinimo. Jau atidarytos pozicijos nesikeis.</p>
}
@if (Model.SaveConflict)
{
    <p class="refused" role="alert">Strategija pasikeitė, kol buvo atidarytas šis puslapis. Žemiau rodoma dabartinė revizija — peržiūrėk ir išsaugok dar kartą.</p>
}
@if (Err("strategy") is { } strategyError)
{
    <p class="refused" role="alert">@strategyError</p>
}

<form id="limits" method="post" asp-action="Save" class="modeler-form">
<input type="hidden" name="strategyProfileId" value="@Model.StrategyProfileId">
<input type="hidden" name="strategyRevision" value="@Model.StrategyRevision">
<input type="hidden" name="changeNote" id="change-note">

<section class="modeler-section">
    <div class="section-heading"><span>1</span><h2>Kapitalas ir limitai</h2><span>Redaguojama</span></div>
    <div class="csx-grid">
        @foreach (var limit in Model.RuntimeLimits)
        {
            <partial name="_Field" model="FromLimit(limit)" />
        }
    </div>
    <div class="risk-panel @(elevatedRisk ? "elevated" : null)" data-risk-panel>
        <span><span>Rizikos lygis</span><strong data-risk-level>@(elevatedRisk ? "Padidintas" : "Įprastas")</strong></span>
        <p data-risk-text>@Model.Profile.PositionMarginUsd.ToString("0.##", CultureInfo.InvariantCulture) USD × @Model.Profile.Leverage.ToString("0.#", CultureInfo.InvariantCulture) svertas × iki @Model.Profile.MaxOpenPositions pozicijų gali reikšti iki @exposure.ToString("0.##", CultureInfo.InvariantCulture) USD bendros ekspozicijos rinkoje.</p>
    </div>
</section>

<section class="modeler-section">
    <div class="section-heading"><span>2</span><h2>Prekybos elgsena</h2><span>Redaguojama</span></div>
    <p class="section-note">Šie nustatymai keičia tik naujų sandorių atranką. Suskaičiuotos taisyklės, turinčios kelias ribas, rodomos atskirai.</p>
    <div class="csx-grid">
        @foreach (var card in tradeParameters)
        {
            <partial name="_Field" model="card" />
        }
        @* Составное правило: у него нет одного числа, и макет рисует его такой же карточкой,
           но с запертым значением вместо поля. *@
        <div class="field csx-wide">
            <div class="field-head"><span class="label">Vėlyvo įėjimo apsauga</span></div>
            <span class="locked">
                <span class="locked-pair">
                    <span class="locked-value">4</span>
                    <span class="locked-unit">taisyklės</span>
                </span>
                <span class="locked-note">Suskaičiuotos taisyklės</span>
            </span>
            <p class="field-description">Botas tikrina kelias ribas, kad neįeitų į jau per toli nuėjusią kainą.</p>
            <p class="field-example">Šios ribos išlieka strategijos profilyje ir šiame ekrane jų nesujungiame į vieną išgalvotą skaičių.</p>
            <button type="button" class="more" data-sheet
                    data-title="Vėlyvo įėjimo apsauga"
                    data-intro="Neleidžia botui vytis kainos, jei ji jau stipriai pajudėjo. Tai kelios atskiros taisyklės, ne vienas skaičius."
                    data-tech="Taisyklės tikrinamos nuosekliai po balo ribos: run-up per paskutines žvakes, atstumas nuo greitos EMA, kainos nuklydimas nuo tos, kuriai skaičiuotas signalas, ir atstumas iki vietinės viršūnės."
                    data-note="Kiekviena taisyklė turi savo ribą strategijos profilyje ir keičiama atskirai, ne vienu bendru skaičiumi."
                    data-rows="Šuolis prieš įėjimą=Įjungta|Atotrūkis nuo vidurkio=Įjungta|Nuklydimas nuo signalo kainos=Įjungta|Artumas prie vietinės viršūnės=Įjungta">Išsamiau</button>
        </div>
    </div>
</section>

<section class="modeler-section">
    <div class="section-heading"><span>3</span><h2>Rizika ir išėjimas</h2><span>Redaguojama</span></div>
    @* Режим выхода — один переключатель профиля, Exits.AtrTrailingRegimeEnabled. Поля другого
       режима остаются в документе: скрыты вместе с группой и выключены, поэтому не уходят с
       формой, а их значения в профиле не трогаются. Без скриптов сервер отвечает на выбор
       режима, показывая нужную группу. *@
    <div class="field csx-wide exit-mode" role="radiogroup" aria-labelledby="exit-mode-label"
         data-exit-mode data-saved-mode="@(Model.ExitMode.SavedAtrMode ? "true" : "false")">
        <div class="field-head"><span class="label" id="exit-mode-label">Išėjimo režimas</span></div>
        <div class="exit-mode-options">
            <label class="exit-mode-option">
                <input type="radio" name="atrTrailingRegimeEnabled" value="false"
                       checked="@(atrMode ? null : "checked")" disabled="@(Model.ExitMode.Editable ? null : "disabled")">
                <span>Fiksuoti procentai</span>
            </label>
            <label class="exit-mode-option">
                <input type="radio" name="atrTrailingRegimeEnabled" value="true"
                       checked="@(atrMode ? "checked" : null)" disabled="@(Model.ExitMode.Editable ? null : "disabled")">
                <span>ATR trailing</span>
            </label>
        </div>
        <p class="field-description" data-exit-note="fixed" hidden="@(atrMode ? "hidden" : null)">Stop loss, take profit ir trailing — fiksuoti procentai nuo įėjimo kainos. Pasiekus take profit ribą įsijungia trailing stop, todėl pozicija nebūtinai uždaroma tiksliai ties take profit: ji uždaroma, kai kaina atsitraukia trailing atstumu.</p>
        <p class="field-description" data-exit-note="atr" hidden="@(atrMode ? null : "hidden")">Stop loss ir trailing matuojami ATR — rinkos svyravimu. Fiksuoto take profit šiame režime nėra: pelną saugo tik trailing stop, kuris įsijungia pasiekus aktyvacijos ribą R vienetais.</p>
        <p class="field-example">Kito režimo reikšmės lieka profilyje nepakeistos — grįžus prie jo, jos vėl galios.</p>
        @if (!Model.ExitMode.Editable)
        {
            <span class="hint">Šiame profilyje režimo jungiklio nėra — worker naudoja fiksuotus procentus.</span>
        }
    </div>
    <div class="csx-grid" data-exit-group="fixed" hidden="@(atrMode ? "hidden" : null)">
        @foreach (var card in fixedExitParameters)
        {
            <partial name="_Field" model="card" />
        }
    </div>
    <div class="csx-grid" data-exit-group="atr" hidden="@(atrMode ? null : "hidden")">
        @foreach (var card in atrExitParameters)
        {
            <partial name="_Field" model="card" />
        }
    </div>
    <div class="csx-grid">
        @foreach (var card in exitParameters)
        {
            <partial name="_Field" model="card" />
        }
    </div>
</section>

<section class="sticky-save">
    <span class="save-status">
        <span id="status" data-state="saved" data-idle="Išsaugota">Išsaugota</span>
        <span class="invalid" hidden data-invalid>Patikrink pažymėtus laukus</span>
    </span>
    <button type="submit" class="save">Išsaugoti</button>
    <p>Pakeitimai bus taikomi naujoms pozicijoms. Jau atidarytos pozicijos nesikeis.</p>
</section>

<div class="reset-block">
    <button type="button" class="reset-ask" data-reset-ask>Atstatyti išsaugotas reikšmes</button>
    <div class="reset-confirm" hidden data-reset-confirm>
        <p>Atstatyti visas reikšmes į <span>@Model.StrategyProfileName</span> išsaugotas? Tavo pakeitimai bus prarasti.</p>
        <span>
            <button type="button" class="btn-danger" data-reset-do>Taip, atstatyti</button>
            <button type="button" class="btn-quiet" data-reset-cancel>Atšaukti</button>
        </span>
    </div>
</div>
</form>

@* Вселенная пар — отдельная форма: она пишет не ревизию профиля, а строку
   bot_universe_preferences, и у неё своя кнопка. Бота форма не называет — сервер берёт его из
   входа. Без строки в базе формы нет: создать её значило бы молча заменить списки, которые
   worker сейчас берёт из своей конфигурации. *@
<section class="modeler-section universe-section" id="universe" aria-labelledby="universe-title">
    <div class="section-heading"><span>4</span><h2 id="universe-title">Prekybos poros</h2><span>@(universe.Configured ? "Redaguojama" : "Tik peržiūrai")</span></div>
    <p class="section-note">Tik futures. Porų sąrašas bendras visiems botams — @universe.RegistryPairCount aktyvių futures porų biržos registre. Čia nustatai tik tai, kuo šis botas nuo jo skiriasi.</p>
    @if (universe.JustSaved)
    {
        <p class="landed" role="status">Poros išsaugotos. Worker jas pritaikys per kitą savo ciklą. Jau atidarytos pozicijos nesikeis.</p>
    }
    @if (universe.Conflict)
    {
        <p class="refused" role="alert">Poros pasikeitė, kol buvo atidarytas šis puslapis. Žemiau rodomos dabartinės — peržiūrėk ir išsaugok dar kartą.</p>
    }
    @if (UniverseErr("universe") is { } universeError)
    {
        <p class="refused" role="alert">@universeError</p>
    }

    @if (!universe.Configured)
    {
        <p class="empty">Šiam botui porų nustatymų boto duomenų bazėje nėra — worker naudoja savo diegimo konfigūraciją, o šis ekranas jos nekeičia.</p>
    }
    else
    {
        <form method="post" asp-action="SaveUniverse" class="universe-form" data-universe-form>
            <input type="hidden" name="universeVersion" value="@universe.Version">
            <div class="csx-grid">
                <div class="csx-wide"><partial name="_Field" model="autoInstrumentCard" /></div>
                <div class="field @(UniverseErr(UniverseFields.ForceIncludePairs) is null ? null : "bad")">
                    <div class="field-head">
                        <label class="label" for="universe-include">Visada įtraukti</label>
                        <span class="tag">@universe.SavedForceIncludeCount porų</span>
                    </div>
                    <textarea id="universe-include" name="@UniverseFields.ForceIncludePairs" rows="6" spellcheck="false" autocomplete="off" autocapitalize="characters">@universe.ForceIncludeText</textarea>
                    @if (UniverseErr(UniverseFields.ForceIncludePairs) is { } includeError)
                    {
                        <span class="bad-msg">@includeError</span>
                    }
                    <p class="field-description">Šios poros pridedamos papildomai prie automatiškai atrinktų — į automatinį skaičių jos neįskaičiuojamos.</p>
                    <p class="field-example">Poras atskirk kableliu, kabliataškiu arba nauja eilute, pvz. XBT/USD, ETH/USD. Didžiosios raidės ir pasikartojimai sutvarkomi automatiškai.</p>
                </div>
                <div class="field @(UniverseErr(UniverseFields.ForceExcludePairs) is null ? null : "bad")">
                    <div class="field-head">
                        <label class="label" for="universe-exclude">Niekada neatidaryti</label>
                        <span class="tag">@universe.SavedForceExcludeCount porų</span>
                    </div>
                    <textarea id="universe-exclude" name="@UniverseFields.ForceExcludePairs" rows="6" spellcheck="false" autocomplete="off" autocapitalize="characters">@universe.ForceExcludeText</textarea>
                    @if (UniverseErr(UniverseFields.ForceExcludePairs) is { } excludeError)
                    {
                        <span class="bad-msg">@excludeError</span>
                    }
                    <p class="field-description">Šiose porose naujos pozicijos nebeatidaromos. Jau atidarytos pozicijos jose lieka ir valdomos iki galo.</p>
                    <p class="field-example">Pora negali būti ir visada įtraukta, ir neįtraukta.</p>
                </div>
            </div>
            <div class="universe-actions">
                <button type="submit" class="btn-primary">Išsaugoti poras</button>
                @if (universe.UpdatedAt is { } universeUpdatedAt)
                {
                    <p>Paskutinį kartą keista <time datetime="@universeUpdatedAt.ToUniversalTime().ToString("O")">@universeUpdatedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</time>@(universe.UpdatedBy is { Length: > 0 } by ? " · " + by : null)</p>
                }
            </div>
        </form>
    }
</section>

<section class="modeler-section">
    <div class="section-heading"><span>5</span><h2>Strategijos vidiniai parametrai</h2><span>Tik peržiūrai</span></div>
    <button type="button" class="internals-toggle" data-internals-toggle aria-expanded="false">Rodyti vidinius parametrus</button>
    <div class="csx-grid" hidden data-internals>
        @foreach (var (label, value, description) in new[]
        {
            ("EMA greitas / lėtas", "9 / 21", "Padeda botui įvertinti trumpalaikę kainos kryptį."),
            ("RSI periodas", "14", "Padeda įvertinti, ar kaina juda per greitai viena kryptimi."),
            ("Minimalus EMA tarpas", "0,15 %", "Kiek kryptį rodančios linijos turi būti prasiskyrusios, kad kryptis būtų laikoma tikra."),
            ("BTC režimo vartai", "Įjungta", "Ar atsižvelgiama į bendrą rinkos kryptį pagal Bitcoin."),
            ("Santykinio stiprumo vartai", "≥ 1,05", "Ar kriptovaliuta ar akcija juda stipriau nei visa rinka kartu."),
            ("ATR periodas", "14", "Rinkos svyravimo matas, naudojamas išėjimo taisyklėse."),
        })
        {
            <div class="internal-card">
                <span><span class="internal-label">@label</span><span class="internal-value">@value</span></span>
                <p>@description</p>
                <button type="button" class="link-btn" data-sheet
                        data-title="@label"
                        data-intro="@description"
                        data-tech="Reikšmė ateina iš priskirto strategijos profilio ir taikoma visoms šios instancijos pozicijoms nuo kito ciklo."
                        data-note="Šis parametras priklauso strategijos modeliui ir per šį ekraną nekeičiamas."
                        data-rows="Reikšmė=@value|Šaltinis=Strategijos profilis">Išsamiau</button>
            </div>
        }
    </div>
</section>

<section class="modeler-section kraken-section" aria-labelledby="kraken-credentials-title">
    <div class="section-heading"><span>6</span><h2 id="kraken-credentials-title">Kraken API raktai</h2><span>Redaguojama</span></div>
    <button type="button" class="internals-toggle" data-kraken-toggle aria-expanded="false">Rodyti / redaguoti API raktus</button>

    <div class="kraken-content" hidden data-kraken-content>
        <p class="section-note">Kiekvienai Kraken paskyrai reikia dviejų reikšmių. Spot raktai naudojami balansui, indėliams ir pervedimams. Futures raktai naudojami prekybai.</p>

        @if (Model.KrakenCredentialNotice is { } credentialNotice)
        {
            <p class="landed" role="status">@credentialNotice</p>
        }
        @if (Model.KrakenCredentialError is { } credentialError)
        {
            <p class="refused" role="alert">@credentialError</p>
        }

        <div class="kraken-grid">
            @foreach (var credential in Model.KrakenCredentials)
            {
                var isSpot = credential.Scope == "kraken_spot";
                var apiKeyLabel = isSpot ? "API key" : "Public key";
                <div class="kraken-card">
                    <div class="kraken-card-head">
                        <span>
                            <span class="kraken-title">@credential.Title</span>
                            <span class="kraken-description">@(isSpot
                                ? "Balansas, indėliai ir pervedimai."
                                : "Futures pozicijų atidarymas ir uždarymas.")</span>
                        </span>
                        @if (credential.Credentials.Configured)
                        {
                            <span class="kraken-state good">Prijungta</span>
                        }
                        else
                        {
                            <span class="kraken-state">Neprijungta</span>
                        }
                    </div>

                    @if (credential.Credentials.Configured)
                    {
                        <div class="kraken-current">
                            <span><span>@apiKeyLabel</span><b>@credential.Credentials.ApiKeyHint</b></span>
                            <span><span>Private key</span><b>@credential.Credentials.ApiSecretHint</b></span>
                            <span><span>Išsaugota</span><time datetime="@credential.Credentials.UpdatedAt?.ToUniversalTime().ToString("O")">@credential.Credentials.UpdatedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</time></span>
                        </div>
                        <div class="kraken-saved-check">
                            <button type="button" class="btn-quiet" data-kraken-check-saved data-scope="@credential.Scope" data-validate-saved-url="@Url.Action("ValidateSavedKrakenCredentials", "Parameters")">Patikrinti ryšį</button>
                            <p class="kraken-validation" role="status" aria-live="polite" data-kraken-saved-status>Patikrina dabar išsaugotus raktus ir jų teises.</p>
                        </div>
                        <div class="kraken-permissions" hidden data-kraken-permissions>
                            <span class="kraken-permissions-title">Rakto teisės</span>
                            <div data-kraken-permission-groups></div>
                        </div>
                    }

                    <details class="kraken-change" open="@(credential.Credentials.Configured ? null : "open")">
                        <summary>@(credential.Credentials.Configured ? "Redaguoti šią raktų porą" : "Prijungti raktų porą")</summary>
                        <div class="kraken-change-body">
                            <p>Įvesk naują porą tik tada, kai nori pakeisti dabar išsaugotus raktus.</p>
                            <form method="post" asp-action="SaveKrakenCredentials" data-kraken-credentials data-validate-url="@Url.Action("ValidateKrakenCredentials", "Parameters")">
                                <input type="hidden" name="scope" value="@credential.Scope">
                                <label class="kraken-field">
                                    <span class="label">@apiKeyLabel</span>
                                    <input type="text" name="apiKey" autocomplete="off" spellcheck="false" required data-kraken-input>
                                </label>
                                <label class="kraken-field">
                                    <span class="labelrow"><span class="label">Private key</span><button type="button" class="link-btn" data-kraken-reveal>Rodyti</button></span>
                                    <input type="password" name="apiSecret" autocomplete="new-password" spellcheck="false" required data-kraken-input>
                                </label>
                                <p class="kraken-validation" role="status" aria-live="polite" data-kraken-status>Patikrink naują raktų porą prieš išsaugodamas.</p>
                                <div class="kraken-actions">
                                    <button type="button" class="btn-quiet" data-kraken-validate>Patikrinti</button>
                                    <button type="submit" class="btn-primary" data-kraken-save>Išsaugoti naujus raktus</button>
                                </div>
                            </form>

                            @if (credential.Credentials.Configured)
                            {
                                <form method="post" asp-action="RevokeKrakenCredentials" class="kraken-revoke" data-kraken-revoke data-kraken-scope="@credential.Title">
                                    <input type="hidden" name="scope" value="@credential.Scope">
                                    <p>Pašalina šią raktų porą iš boto duomenų bazės.</p>
                                    <button type="submit" class="btn-danger">Pašalinti raktus iš boto</button>
                                </form>
                            }
                        </div>
                    </details>
                </div>
            }
        </div>
    </div>
</section>

<p class="compliance">Ne investavimo rekomendacija · Tik nuosavos lėšos</p>
</main>

@* ── Подтверждение сохранения ──────────────────────────────────────────────
   Механизм тот же, что был: форма отправляется только после подтверждения, скрипт
   переносит примечание в скрытое поле и вызывает requestSubmit. Со скриптами наотрез
   форма уходит напрямую и сервер проверяет её точно так же. *@
<dialog id="confirm" class="overlay" aria-labelledby="confirm-title">
    <form method="dialog" class="panel">
        <div class="panel-head">
            <span class="panel-title" id="confirm-title">Išsaugoti nustatymus</span>
            <button type="submit" value="cancel" class="panel-close" aria-label="Uždaryti">✕</button>
        </div>
        <div class="panel-body tight">
            <span class="dialog-field">
                <span class="dialog-eyebrow">Pavadinimas</span>
                <span class="dialog-name">Revizija @(Model.StrategyRevision + 1)</span>
                <span class="dialog-small">Vardas sudaromas automatiškai: revizijos numeris didėja per vieną.</span>
            </span>
            @* Четыре числа, которые сейчас станут ботовскими. В макете этого списка нет, но это
               существующая защита формы, а не оформление, и убирать её — менять поведение. *@
            <div class="sheet-rows">
                <span class="sheet-row"><span>Pozicijos marža</span><span data-for="positionMarginUsd"></span></span>
                <span class="sheet-row"><span>Svertas</span><span data-for="leverage"></span></span>
                <span class="sheet-row"><span>Daugiausia atvirų pozicijų</span><span data-for="maxOpenPositions"></span></span>
                <span class="sheet-row"><span>Daugiausia vienoje grupėje</span><span data-for="maxOpenPositionsPerGroup"></span></span>
                <span class="sheet-row"><span>Išėjimo režimas</span><span data-for-mode></span></span>
            </div>
            <label class="dialog-field">
                <span class="dialog-eyebrow">Pastabos</span>
                <textarea id="revision-note" maxlength="1000" rows="3" placeholder="Pvz. mažesnis svertas savaitgaliui"></textarea>
                <span class="dialog-small">Neprivaloma. Padeda vėliau atpažinti, kodėl taip nustatei.</span>
            </label>
            <p class="field-example">Pakeitimai bus taikomi naujoms pozicijoms. Jau atidarytos pozicijos nesikeis.</p>
            <div class="dialog-actions">
                <button type="submit" value="save" class="btn-primary">Išsaugoti</button>
                <button type="submit" value="cancel" class="btn-quiet">Atšaukti</button>
            </div>
        </div>
    </form>
</dialog>

<dialog id="kraken-revoke-confirm" class="overlay" aria-labelledby="kraken-revoke-title">
    <form method="dialog" class="panel">
        <div class="panel-head">
            <span class="panel-title" id="kraken-revoke-title">Pašalinti Kraken raktus</span>
            <button type="submit" value="cancel" class="panel-close" aria-label="Uždaryti">✕</button>
        </div>
        <div class="panel-body tight">
            <p class="sheet-intro">Pašalinsi <strong data-kraken-revoke-scope></strong> raktų porą iš boto duomenų bazės.</p>
            <p class="field-example">Šio veiksmo negalima atšaukti šiame ekrane. Norėdamas vėl prijungti Kraken paskyrą, įvesk ir patikrink naują raktų porą.</p>
            <div class="dialog-actions">
                <button type="submit" value="remove" class="btn-danger">Pašalinti raktus</button>
                <button type="submit" value="cancel" class="btn-quiet">Atšaukti</button>
            </div>
        </div>
    </form>
</dialog>

@* ── Сохранённые настройки ─────────────────────────────────────────────────
   Список ревизий макета. Кнопки «загрузить» здесь нет: восстановления ревизии на сервере
   не существует, а кнопка, которая ничего не делает, — обещание, которого не будет. *@
<dialog id="saved" class="overlay" aria-labelledby="saved-title">
    <div class="panel">
        <div class="panel-head">
            <span class="panel-title" id="saved-title">Išsaugoti nustatymai</span>
            <button type="button" class="panel-close" data-close aria-label="Uždaryti">✕</button>
        </div>
        <div class="panel-body">
            @if (Model.RevisionHistory.Count == 0)
            {
                <p class="empty">Kol kas nėra išsaugotų strategijos revizijų.</p>
            }
            else
            {
                foreach (var revision in Model.RevisionHistory)
                {
                    <div class="saved-item @(revision.Revision == Model.StrategyRevision ? "current" : null)">
                        <span class="saved-line">
                            <span class="saved-name">Revizija @revision.Revision</span>
                            @if (revision.Revision == Model.StrategyRevision)
                            {
                                <span class="saved-badge">Dabartinė</span>
                            }
                            <time class="saved-when" datetime="@revision.CreatedAt.ToUniversalTime().ToString("O")">@revision.CreatedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</time>
                        </span>
                        @if (!string.IsNullOrWhiteSpace(revision.ChangeNote))
                        {
                            <p>@revision.ChangeNote</p>
                        }
                    </div>
                }
            }
        </div>
    </div>
</dialog>

@* ── Лист-подсказка ────────────────────────────────────────────────────────
   Один на страницу; наполняется из data-* нажатой кнопки. *@
<dialog id="sheet" class="overlay" aria-labelledby="sheet-title">
    <div class="panel">
        <div class="panel-head">
            <span class="panel-title" id="sheet-title" data-sheet-title></span>
            <button type="button" class="panel-close" data-close aria-label="Uždaryti">✕</button>
        </div>
        <div class="panel-body">
            <p class="sheet-intro" data-sheet-intro></p>
            <div class="sheet-directions" hidden data-sheet-directions>
                <div class="sheet-direction"><span>Jei sumažinsi</span><span data-sheet-down></span></div>
                <div class="sheet-direction"><span>Jei padidinsi</span><span data-sheet-up></span></div>
            </div>
            <div class="sheet-rows" data-sheet-rows></div>
            <p class="field-example" hidden data-sheet-note></p>
            <button type="button" class="more" data-tech-toggle aria-expanded="false">Kaip tai veikia techniškai</button>
            <p class="sheet-tech" hidden data-sheet-tech></p>
        </div>
    </div>
</dialog>

@section Scripts {
<script src="~/parameters.js" asp-append-version="true"></script>
}
