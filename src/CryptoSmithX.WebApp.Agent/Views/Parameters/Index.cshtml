@using System.Globalization
@using CryptoSmithX.WebApp.Agent.Models
@model ParametersViewModel
@{
    ViewData["Title"] = "Strategijos nustatymai";
    ViewData["PageClass"] = "p-params";

    string? Err(string key) => Model.Errors.TryGetValue(key, out var message) ? message : null;
    StrategyParameterViewModel Parameter(string id) => Model.StrategyParameters.Single(parameter => parameter.Definition.Id == id);
    var tradeParameters = new[] { Parameter("markets"), Parameter("volume"), Parameter("longScore"), Parameter("shortScore"), Parameter("spread"), Parameter("btcDrop"), Parameter("btcBars") };
    var exitParameters = new[] { Parameter("stop"), Parameter("trail"), Parameter("maxHold"), Parameter("cooldown") };
    var exposure = Model.Profile.PositionMarginUsd * Model.Profile.Leverage * Model.Profile.MaxOpenPositions;
    var elevatedRisk = exposure >= 10_000m || Model.Profile.Leverage >= 8m;
}

<header class="head">
<span class="brand">
<svg aria-hidden="true" viewBox="4.6 12.43 30.8 15.14" width="26" height="13" fill="none">
<path d="M20 23.54 L15.97 27.57 L12.43 24.03 L16.46 20 L12.43 15.97 L15.97 12.43 L20 16.46 L24.03 12.43 L27.57 15.97 L23.54 20 L27.57 24.03 L24.03 27.57 Z" fill="currentColor"></path>
<circle cx="6.6" cy="20" r="2" fill="currentColor" opacity=".55"></circle>
<circle cx="33.4" cy="20" r="2" fill="currentColor" opacity=".55"></circle>
</svg>
<span class="wordmark">CryptoSmith X</span>
</span>
<span class="account">
<span class="who">@User.Identity?.Name</span>
<form method="post" asp-controller="Home" asp-action="Logout"><button type="submit" class="logout">Atsijungti</button></form>
</span>
</header>

<main>
<div class="modeler-heading">
<h1>Strategijos nustatymai</h1>
<span class="profile-line"><span>@Model.StrategyProfileName</span><span>Profilis · @Model.BotInstanceId · rev. @Model.StrategyRevision</span></span>
<p>Viršuje — pinigai ir ekspozicija · žemiau — kaip agresyviai botas elgiasi · apačioje — išėjimo taisyklės.</p>
</div>

@if (Model.JustSaved)
{
    <p class="landed" role="status">Išsaugota. Nauji įėjimai naudos šią strategijos reviziją po kito worker atnaujinimo. Jau atidarytos pozicijos nesikeis.</p>
}
@if (Model.SaveConflict)
{
    <p class="refused" role="alert">Strategija pasikeitė, kol buvo atidarytas šis puslapis. Žemiau rodoma dabartinė revizija — peržiūrėk ir išsaugok dar kartą.</p>
}
@if (Err("strategy") is { } strategyError)
{
    <p class="refused" role="alert">@strategyError</p>
}

<form id="limits" method="post" asp-action="Save" class="modeler-form">
<input type="hidden" name="strategyProfileId" value="@Model.StrategyProfileId">
<input type="hidden" name="strategyRevision" value="@Model.StrategyRevision">
<input type="hidden" name="changeNote" id="change-note">

<section class="modeler-section">
<div class="section-heading"><span>1</span><h2>Kapitalas ir limitai</h2><span>Redaguojama</span></div>
<div class="modeler-grid">
@foreach (var limit in Model.RuntimeLimits)
{
    <partial name="_RuntimeLimit" model="limit" />
}
</div>
<div class="risk-panel @(elevatedRisk ? "elevated" : null)" data-risk-panel>
<span><span>Rizikos lygis</span><strong data-risk-level>@(elevatedRisk ? "Padidintas" : "Įprastas")</strong></span>
<p data-risk-text>@Model.Profile.PositionMarginUsd.ToString("0.##", CultureInfo.InvariantCulture) USD × @Model.Profile.Leverage.ToString("0.#", CultureInfo.InvariantCulture) svertas × iki @Model.Profile.MaxOpenPositions pozicijų gali reikšti iki @exposure.ToString("0.##", CultureInfo.InvariantCulture) USD bendros ekspozicijos rinkoje.</p>
</div>
</section>

<section class="modeler-section">
<div class="section-heading"><span>2</span><h2>Prekybos elgsena</h2><span>Redaguojama</span></div>
<p class="section-note">Šie nustatymai keičia tik naujų sandorių atranką. Sudėtinės taisyklės, turinčios kelias ribas, rodomos atskirai.</p>
<div class="modeler-grid">
@foreach (var parameter in tradeParameters)
{
    <partial name="_StrategyParameter" model="parameter" />
}
<div class="read-only-card">
<span class="label">Vėlyvo įėjimo apsauga</span>
<span class="read-only-value">Sudėtinė taisyklė</span>
<p>Botas tikrina kelias ribas, kad neįeitų į jau per toli nuėjusią kainą.</p>
<p class="field-example">Šios ribos išlieka strategijos profilyje ir šiame ekrane jų nesujungiame į vieną išgalvotą skaičių.</p>
</div>
</div>
</section>

<section class="modeler-section">
<div class="section-heading"><span>3</span><h2>Rizika ir išėjimas</h2><span>Redaguojama</span></div>
<div class="modeler-grid">
@foreach (var parameter in exitParameters)
{
    <partial name="_StrategyParameter" model="parameter" />
}
</div>
</section>

<section class="sticky-save">
<span id="status" data-state="saved" data-idle="Išsaugota">Išsaugota</span>
<button type="submit" class="save">Išsaugoti</button>
<p>Pakeitimai bus taikomi naujoms pozicijoms. Jau atidarytos pozicijos nesikeis.</p>
</section>
</form>

<section class="modeler-section revision-history" id="revision-history">
<div class="section-heading"><span>4</span><h2>Išsaugoti nustatymai</h2><span>Tik peržiūrai</span></div>
<p class="section-intro">Kiekvienas išsaugojimas sukuria nekintamą strategijos reviziją.</p>
@if (Model.RevisionHistory.Count == 0)
{
    <p class="empty">Kol kas nėra išsaugotų strategijos revizijų.</p>
}
else
{
    <ol>
    @foreach (var revision in Model.RevisionHistory)
    {
        <li>
            <span>Revizija @revision.Revision</span>
            <time datetime="@revision.CreatedAt.ToUniversalTime().ToString("O")">@revision.CreatedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</time>
            @if (!string.IsNullOrWhiteSpace(revision.ChangeNote)) { <p>@revision.ChangeNote</p> }
        </li>
    }
    </ol>
}
</section>

<p class="compliance">Ne investavimo rekomendacija · Tik nuosavos lėšos</p>

<dialog id="confirm" class="confirm" aria-labelledby="confirm-title">
<form method="dialog">
<p class="confirm-eyebrow" id="confirm-title">Išsaugoti nustatymus</p>
<p class="confirm-caption">Bus sukurta strategijos revizija @(@Model.StrategyRevision + 1).</p>
<dl class="confirm-list">
<div><dt>Pozicijos marža</dt><dd data-for="positionMarginUsd"></dd></div>
<div><dt>Svertas</dt><dd data-for="leverage"></dd></div>
<div><dt>Daugiausia atvirų pozicijų</dt><dd data-for="maxOpenPositions"></dd></div>
<div><dt>Daugiausia vienoje grupėje</dt><dd data-for="maxOpenPositionsPerGroup"></dd></div>
</dl>
<label class="dialog-note"><span>Pastabos</span><textarea id="revision-note" maxlength="1000" rows="3" placeholder="Pvz. mažesnis svertas savaitgaliui"></textarea><small>Neprivaloma. Padeda vėliau atpažinti, kodėl taip nustatei.</small></label>
<p class="confirm-note">Pakeitimai bus taikomi naujoms pozicijoms. Jau atidarytos pozicijos nesikeis.</p>
<div class="confirm-actions"><button type="submit" value="cancel" class="confirm-no">Atšaukti</button><button type="submit" value="save" class="confirm-yes">Išsaugoti</button></div>
</form>
</dialog>
</main>

@section Scripts {
<script src="~/parameters.js"></script>
}
