@using System.Globalization
@using CryptoSmithX.WebApp.Agent.Models
@model StrategyParameterViewModel
@{
    var definition = Model.Definition;
}
<label class="field @(Model.Error is null ? null : "bad") @(Model.IsEnabled ? null : "disabled")">
<span class="label">@definition.Label</span>
<span class="affix">
@if (Model.IsEnabled)
{
    <input type="number" name="Parameters[@definition.Id]" inputmode="decimal" min="@definition.Minimum.ToString(CultureInfo.InvariantCulture)" max="@definition.Maximum.ToString(CultureInfo.InvariantCulture)" step="@definition.Step.ToString(CultureInfo.InvariantCulture)" required value="@definition.Format(Model.Value)">
}
else
{
    <input type="number" disabled value="@definition.Format(Model.Value)">
}
<span class="unit">@definition.Unit</span>
</span>
@if (!Model.IsEnabled)
{
    <span class="hint">Išjungta šio profilio ATR trailing režimu.</span>
}
@if (Model.Error is { } error)
{
    <span class="bad-msg">@error</span>
}
<span class="field-scale"><span>← @definition.LowerCaption</span><span>@definition.HigherCaption →</span></span>
<p class="field-description">@definition.Description</p>
<p class="field-example">@definition.Example</p>
<details class="field-details">
<summary>Išsamiau</summary>
<div>
<p>@definition.DetailIntro</p>
<dl>
<div><dt>Mažiau</dt><dd>@definition.LowerImpact</dd></div>
<div><dt>Daugiau</dt><dd>@definition.HigherImpact</dd></div>
<div><dt>Kaip tai veikia techniškai</dt><dd>@definition.Technical</dd></div>
</dl>
</div>
</details>
</label>
