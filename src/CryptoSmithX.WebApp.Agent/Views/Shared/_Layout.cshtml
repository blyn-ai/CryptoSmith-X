@*
    Paper is the native theme; Ink would be data-theme="night" on <html>. There is no switch on
    either screen yet because neither of the two designs has one — the kit's ThemeSwitch belongs to
    the dashboard, and adding a control the design does not show is how a system starts drifting
    from it.
*@
<!doctype html>
<html lang="lt">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · CryptoSmith X</title>
    <link rel="icon" href="~/ds/mark.svg" type="image/svg+xml">
    @* The six token files, linked one by one in the order ds/styles.css imports them — not
       through that file's @import lines. Two reasons:
       - Clarity replays a recording with each <link> pointed at its own cached copy, and a
         relative @import inside that copy resolves against Clarity's address, not ours: the
         parameters recording came back with the layout but without a single token — no fonts,
         colours, borders or inputs.
       - Each file now carries its own content hash, so a token change reaches browsers without
         remembering to touch styles.css. *@
    <link rel="stylesheet" href="~/ds/tokens/fonts.css" asp-append-version="true">
    <link rel="stylesheet" href="~/ds/tokens/colors.css" asp-append-version="true">
    <link rel="stylesheet" href="~/ds/tokens/typography.css" asp-append-version="true">
    <link rel="stylesheet" href="~/ds/tokens/spacing.css" asp-append-version="true">
    <link rel="stylesheet" href="~/ds/tokens/effects.css" asp-append-version="true">
    <link rel="stylesheet" href="~/ds/tokens/base.css" asp-append-version="true">
    <link rel="stylesheet" href="~/agent.css" asp-append-version="true">
    <partial name="_Clarity" />
</head>
<body class="@ViewData["PageClass"]">
@RenderBody()
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
