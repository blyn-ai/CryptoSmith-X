{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/market/**",
              "vendor/lightweight-charts/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|Anton|DM Mono))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, Anton, DM Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgeLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:seconds|windowSeconds|missing|key|ref|className|style|children)$/]",
        "message": "<AgeLine> doesn't accept that prop. Declared props: seconds, windowSeconds, missing."
      },
      {
        "selector": "JSXOpeningElement[name.name='CallBands'] > JSXAttribute > JSXIdentifier[name!=/^(?:template|venueSpan|tickerSpan|oiSpan|depthSpan|venueLabel|tickerLabel|oiLabel|depthLabel|key|ref|className|style|children)$/]",
        "message": "<CallBands> doesn't accept that prop. Declared props: template, venueSpan, tickerSpan, oiSpan, depthSpan, venueLabel, tickerLabel, oiLabel, depthLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='CandlePanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:platform|symbol|range|onMount|height|key|ref|className|style|children)$/]",
        "message": "<CandlePanel> doesn't accept that prop. Declared props: platform, symbol, range, onMount, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompareBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|call|width|opacity|key|ref|className|style|children)$/]",
        "message": "<CompareBar> doesn't accept that prop. Declared props: value, max, call, width, opacity."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompareBar'] > JSXAttribute[name.name='call'] > Literal[value!=/^(?:ticker|oi)$/]",
        "message": "<CompareBar> call must be one of 'ticker' | 'oi'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FreshnessCall'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|seconds|key|ref|className|style|children)$/]",
        "message": "<FreshnessCall> doesn't accept that prop. Declared props: label, seconds."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|decimals|signed|percent|unit|bid|ask|max|call|series|hot|best|band|age|windowSeconds|tint|key|ref|className|style|children)$/]",
        "message": "<MetricCell> doesn't accept that prop. Declared props: value, decimals, signed, percent, unit, bid, ask, max, call, series, hot, best, band, age, windowSeconds, tint."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricCell'] > JSXAttribute[name.name='call'] > Literal[value!=/^(?:ticker|oi|depth)$/]",
        "message": "<MetricCell> call must be one of 'ticker' | 'oi' | 'depth'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricCell'] > JSXAttribute[name.name='band'] > Literal[value!=/^(?:tight|wide)$/]",
        "message": "<MetricCell> band must be one of 'tight' | 'wide'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricCell'] > JSXAttribute[name.name='tint'] > Literal[value!=/^(?:oi|depth)$/]",
        "message": "<MetricCell> tint must be one of 'oi' | 'depth'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MirrorBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:bid|ask|max|width|opacity|key|ref|className|style|children)$/]",
        "message": "<MirrorBar> doesn't accept that prop. Declared props: bid, ask, max, width, opacity."
      },
      {
        "selector": "JSXOpeningElement[name.name='Num'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|decimals|signed|percent|unit|tone|size|align|title|opacity|key|ref|className|style|children)$/]",
        "message": "<Num> doesn't accept that prop. Declared props: value, decimals, signed, percent, unit, tone, size, align, title, opacity."
      },
      {
        "selector": "JSXOpeningElement[name.name='Num'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Num> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkline'] > JSXAttribute > JSXIdentifier[name!=/^(?:values|call|hot|width|height|opacity|key|ref|className|style|children)$/]",
        "message": "<Sparkline> doesn't accept that prop. Declared props: values, call, hot, width, height, opacity."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkline'] > JSXAttribute[name.name='call'] > Literal[value!=/^(?:ticker|oi|depth)$/]",
        "message": "<Sparkline> call must be one of 'ticker' | 'oi' | 'depth'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|size|title|key|ref|className|style|children)$/]",
        "message": "<StateDot> doesn't accept that prop. Declared props: state, size, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateDot'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:observed|stale|none)$/]",
        "message": "<StateDot> state must be one of 'observed' | 'stale' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|title|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, children, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='VenueCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:platform|kind|calls|windowSeconds|title|key|ref|className|style|children)$/]",
        "message": "<VenueCell> doesn't accept that prop. Declared props: platform, kind, calls, windowSeconds, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='VenueCell'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:spot|perp)$/]",
        "message": "<VenueCell> kind must be one of 'spot' | 'perp'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
