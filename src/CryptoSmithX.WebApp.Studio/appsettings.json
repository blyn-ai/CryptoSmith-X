{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=marketdata;Username=studio_reader;Password=arena_reader;Maximum Pool Size=20"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // The hub's live relay, by its name on the compose network. No Traefik route points at it and
  // the hub publishes no ports, so this address is reachable from a sibling container and from
  // nowhere else — which is why /live carries no authentication. Locally there is usually no hub
  // running at all; the stream simply reports itself degraded and every page stays on the database.
  "Hub": {
    "BaseUrl": "http://hub:8080"
  }
}
