</div>
<span style="font:var(--fw-medium) var(--fs-eyebrow)/1 var(--font-mono);letter-spacing:var(--track-badge);text-transform:uppercase;color:var(--text-faint)">blynai.eu · © 2026 MB „BlynAI“</span>
</div>
</footer>

</div>

<div class="pv" id="pv" role="dialog" aria-modal="true" aria-labelledby="pvName">
  <div class="pv__veil" data-pv-close></div>
  <div class="pv__win">
    <div class="pv__bar">
      <span class="pv__name" id="pvName">Preview</span>
      <span class="pv__url" id="pvUrl"></span>
      <a class="pv__act" id="pvTab" href="#" target="_blank" rel="noopener">Open in new tab</a>
      <button class="pv__act pv__act--x" type="button" data-pv-close>Close</button>
    </div>
    <iframe class="pv__frame" id="pvFrame" title="Prototype preview" src="about:blank"
            referrerpolicy="no-referrer"></iframe>
    <p class="pv__note">A prototype, not the product: the numbers in it are invented. Esc closes this.</p>
  </div>
</div>

<script src="~/storefront.js" asp-append-version="true"></script>
<script>
(function () {
  'use strict';
  var pv = document.getElementById('pv');
  if (!pv || !('addEventListener' in window)) { return; }
  var name = document.getElementById('pvName'), urlEl = document.getElementById('pvUrl'),
      tab = document.getElementById('pvTab'), frame = document.getElementById('pvFrame'), opener = null;
  var closeBtn = pv.querySelector('.pv__act--x');

  function open(href, label, byKeyboard) {
    opener = document.activeElement;
    name.textContent = label;
    urlEl.textContent = location.host + href;
    tab.href = href;
    frame.src = href;
    pv.setAttribute('data-open', '');
    document.body.setAttribute('data-pv-open', '');
    // Focus moves only for a reader already on a keyboard - a click carries detail > 0, Enter or
    // Space carries 0. Grabbing it on touch raises the on-screen keyboard over what just opened.
    if (byKeyboard) { closeBtn.focus(); }
  }
  function close() {
    pv.removeAttribute('data-open');
    document.body.removeAttribute('data-pv-open');
    // Blanked, not merely hidden: a prototype left loaded keeps its timers and polling running
    // behind the page for as long as the tab is open.
    frame.src = 'about:blank';
    if (opener && opener.focus && document.activeElement !== document.body) { opener.focus(); }
    opener = null;
  }
  document.addEventListener('click', function (ev) {
    var x = ev.target.closest ? ev.target.closest('[data-pv-close]') : null;
    if (x) { ev.preventDefault(); close(); return; }
    var link = ev.target.closest ? ev.target.closest('[data-preview]') : null;
    // Only a plain left-click is intercepted. Ctrl, cmd, shift and the middle button keep meaning
    // what they mean everywhere else in a browser.
    if (!link || ev.defaultPrevented || ev.button !== 0
        || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) { return; }
    ev.preventDefault();
    open(link.getAttribute('href'), link.getAttribute('data-preview'), ev.detail === 0);
  });
  document.addEventListener('keydown', function (ev) {
    if (ev.key === 'Escape' && pv.hasAttribute('data-open')) { close(); }
  });
})();
</script>
</body>
</html>
