@model PairListModel
@{
    ViewData["Title"] = "Pairs — Studio — CryptoSmith X";
    ViewData["Eyebrow"] = "Market monitor · pairs";
    ViewData["RenderedAt"] = Model.RenderedAt;
    ViewData["ShowCollected"] = false;

    var busiest = Model.Pairs.Count == 0 ? 0 : Model.Pairs.Max(p => p.Venues);

    string CollectUrl(string facet) => Url.Action("Index", "Pairs", new { q = Model.Search, collect = facet }) ?? "";
}

<main class="a-main">

    @* A1: the axis the board never had. One row per segment, before the pair cards that read off
       it — a reader who wants "what are we watching" should not have to infer it from which
       venues happen to appear on the busiest cards. *@
    <section class="a-venues" aria-label="Venues and segments">
        <h2 class="csx-eyebrow">Venues · @Model.VenueStrip.Count segments</h2>
        <div class="a-venue-strip">
            @foreach (var v in Model.VenueStrip)
            {
                var panelId = "venue-" + v.SegmentCode;
                <div class="a-venue-row" data-status="@v.Status">
                    <button type="button" class="a-venue-trigger"
                            data-disclose-url="@Url.Action("VenueDetail", "Pairs", new { segment = v.SegmentCode })"
                            data-disclose-target="@panelId">
                        <span class="a-venue-name">@v.ExchangeName</span>
                        <span class="a-venue-segment">@v.SegmentCode <span class="a-tag@(v.Kind == "perp" ? " a-tag--perp" : " a-tag--spot")">@v.Kind</span></span>
                        <span class="a-tag" title="Segment status — planned means catalogued, not yet started.">@v.Status</span>
                        <span class="a-venue-quotes" title="Quoted against">@string.Join(" · ", v.QuoteAssets)</span>
                        <span class="a-venue-blacklist" title="Symbols this segment excludes before discovery ever writes a row">
                            @(v.BlacklistCount == 0 ? "no blacklist" : v.BlacklistCount + " blacklisted")
                        </span>
                        <span class="a-venue-budget" title="Request budget: concurrent requests, requests/second, and how the number was set">
                            @v.MaxConcurrentRequests × @v.RequestBudgetPerS/s
                            <span class="a-tag">@v.RequestBudgetSource</span>
                        </span>
                    </button>
                    <div class="a-disclose-panel" id="@panelId" hidden></div>
                </div>
            }
        </div>
    </section>

    <div class="a-statement-row">
        <h1 class="a-statement">
            @if (Model.Pairs.Count == 0)
            {
                <text>Nothing matches that.</text>
            }
            else
            {
                @* Two counts and no adjective. Venues and listings are different numbers — one venue
                   can list BTC/USDT and BTC/USDC at once — and the busiest pair is the one figure
                   here that says how much of a comparison this site can actually make.

                   When the board is full, the first sentence says so in the loudest type on the
                   page rather than in a footnote: this list is capped, and a page that printed
                   "200 pairs on this board" over a filter matching 4,812 of them would be showing
                   less than it has and saying nothing about it. The ordering is busiest-first, so
                   the second sentence is true either way — what a full board cuts is always the
                   thin end. *@
                @if (Model.Truncated)
                {
                    <text>@Model.Pairs.Count of @Model.Matching pairs on this board.</text>
                }
                else
                {
                    <text>@Model.Pairs.Count pair@(Model.Pairs.Count == 1 ? "" : "s") on this board.</text>
                }
                <em>@busiest venue@(busiest == 1 ? "" : "s") on the busiest.</em>
            }
        </h1>
        <span class="csx-eyebrow" style="color:var(--text-faint)">Quotes folded · venues, then listings</span>
    </div>

    @* The one form on the site. GET, so a search is a URL somebody can send to someone else, and so
       nothing here needs an antiforgery token — which matters, because this application's data
       protection keys are ephemeral by design and a token would stop validating across a restart. *@
    <form class="a-search" method="get" action="@Url.Action("Index", "Pairs")">
        <label class="csx-eyebrow" for="q" style="align-self:center">Filter</label>
        <input class="a-input" id="q" name="q" type="search" value="@Model.Search"
               placeholder="BTC, USD, …" spellcheck="false" autocomplete="off" maxlength="32">
        <button class="a-btn" type="submit">Show</button>
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <a class="a-btn" href="@Url.Action("Index", "Pairs")" style="display:inline-flex;align-items:center">Clear</a>
        }
        <input type="hidden" name="collect" value="@Model.CollectFacet" />
    </form>

    @* A4's facet: which instruments this board draws from, not just which pairs matched a search
       term. Three mutually exclusive states, not a checkbox pile — an instrument is in exactly one
       of them (StudioStore.CollectFacets). *@
    <div class="a-facets" role="group" aria-label="Which listings to show">
        <a class="a-facet@(Model.CollectFacet == "on" ? " a-facet--active" : "")" href="@CollectUrl("on")">
            Collecting <b>@Model.Counts.Collecting</b>
        </a>
        <a class="a-facet@(Model.CollectFacet == "waiting" ? " a-facet--active" : "")" href="@CollectUrl("waiting")">
            Waiting on an operator <b>@Model.Counts.Waiting</b>
        </a>
        <a class="a-facet@(Model.CollectFacet == "all" ? " a-facet--active" : "")" href="@CollectUrl("all")">
            All <b>@(Model.Counts.Collecting + Model.Counts.Waiting)</b>
        </a>
    </div>

    @* The cap, in words, next to the thing it capped — and now BOTH reasons a pair a reader wants
       might not be on this page, not only the cap. A pair missing from the "collecting" facet is
       not necessarily absent from the market: it may be waiting on gate 0029, or excluded before
       discovery ever saw it by a segment's own blacklist. *@
    @if (Model.Truncated)
    {
        <p class="a-note">
            Showing the <b>@Model.Limit</b> pairs carried by the most venues.
            <b>@(Model.Matching - Model.Pairs.Count)</b> more match and are not on this page — this
            board is capped at @Model.Limit cards, which is a rule of the page and not a fact about
            the market. Filter by an asset to reach any of them.
        </p>
    }
    @if (Model.CollectFacet == "on" && Model.Counts.Waiting > 0)
    {
        <p class="a-note">
            <b>@Model.Counts.Waiting</b> listings are not on this board at all in this facet — they
            arrived with <code>collect = false</code> because their base asset was not auto-approved
            (gate 0029) and no operator has decided yet.
            <a href="@CollectUrl("waiting")">See them</a>.
            Separately, @Model.VenueStrip.Sum(v => v.BlacklistCount) symbols across
            @Model.VenueStrip.Count(v => v.BlacklistCount > 0) segments are blacklisted and never
            reach discovery at all — see the venue strip above.
        </p>
    }

    @if (Model.Pairs.Count == 0)
    {
        <div class="a-panel a-empty">
            <h2>No pair matches “@Model.Search”</h2>
            <p class="a-note">
                This board lists the pairs we are collecting, with the quote folded into its family —
                USD, USDT and USDC are one heading and each row on a pair's page still shows the
                venue's own quote. Nothing here says the pair does not trade somewhere; it says we do
                not collect it.
            </p>
        </div>
    }
    else
    {
        <div class="a-pairs">
            @foreach (var p in Model.Pairs)
            {
                @* RouteUrl by NAME, not Url.Action. The default route is registered first — it has
                   to be, or a two-segment pair route swallows every conventional URL on the site —
                   so link generation would otherwise resolve this to /Pairs/Pair?baseFamily=… and
                   the short address the page is designed around would exist only if a visitor typed
                   it. Naming the route asks for the address we mean.

                   POINTS AT v2. The first design stays reachable at /studio/{asset} — nothing about
                   it changed and its own address still serves it — but the list is the way in, so the
                   way in leads to the page being judged. Only this one line decides that; swap the
                   route name back and the whole site returns to the first design. *@
                var href = Url.RouteUrl("asset-v2", new
                {
                    controller = "PairsV2",
                    action = "Asset",
                    baseFamily = p.BaseFamily
                });

                var v1 = Url.RouteUrl("asset-v1", new
                {
                    controller = "Pairs",
                    action = "Asset",
                    baseFamily = p.BaseFamily
                });

                @* Карточка ведёт на v2 — как и вела. Две кнопки под ней дают выбрать, а не гадать.
                   ОТДЕЛЬНЫМИ ссылками рядом с карточкой, а не внутри неё: ссылка внутри ссылки —
                   невалидная разметка, и браузеры разбирают её по-разному, вплоть до того, что
                   внешняя перестаёт кликаться на части своей площади. *@
                var registryPanelId = "registry-" + p.BaseFamily;
                <div class="a-pair-cell">
                    <a class="a-plain a-pair-card" href="@href">
                        <span class="a-pair-name">@p.BaseFamily</span>
                        <span class="a-pair-counts">
                            <span title="Order books quoting this pair. Distinct segments, because a venue's spot book and its perp book are two books.">
                                <b>@p.Venues</b> venue@(p.Venues == 1 ? "" : "s")
                            </span>
                            <span title="Instruments folding into this heading. Higher than the venue count where a venue lists the pair against more than one quote in the same family.">
                                <b>@p.Listings</b> listing@(p.Listings == 1 ? "" : "s")
                            </span>
                        </span>
                    </a>
                    <span class="a-pair-designs">
                        <a class="a-design" href="@v1" title="@p.BaseFamily — first design">v1</a>
                        <a class="a-design a-design--now" href="@href" title="@p.BaseFamily — second design">v2</a>
                        @* A3 + A4 on one trigger: the alias registry behind the fold, and the
                           collect audit for every listing this family has. *@
                        <button type="button" class="a-design a-design--registry"
                                data-disclose-url="@Url.Action("AssetRegistry", "Pairs", new { baseFamily = p.BaseFamily })"
                                data-disclose-target="@registryPanelId"
                                title="@p.BaseFamily — aliases and collect audit">aliases</button>
                    </span>
                    <div class="a-disclose-panel a-disclose-panel--card" id="@registryPanelId" hidden></div>
                </div>
            }
        </div>
    }

    <p class="a-note">
        A pair's two halves are <b>families</b>: USD, USDT and USDC fold into one heading so that a
        reader asking about bitcoin gets one row rather than three. Nothing stored is folded — every
        venue's own quote is printed on the comparison page, on every row, and the collector's tables
        still hold USDT as USDT. <b>Venues</b> counts order books; <b>listings</b> counts instruments,
        and they differ wherever one venue lists the pair against two quotes in the same family.
    </p>
</main>

@section scripts {
    <script src="~/studio-disclose.js?v=2" defer></script>
}
