@using CryptoSmithX.WebApp.Studio.Data
@model PairPageModel
@{
    var cuts = V2Cuts.All;
    var bookNote = V2Notes.Book(Model);
}
@* ── полоса 2: сейчас, по площадкам ──────────────────────────────────────────── *@
<section class="v2-band" id="band-now" data-live-region="now" data-live-hold>
    <div class="v2-band-head">
        <span class="csx-eyebrow v2-band-no">2 · <span id="cut-now-title">The books</span></span>
        <span class="csx-eyebrow v2-band-sub" id="cut-now-sub">@bookNote</span>
        <span class="csx-eyebrow v2-band-unit" id="cut-now-unit">@cuts[0].Unit</span>
        @* P0-1: one note for the whole list rather than a repeated sentence on every row — set once
           per cut, from the button that chose it (data-rank-note), same mechanism as title/sub/unit
           above. Empty on funding, which is not ranked in any scope. *@
        <span class="csx-eyebrow v2-band-rank" id="cut-now-rank">@cuts[0].RankNote</span>
        @* Сколько книг в ряд — выбор читателя: пять карточек на 1920 читаются, на ноутбуке нет,
           а на одну колонку раскрытая книга становится настоящим стаканом. Кнопка задаёт ПОТОЛОК,
           а не число: минимальная ширина карточки остаётся в том же правиле, поэтому пять на
           узком экране честно дадут три. *@
        <span class="v2-cols" role="group" aria-label="Book columns" data-cols-key="books" data-cols-target=".v2-nows--books">
            <span class="csx-eyebrow v2-cols-label">Columns</span>
            @for (var n = 5; n >= 1; n--)
            {
                <button type="button" class="v2-cols-btn" data-cols="@n"
                        title="@(n == 1 ? "1 column" : $"Up to {n} columns")" aria-pressed="false">
                    <span class="v2-cols-icon" aria-hidden="true">@for (var i = 0; i < n; i++) { <i></i> }</span>
                </button>
            }
        </span>
    </div>

    @foreach (var c in cuts)
    {
        // P0-5 (UX audit): stress carries the SAME 24h liquidation sum band 1's column reads
        // (V2Store.StressAsync) — the cut used to read VenueRowModel.Liquidations' last closed
        // hourly bucket instead, a different table on a different window, so the two bands could
        // print two different numbers for one venue.
        var maxNow = Model.Rows.Select(r =>
        {
            Model.Stress.TryGetValue(r.Row.InstrumentId, out var s);
            return V2Cuts.Now(r, c, s);
        }).Where(v => v is not null).DefaultIfEmpty(null).Max();
        <div class="v2-nows @(c.Key == "price" ? "v2-nows--books" : "")" data-cols="5" data-cut="@c.Key" hidden="@(c.Key == "price" ? null : "hidden")">
            @if (c.Key == "price")
            {
                @* Цена «сейчас» — это стакан, а не одно число: книга читается формой, где стена,
                   где дыра, симметрична ли она. Двадцать пять уровней цифрами не читает никто. *@
                foreach (var r in Model.Rows)
                {
                    <div class="v2-book" data-quote="@r.Row.QuoteAsset">
                        <span class="v2-book-plat">@r.Row.ExchangeName <b>@r.Row.Symbol</b>
                            <em>@(r.Row.SpreadBps is { } sp ? Format.Num(sp, 1) + " bps" : "—")</em></span>
                        @if (!Model.Books.TryGetValue(r.Row.InstrumentId, out var bk) || bk.BidPx.Length == 0)
                        {
                            <p class="v2-empty v2-empty--inline">No level book from this venue. Not a thin book — an unmeasured one.</p>
                        }
                        else
                        {
                            var top = Math.Max(bk.BidQty.DefaultIfEmpty(0).Max(), bk.AskQty.DefaultIfEmpty(0).Max());

                            @* ПАРНАЯ ЛЕСТНИЦА ОТ СЕРЕДИНЫ, как читают стакан везде: n-й бид против
                               n-го аска на одной строке, цены в середине, объёмы по краям, бары
                               растут наружу от центра.

                               До этого стороны стояли двумя стопками бар-в-бар и без единого
                               числа: чтобы узнать, по какой цене стена, приходилось наводить на
                               уровень по одному. Форму это давало, ответ — нет. Спред теперь
                               виден сам собой — это просвет между двумя ценами в первой строке. *@
                            var drawn = 14;
                            var bidShown = Math.Min(bk.BidPx.Length, drawn);
                            var askShown = Math.Min(bk.AskPx.Length, drawn);
                            var held = Math.Max(bk.BidPx.Length, bk.AskPx.Length);
                            var px = Format.PriceDecimals(r.Row);
                            <span class="v2-ladder">
                                <span class="v2-lvl-head">
                                    <span>size</span><span class="v2-r">bid</span>
                                    <span>ask</span><span class="v2-r">size</span>
                                </span>
                                @for (var i = 0; i < Math.Max(bidShown, askShown); i++)
                                {
                                    <span class="v2-lvl-row">
                                        @if (i < bidShown)
                                        {
                                            <span class="v2-lvl-qty v2-r">@Format.Num(bk.BidQty[i], 0)</span>
                                            <span class="v2-lvl v2-lvl--bid"
                                                  title="bid @Format.Num(bk.BidPx[i], px) × @Format.Num(bk.BidQty[i], 4)">
                                                <i style="width:@Format.BarWidth(bk.BidQty[i], top)"></i>
                                                <b>@Format.Num(bk.BidPx[i], px)</b>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="v2-lvl-qty"></span><span class="v2-lvl"></span>
                                        }

                                        @if (i < askShown)
                                        {
                                            <span class="v2-lvl v2-lvl--ask"
                                                  title="ask @Format.Num(bk.AskPx[i], px) × @Format.Num(bk.AskQty[i], 4)">
                                                <i style="width:@Format.BarWidth(bk.AskQty[i], top)"></i>
                                                <b>@Format.Num(bk.AskPx[i], px)</b>
                                            </span>
                                            <span class="v2-lvl-qty">@Format.Num(bk.AskQty[i], 0)</span>
                                        }
                                        else
                                        {
                                            <span class="v2-lvl"></span><span class="v2-lvl-qty"></span>
                                        }
                                    </span>
                                }
                            </span>
                            <span class="v2-book-note">
                                @* ТО ЖЕ ЧИСЛО, что печатает клетка Book reach в полосе 1, из
                                   одного места: полоса 2 говорила «reach not measured» там, где
                                   полоса 1 писала ±18 bps — одна книга, одна страница, два ответа. *@
                                @{ var reach = V2Cells.Reach(bk, r.Row.DepthRef, px); }
                                @(reach.Value is null ? "reach not measured" : "seen to " + reach.Text)
                                · @(bidShown == held && askShown == held
                                      ? $"{held} levels a side"
                                      : $"{Math.Max(bidShown, askShown)} of {held} levels a side drawn")
                            </span>
                        }
                    </div>
                }
            }
            else
            {
                if (maxNow is null)
                {
                    @* Причина у пустой полосы РАЗНАЯ, и одна фраза на обе врала бы про вторую:
                       фандинг не ранжируется в принципе — он назван в интервале каждой площадки;
                       у остальных срезов колонка есть, просто по этому активу в ней ничего нет. *@
                    if (c.Source == V2CutSource.Funding)
                    {
                        <p class="v2-empty">
                            @c.Name does not rank in one column across venues — it is stated per venue interval,
                            and the table normalises it in the cost-of-carry group.
                        </p>
                    }
                    else
                    {
                        <p class="v2-empty">No venue here has a figure for @c.Name.</p>
                    }
                }
                else
                {
                    @* ЛУЧШИЙ СВЕРХУ, а не «по убыванию всегда»: у спреда лучший — наименьший, и
                       порядок по убыванию ставил худшую площадку первой строкой в том самом
                       списке, где ответ — это первая строка. *@
                    double? NowOf(VenueRowModel x)
                    {
                        Model.Stress.TryGetValue(x.Row.InstrumentId, out var s);
                        return V2Cuts.Now(x, c, s);
                    }

                    var ordered = c.HighIsBest
                        ? Model.Rows.OrderByDescending(x => NowOf(x) ?? double.MinValue)
                        : Model.Rows.OrderBy(x => NowOf(x) ?? double.MaxValue);

                    foreach (var r in ordered)
                    {
                        var v = NowOf(r);
                        <div class="v2-now" data-quote="@r.Row.QuoteAsset">
                            <span class="v2-now-plat">@r.Row.ExchangeName <em>@r.Row.SegmentKind</em> <b>@r.Row.Symbol</b></span>
                            @* Значение С ЕДИНИЦЕЙ: голое «6.01» в строке про спред — число, про
                               которое надо помнить, чем его мерили, и которое легко сравнить с
                               соседним срезом по ошибке. *@
                            <span class="v2-now-val @(v is null ? "v2-fig--none" : "")">@(v is null ? "—" : Format.Num(v, c.Decimals) + " " + c.Short)</span>
                            @* У ГЛУБИНЫ СТОРОНА — ЭТО ОТВЕТ. Один бар на сумму сторон складывает
                               бид с аском и теряет наклон книги, ради которого на глубину и
                               смотрят: 200 к бида против 40 к аска и 120 к против 120 к дают
                               одинаковый бар и противоположный рынок. Обе половины меряются от
                               ОДНОГО максимума по странице, иначе они несравнимы между строками. *@
                            @if (c.Key == "depth25")
                            {
                                var half = Model.Rows
                                    .SelectMany(x => new[] { x.Row.DepthBid25, x.Row.DepthAsk25 })
                                    .Where(x => x is not null)
                                    .DefaultIfEmpty(null)
                                    .Max();
                                <span class="v2-mirror"
                                      title="bid @Format.Num(r.Row.DepthBid25, 0) · ask @Format.Num(r.Row.DepthAsk25, 0)">
                                    <span><i style="width:@Format.BarWidth(r.Row.DepthBid25, half)"></i></span>
                                    <span><i style="width:@Format.BarWidth(r.Row.DepthAsk25, half)"></i></span>
                                </span>
                            }
                            else if (v is not null)
                            {
                                @* P0-5: no track at all for a "—" row — it used to render a bar
                                   whose fill was 0% wide but whose own rail still drew full width,
                                   which reads as "measured zero" beside a row that says "—". *@
                                <span class="v2-now-bar"><i style="width:@Format.BarWidth(v, maxNow)"></i></span>
                            }
                            @* P0-1: the per-row "USD FIGURES · EVERY LISTING COMPARABLE" sentence is
                               gone — replaced by the 3px quote-group rule on the row (v2-now, below)
                               plus the one header note set for the whole list (#cut-now-rank,
                               above). Возраст вызова, который написал строку, остаётся. *@
                            @{
                                (string Label, double? Seconds, double? Window, double? Cadence) age = c.Key switch
                                {
                                    "depth25" => ("Depth", r.Ages.DepthSeconds, r.Windows.DepthSeconds, r.Cadence.DepthSeconds),
                                    "oi" => ("OI", r.Ages.OpenInterestSeconds, r.Windows.OpenInterestSeconds, r.Cadence.OpenInterestSeconds),
                                    _ => ("Price", r.Ages.PriceSeconds, r.Windows.PriceSeconds, r.Cadence.PriceSeconds),
                                };
                                var late = Freshness.PastWindow(age.Seconds, age.Window, age.Cadence);
                            }
                            <span class="v2-now-age @(late ? "v2-now-age--late" : "")">@(late ? Format.PastWindowMark : "") @age.Label @Format.SpacedAge(age.Seconds)</span>
                        </div>
                    }
                }
            }
        </div>
    }
</section>
