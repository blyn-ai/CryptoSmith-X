@using CryptoSmithX.WebApp.Studio.Data
@model PairPageModel
@{
    Layout = null;
    var title = $"{Model.BaseFamily} · {Model.Listings} listings";
    ViewData["Title"] = title;

    var perp = Model.Rows.Count(r => r.Row.SegmentKind == "perp");
    var spot = Model.Rows.Count(r => r.Row.SegmentKind == "spot");
    var groups = V2Groups.All;
    var fieldsEach = groups.Sum(g => g.Fields.Count);

    // Counted, not claimed. The header prints these and a reader can check every one against what
    // is drawn below — which is the only reason to print them at all.
    var figures = Model.Rows.Count * fieldsEach;
    var books = Model.Rows.Count(r => r.Row.DepthAt is not null);
    var series = Model.Rows.Count(r => r.Candles.Bars.Any(b => b is not null));

    // The verdict: how many of the three calls behind each row are past the window their own dataset
    // sets. It is the page's own answer to "can any of this still be believed", and it is a count
    // rather than an adjective so a reader can check it against the ages in the rows.
    var behind = Model.Rows.Sum(r =>
        (Freshness.PastWindow(r.Ages.PriceSeconds, r.Windows.PriceSeconds) ? 1 : 0)
        + (Freshness.PastWindow(r.Ages.DepthSeconds, r.Windows.DepthSeconds) ? 1 : 0)
        + (Freshness.PastWindow(r.Ages.OpenInterestSeconds, r.Windows.OpenInterestSeconds) ? 1 : 0));

    var cuts = V2Cuts.All;
    var drawable = Model.Rows.Where(r => r.Candles.Present >= 2).ToList();

    // ОДНА ШКАЛА НА КОТИРОВКУ, как на первой странице: ADAUSDT и ADAUSDC ходят по разным ценам,
    // и общая шкала на обе сплющила бы обе в прямые. Разные котировки — разные шкалы.
    var priceScale = drawable
        .GroupBy(r => r.Row.QuoteAsset, StringComparer.Ordinal)
        .ToDictionary(
            g => g.Key,
            g => (Lo: g.Min(r => r.Candles.Low!.Value), Hi: g.Max(r => r.Candles.High!.Value)),
            StringComparer.Ordinal);

    var oldest = Model.Rows
        .SelectMany(r => new[] { r.Ages.PriceSeconds, r.Ages.DepthSeconds, r.Ages.OpenInterestSeconds })
        .Where(a => a is not null)
        .DefaultIfEmpty(null)
        .Max();
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@title · CryptoSmith X</title>
    <link rel="stylesheet" href="~/ds/styles.css">
    @* ?v= — не украшение. Cloudflare кеширует статику этого домена, и без версии в адресе
       страница получает старый файл: правки вёрстки уехали на тест, а браузеру пришёл CSS
       трёхчасовой давности (cf-cache-status: HIT, age 3068), из-за чего полоса 2 шла голым
       текстом, а линии графиков разъезжались на пол-экрана. Ровно та же ловушка, что уже
       ловила studio-live.js. Поднимать при каждой правке файла. *@
    <link rel="stylesheet" href="~/studio-v2.css?v=12">

    @* Тема применяется ДО первой отрисовки и поэтому здесь, а не скриптом внизу страницы:
       поставленная снизу, она показала бы светлый экран и мигнула тёмным — ровно то, ради чего
       ночь и включают, в обратную сторону.

       КЛЮЧ ТОТ ЖЕ, ЧТО У ПЕРВОЙ СТРАНИЦЫ (csx-studio-theme), и логика та же: выбор читателя, а
       если его нет — системная настройка. Свой ключ означал бы, что переход со списка пар на
       эту страницу переключает свет. *@
    <script>
        (function () {
            try {
                var stored = localStorage.getItem('csx-studio-theme');
                var night = stored ? stored === 'night'
                    : window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (night) { document.documentElement.setAttribute('data-theme', 'night'); }
            } catch (e) { /* приватное окно отказывает в хранилище — дневной набор рабочий ответ */ }
        })();
    </script>
</head>
@*
    Три постоянных затухания едут с сервера, а не переписываются в JavaScript второй раз: это
    правило 2 дизайн-системы, оно уже лежит в Freshness.cs, и копия в файле, который не собирает
    ни один CI, — ровно та форма ошибки, которая у этого проекта уже была.
*@
<body class="v2 a-sheet"
      data-now="@Model.RenderedAt.ToUnixTimeMilliseconds()"
      data-fade-floor="@Freshness.Floor.ToString(System.Globalization.CultureInfo.InvariantCulture)"
      data-fade-exponent="@Freshness.Exponent.ToString(System.Globalization.CultureInfo.InvariantCulture)"
      data-degraded-windows="@Freshness.DegradedWindows">

@* ── шапка ─────────────────────────────────────────────────────────────────── *@
<header class="v2-head">
    <a class="v2-wordmark" href="~/">CryptoSmith X</a>
    <span class="v2-crumb">Asset · @Model.BaseFamily</span>
    <span class="v2-stamps">
        Collected @Format.UtcClock(Model.CollectedFrom) – @Format.UtcClock(Model.CollectedTo)
        &nbsp;·&nbsp; Rendered @Format.UtcClock(Model.RenderedAt.UtcDateTime)
    </span>
</header>

<div class="v2-title">
    @* ЗАГОЛОВОК НАЗЫВАЕТ НАХОДКУ, а не пересчитывает строки. «Five listings quote ADA.» — это
       оглавление таблицы, которая и так ниже; вторая фраза — то, ради чего страницу открыли:
       что именно с этими пятью не так прямо сейчас. Считает её Statement.Verdict — тот же код,
       что и на первой странице, и он же обновляется живым потоком через data-statement-verdict. *@
    <h1>@Model.Listings listings quote @Model.BaseFamily.
        <em data-statement-verdict>@Statement.Verdict(Model.Rows)</em></h1>
    <span class="v2-meta">
        @Model.PlatformCount platforms · @perp perp · @spot spot ·
        @fieldsEach fields each · @figures figures · @books books · @series series
    </span>
</div>

<div class="v2-controls">
    <a class="v2-back" href="~/">Back to list</a>

    @* Ночь. Кнопка та же, что на первой странице, и обработчик у неё тот же — в studio-ages.js:
       две копии переключателя темы означали бы два ключа хранилища и страницы, светящие
       по-разному в одном сеансе. Приходит скрытой: со скриптами наотрез она бы ничего не делала. *@
    <button type="button" id="a-ink" class="v2-ink" hidden>Ink</button>

    @* LIVE, и теперь за ним поток. Хуки — те же, что у первой страницы (.a-liverow, #a-live,
       .a-switch-label, #a-live-note): у этих двух страниц ОДИН клиент живого потока, потому что
       вся тонкая часть у него не в разметке, а в поведении при обрыве — пять попыток, слово
       вместо тишины, отказ по заполненности. Второй экземпляр этого поведения был бы вторым
       местом, где рвущийся поток однажды промолчит.

       Кнопка приходит скрытой и показывается скриптом: без EventSource страница остаётся
       статической — полной и верной, — а видимый неработающий тумблер был бы обещанием. *@
    <span class="a-liverow" data-live-url="@Url.Action("Live", "PairsV2", new { baseFamily = Model.BaseFamily })">
        <button type="button" id="a-live" class="v2-switch" role="switch" aria-checked="false" hidden>
            <i></i><em class="a-switch-label">Live</em>
        </button>
        @* Слово о состоянии потока стоит ВНУТРИ .a-liverow, потому что клиент ищет его там же,
           где кнопку: разнести их — и обрыв будет сообщён в никуда. *@
        <span id="a-live-note" class="v2-livenote"></span>
    </span>
    <button type="button" id="expand-all" class="v2-switch" aria-pressed="false">
        <i></i><em>Expand all · @figures figures</em>
    </button>

    <span class="v2-note">
        A snapshot, @Format.ShortAge(oldest) old. Nothing here is hidden except what you folded.
    </span>
</div>

<partial name="_V2Table" model="Model" />

@* ── выбор измерения: одно на обе полосы ─────────────────────────────────────
   Полосы 2 и 3 отвечают на ОДИН выбор: как площадки стоят сейчас и как они к этому пришли.
   В первом наброске селектор висел только на нижней, а верхняя была прибита к глубине — из-за
   этого они читались как две несвязанные вещи, и вопрос «почему книги не меняются, когда я
   выбираю открытый интерес» оставался без ответа. *@
<div class="v2-cutbar" id="band-cuts">
    <span class="csx-eyebrow v2-cutbar-label">One field, two views</span>
    <span class="csx-eyebrow v2-cutbar-sub">Bands 2 and 3 answer the same choice: how it stands now, and how it got there</span>
    <span class="v2-cutpicks">
        @{ var bookNote = V2Notes.Book(Model); }
        @foreach (var c in cuts)
        {
            @* Заголовок и подпись полосы 2 меняются вместе со срезом, поэтому строки едут с
               кнопкой, которая их выбирает: иначе их пришлось бы держать вторым списком в
               скрипте — тем самым, который однажды разойдётся с этим. *@
            <button type="button" class="v2-cutpick" data-cut="@c.Key"
                    data-title="@(c.Key == "price" ? "The books" : "Now, across venues")"
                    data-note="@(c.Key == "price" ? bookNote : c.Unit)"
                    data-series="@c.Name · @c.Unit"
                    aria-pressed="@(c.Key == "price" ? "true" : "false")">@c.Name</button>
        }
    </span>
</div>

<partial name="_V2Now" model="Model" />

@* ── полоса 3: во времени, по площадкам ──────────────────────────────────────── *@
<section class="v2-band">
    <div class="v2-band-head">
        <span class="csx-eyebrow v2-band-no">3 · Over time, across venues</span>
        <span class="csx-eyebrow v2-band-sub"><span id="cut-time-sub">@cuts[0].Name · @cuts[0].Unit</span>
            · hourly, 24 h · one scale per quote · time axes tied</span>
    </div>

    @* Цена рисуется свечами той же вендоренной библиотекой, что и на первой странице, и по тому
       же контракту разметки (.a-chart[data-candles]) — второй рендерер значил бы два разных
       представления одних и тех же баров. Остальные измерения — часовые ряды, они линия. *@
    <div class="v2-cuts" data-cut="price">
        @if (drawable.Count == 0)
        {
            <p class="v2-empty">No venue here has two closed bars yet.</p>
        }
        else
        {
            foreach (var r in drawable)
            {
                var series = r.Candles;
                var json = System.Text.Json.JsonSerializer.Serialize(
                    series.Windows.Select((w, i) => new
                    {
                        time = new DateTimeOffset(DateTime.SpecifyKind(w, DateTimeKind.Utc)).ToUnixTimeSeconds(),
                        o = series.Bars[i]?.Open,
                        h = series.Bars[i]?.High,
                        l = series.Bars[i]?.Low,
                        c = series.Bars[i]?.Close
                    }));
                var sc = priceScale[r.Row.QuoteAsset];
                <div class="v2-cut">
                    <span class="v2-cut-plat">@r.Row.ExchangeName <b>@r.Row.Symbol</b></span>
                    <div class="a-chart v2-chart"
                         data-candles="@json"
                         data-scale-lo="@sc.Lo.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         data-scale-hi="@sc.Hi.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         data-decimals="@Format.Decimals(r.Row.PriceStep, fallback: 4)"></div>
                </div>
            }
        }
    </div>

    @foreach (var c in cuts.Where(c => c.Source != V2CutSource.Candles))
    {
        <div class="v2-cuts" data-cut="@c.Key" hidden>
            @{ var any = Model.Rows.Any(r => V2Cuts.Series(r, c).Any(v => v is not null)); }
            @if (!any)
            {
                <p class="v2-empty">No hourly series is kept for @c.Name.</p>
            }
            else
            {
                foreach (var r in Model.Rows)
                {
                    var vals = V2Cuts.Series(r, c);
                    var path = Format.SparkPath(vals, 260, 64);
                    <div class="v2-cut">
                        <span class="v2-cut-plat">@r.Row.ExchangeName <b>@r.Row.Symbol</b></span>
                        @if (path is null)
                        {
                            <p class="v2-empty v2-empty--inline">Not measured on this venue.</p>
                        }
                        else
                        {
                            <svg class="v2-line" viewBox="0 0 260 64" preserveAspectRatio="none" aria-hidden="true">
                                <path d="@path" fill="none" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" />
                            </svg>
                        }
                    </div>
                }
            }
        </div>
    }
</section>


@* ── полоса 4: лента ────────────────────────────────────────────────────────── *@
<section class="v2-band" id="band-tape">
    <div class="v2-band-head">
        <span class="csx-eyebrow v2-band-no">4 · The tape</span>
        <span class="csx-eyebrow v2-band-sub">the last @Model.Tape.Count fills across every listing of this asset</span>
        @* Тумблер, за которым что-то стоит. Лента — единственное на странице, что живёт само,
           поэтому она и единственное, что имеет смысл опрашивать: включённый FOLLOW раз в пять
           секунд просит те же восемнадцать сделок и подставляет их на место. Выключенный —
           оставляет то, что вы читаете, ровно там, где оно есть. *@
        <span class="v2-follow">
            <button type="button" id="tape-follow" class="v2-toggle" role="switch" aria-checked="false"
                    data-url="@Url.Action("Tape", "PairsV2", new { baseFamily = Model.BaseFamily })"
                    title="ask the venues for this asset's fills every five seconds and keep the newest at the top">
                <span class="v2-toggle-knob"></span>
            </button>
            <label for="tape-follow">Follow</label>
        </span>
    </div>

    <div class="v2-tape">
        <div class="v2-tape-head">
            <span>Time</span><span>Venue</span><span>Side</span>
            <span class="v2-r">Price</span><span class="v2-r">Size</span><span>Kind</span>
        </div>
        @* Тело ленты отдельным узлом: FOLLOW заменяет ЕГО, а не полосу, поэтому шапка,
           заголовок и подпись под лентой остаются на месте между опросами. *@
        <div class="v2-tape-body" id="tape-body">
            @if (Model.Tape.Count == 0)
            {
                <p class="v2-empty">
                    No fills recorded in the last hour. The trades dataset is collected per venue — an
                    empty tape here is either a quiet asset or a venue whose trades are switched off,
                    and band 5 below says which.
                </p>
            }
            @foreach (var t in Model.Tape)
            {
                var owner = Model.Rows.FirstOrDefault(r => r.Row.InstrumentId == t.InstrumentId);
                var kind = t.TradeType ?? "fill";
                var loud = kind is "liquidation" or "partial_liquidation" or "termination";
                <div class="v2-tape-row @(loud ? "v2-tape-row--loud" : "")">
                    <span>@t.EventTime.ToString("HH:mm:ss.fff")</span>
                    <span>@(owner?.Row.ExchangeName ?? "—")</span>
                    <span class="v2-side v2-side--@t.TakerSide">@t.TakerSide</span>
                    <span class="v2-r">@Format.Num(t.Price, 6)</span>
                    <span class="v2-r">@Format.Num(t.Qty, 0)</span>
                    <span class="v2-kind">@kind.Replace("_", " ")</span>
                </div>
            }
        </div>
    </div>
    <p class="v2-legend">
        The tape is the one thing on this page that moves on its own, because a tape is a tape.
        Three fills can carry one millisecond between them and they are three rows, not one.
        Everything else changes when a pass lands.
    </p>
</section>

@* ── полоса 5: что стоит за цифрами ─────────────────────────────────────────── *@
<section class="v2-band" id="band-trust">
    <div class="v2-band-head">
        <span class="csx-eyebrow v2-band-no">5 · What is behind the figures</span>
        <span class="csx-eyebrow v2-band-sub">coverage per dataset · one colour, one metric, one axis of venues ·
            gaps stay open until they close</span>
    </div>

    @{
        var datasets = Model.Coverage.Select(c => c.Dataset).Distinct(StringComparer.Ordinal).OrderBy(d => d, StringComparer.Ordinal).ToList();
    }
    @if (datasets.Count == 0)
    {
        <p class="v2-empty" style="padding:var(--space-4) var(--space-7)">
            No coverage recorded for this asset in the last day. Coverage is written by the history
            collectors, so an empty grid means none of them has run for these listings — not that the
            history is empty.
        </p>
    }
    else
    {
        <div class="v2-cov" style="--vcols:@Model.Rows.Count">
            <span class="v2-cov-corner"></span>
            @foreach (var r in Model.Rows)
            {
                <span class="v2-cov-vh">@r.Row.ExchangeName<em>@r.Row.Symbol</em></span>
            }
            @foreach (var d in datasets)
            {
                <span class="v2-cov-dh">@d.Replace("_", " ")</span>
                @foreach (var r in Model.Rows)
                {
                    var cell = Model.Coverage.FirstOrDefault(c => c.Dataset == d && c.InstrumentId == r.Row.InstrumentId);
                    @* Одна шкала зелёного на одну метрику по одной оси площадок. Никаких палитр
                       поперёк метрик: у них нет общей шкалы, и раскрасить их одним градиентом
                       значило бы соврать. *@
                    <span class="v2-cov-cell @(cell is null ? "v2-cov-cell--none" : "")"
                          style="@(cell is null ? "" : $"--held:{cell.PercentHeld}%")"
                          title="@(cell is null ? "not asked for this listing" : $"{cell.PercentHeld}% of the day held")">
                        @(cell is null ? "—" : cell.PercentHeld.ToString())
                    </span>
                }
            }
        </div>
        @* Шкала подписана, иначе насыщенность клетки — просто оттенок. Полоса рисуется теми же
           двумя цветами, что и клетки, поэтому её концы можно приложить к сетке глазами. *@
        <div class="v2-cov-key">
            <span>0 %</span>
            <span class="v2-cov-ramp"></span>
            <span>100 % of the window held</span>
        </div>
    }

    <div class="v2-gaps">
        <span class="csx-eyebrow">Open and closed gaps</span>
        @if (Model.Gaps.Count == 0)
        {
            <p class="v2-empty v2-empty--inline">Nothing has broken on these venues in the last day.</p>
        }
        else
        {
            foreach (var g in Model.Gaps)
            {
                <div class="v2-gap">
                    <span class="v2-gap-what">@g.SegmentCode · @g.Collector</span>
                    <span class="v2-gap-state @(g.GapEnd is null ? "v2-gap-state--open" : "")">@(g.GapEnd is null ? "open" : "closed")</span>
                    <span class="v2-gap-why">@g.Cause.Replace("_", " ")@(g.Detail is null ? "" : " — " + g.Detail)</span>
                    <span class="v2-gap-when">@Format.UtcClock(g.GapStart) → @(g.GapEnd is null ? "open" : Format.UtcClock(g.GapEnd))</span>
                </div>
            }
        }
    </div>

    @* ── что ещё есть у этого актива ───────────────────────────────────────────
       Список НЕ каталог наборов, а перепись того, что для ЭТОГО актива лежит в базе прямо
       сейчас: строки собраны из тех же значений, что нарисованы выше, и ни одна не утверждает
       больше того, что страница уже показала. Набор, у которого для актива ничего нет, так и
       написан — «ничего», а не пропущен: разница между «не собираем» и «собираем, но пусто»
       и есть половина смысла этой полосы. *@
    @{
        var listings = Model.Rows.Count;
        var withCandles = Model.Rows.Count(r => r.Candles.Present > 0);
        var bars = Model.Rows.Sum(r => r.Candles.Present);
        var withFunding = Model.Rows.Count(r => r.Metrics.Funding.Any(f => f is not null));
        var fundingNow = Model.Rows.Count(r => r.Row.FundingRate is not null);
        var bookLevels = Model.Books.Values.Select(b => (int)b.Levels).DefaultIfEmpty(0).Max();
        var newestBook = Model.Books.Values.Select(b => (DateTime?)b.ObservedAt).DefaultIfEmpty(null).Max();
        var tapeVenues = Model.Tape.Select(t => t.InstrumentId).Distinct().Count();
        var liqVenues = Model.Rows.Count(r => r.Liquidations.Any(v => v is not null));
        var openGaps = Model.Gaps.Count(g => g.GapEnd is null);

        // (заголовок, что реально лежит, куда смотреть, якорь, срез)
        var reach = new (string Name, string What, string Where, string Href, string? Cut)[]
        {
            ("Candles",
             withCandles == 0
                 ? "nothing stored for this asset yet"
                 : $"{bars} hourly bars over {withCandles} of {listings} listings, one scale per quote asset",
             "The cut → Price", "#band-cuts", "price"),

            ("Funding history",
             withFunding == 0
                 ? (fundingNow == 0 ? "no listing here publishes funding" : "a rate now, but no hourly history kept yet")
                 : $"hourly rates on {withFunding} of {listings} listings, each at that venue's own interval",
             "The cut → Funding", "#band-cuts", "funding"),

            ("Level book",
             Model.Books.Count == 0
                 ? "no frame in the last ten minutes"
                 : $"{bookLevels} levels a side on {Model.Books.Count} of {listings} listings, newest {Format.UtcClock(newestBook)}",
             "Band 2", "#band-now", null),

            ("Trades",
             Model.Tape.Count == 0
                 ? "no fill in the last hour"
                 : $"every fill with taker side and venue clock — {Model.Tape.Count} shown from {tapeVenues} listings",
             "Band 4", "#band-tape", null),

            ("Liquidations",
             liqVenues == 0
                 ? "no venue here has reported a liquidation bucket in the last day"
                 : $"hourly buckets on {liqVenues} of {listings} listings, in the venues' own aggregate",
             "The cut → Liquidations", "#band-cuts", "liquidations"),

            ("Coverage & gaps",
             datasets.Count == 0
                 ? "no coverage written for this asset in the last day"
                 : $"{datasets.Count} datasets tracked, {Model.Gaps.Count} breaks recorded, {openGaps} still open",
             "Band 5", "#band-trust", null),
        };
    }
    <div class="v2-reach">
        <span class="csx-eyebrow">Everything else this asset has</span>
        @foreach (var e in reach)
        {
            <div class="v2-reach-row">
                <span class="v2-reach-name">@e.Name</span>
                <span class="v2-reach-what">@e.What</span>
                <span class="v2-reach-where"><a href="@e.Href" data-goto-cut="@e.Cut">@e.Where</a></span>
            </div>
        }
    </div>
</section>

<footer class="v2-foot">
    <span>Not investment advice · Own funds only</span>
    @*
        ОБЯЗАТЕЛЬСТВО ПО ЛИЦЕНЗИИ, а не любезность, и здесь оно повторено намеренно.
        На первой странице эта ссылка стоит в общем layout; у этой Layout = null, поэтому она
        подвал не наследует — и без этой строки страница со свечами вышла бы без ссылки, которой
        требует документация TradingView к attributionLogo: уведомление в коде И ссылка на
        https://www.tradingview.com/ на странице, доступной пользователю. NOTICE рядом с
        вендоренным файлом закрывает пункт 4(d) Apache 2.0 сам по себе; эта строка закрывает второе.
    *@
    <span>Candles by <a href="https://www.tradingview.com/" rel="noopener">TradingView</a> Lightweight&nbsp;Charts™</span>
    <a href="~/@Model.BaseFamily">First design of this page</a>
</footer>

@* Библиотека грузится только если есть что рисовать: 198 КБ на странице без свечей — это
   198 КБ, потраченных, чтобы не нарисовать ничего. *@
@if (drawable.Count > 0)
{
    <script src="~/vendor/lightweight-charts/lightweight-charts-5.2.1.standalone.production.js?v=1"></script>
    <script src="~/studio-candles.js?v=5"></script>
}
<script src="~/studio-ages.js?v=4"></script>
<script src="~/studio-live.js?v=2"></script>
<script src="~/studio-v2.js?v=8"></script>
</body>
</html>
