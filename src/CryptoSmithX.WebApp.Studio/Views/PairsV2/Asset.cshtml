@using CryptoSmithX.WebApp.Studio.Data
@model PairPageModel
@{
    Layout = null;
    var title = $"{Model.BaseFamily} · {Model.Listings} listings";
    ViewData["Title"] = title;

    var perp = Model.Rows.Count(r => r.Row.SegmentKind == "perp");
    var spot = Model.Rows.Count(r => r.Row.SegmentKind == "spot");
    var fieldsEach = V2Columns.All.Count;

    // Counted, not claimed. The header prints these and a reader can check every one against what
    // is drawn below — which is the only reason to print them at all.
    var figures = Model.Rows.Count * fieldsEach;
    var books = Model.Rows.Count(r => r.Row.DepthAt is not null);
    var series = Model.Rows.Count(r => r.Candles.Bars.Any(b => b is not null));

    // The verdict: how many of the three calls behind each row are past the window their own dataset
    // sets. It is the page's own answer to "can any of this still be believed", and it is a count
    // rather than an adjective so a reader can check it against the ages in the rows.
    var behind = Model.Rows.Sum(r =>
        (Freshness.PastWindow(r.Ages.PriceSeconds, r.Windows.PriceSeconds) ? 1 : 0)
        + (Freshness.PastWindow(r.Ages.DepthSeconds, r.Windows.DepthSeconds) ? 1 : 0)
        + (Freshness.PastWindow(r.Ages.OpenInterestSeconds, r.Windows.OpenInterestSeconds) ? 1 : 0));

    var cuts = V2Cuts.All;

    var oldest = Model.Rows
        .SelectMany(r => new[] { r.Ages.PriceSeconds, r.Ages.DepthSeconds, r.Ages.OpenInterestSeconds })
        .Where(a => a is not null)
        .DefaultIfEmpty(null)
        .Max();
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@title · CryptoSmith X</title>
    <link rel="stylesheet" href="~/ds/styles.css">
    @* ?v= — не украшение. Cloudflare кеширует статику этого домена, и без версии в адресе
       страница получает старый файл: правки вёрстки уехали на тест, а браузеру пришёл CSS
       трёхчасовой давности (cf-cache-status: HIT, age 3068), из-за чего полоса 2 шла голым
       текстом, а линии графиков разъезжались на пол-экрана. Ровно та же ловушка, что уже
       ловила studio-live.js. Поднимать при каждой правке файла. *@
    <link rel="stylesheet" href="~/studio-v2.css?v=59">

    @* Тема применяется ДО первой отрисовки и поэтому здесь, а не скриптом внизу страницы:
       поставленная снизу, она показала бы светлый экран и мигнула тёмным — ровно то, ради чего
       ночь и включают, в обратную сторону.

       КЛЮЧ ТОТ ЖЕ, ЧТО У ПЕРВОЙ СТРАНИЦЫ (csx-studio-theme), и логика та же: выбор читателя, а
       если его нет — системная настройка. Свой ключ означал бы, что переход со списка пар на
       эту страницу переключает свет. *@
    <script>
        (function () {
            try {
                var stored = localStorage.getItem('csx-studio-theme');
                var night = stored ? stored === 'night'
                    : window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (night) { document.documentElement.setAttribute('data-theme', 'night'); }
            } catch (e) { /* приватное окно отказывает в хранилище — дневной набор рабочий ответ */ }
        })();
    </script>
</head>
@*
    Три постоянных затухания едут с сервера, а не переписываются в JavaScript второй раз: это
    правило 2 дизайн-системы, оно уже лежит в Freshness.cs, и копия в файле, который не собирает
    ни один CI, — ровно та форма ошибки, которая у этого проекта уже была.
*@
<body class="v2 a-sheet"
      data-now="@Model.RenderedAt.ToUnixTimeMilliseconds()"
      data-fade-floor="@Freshness.Floor.ToString(System.Globalization.CultureInfo.InvariantCulture)"
      data-fade-exponent="@Freshness.Exponent.ToString(System.Globalization.CultureInfo.InvariantCulture)"
      data-degraded-windows="@Freshness.DegradedWindows"
      data-late-floor="@Freshness.LateFloorSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)"
      data-late-cadence-multiplier="@Freshness.LateCadenceMultiplier.ToString(System.Globalization.CultureInfo.InvariantCulture)"
      data-age-space>

@* ── шапка ─────────────────────────────────────────────────────────────────── *@
<header class="v2-head">
    <a class="v2-wordmark" href="~/">CryptoSmith X</a>
    <span class="csx-eyebrow v2-crumb">Asset · @Model.BaseFamily</span>
    @* Метка и значение — РАЗНЫЕ вещи и набраны по-разному: одной строкой мелкого капса они
       читались как одна надпись, в которой не видно, где кончается «collected» и начинается
       время. INK стоит здесь же, у правого края шапки, а не в ряду контролов: он про то, как
       смотреть на страницу, а не про то, что она показывает. *@
    <span class="v2-stamps">
        <span><span class="v2-stamp-label">Collected</span>
            <span class="v2-stamp-value">@Format.UtcClock(Model.CollectedFrom) – @Format.UtcClock(Model.CollectedTo)</span></span>
        <span><span class="v2-stamp-label">Rendered</span>
            <span class="v2-stamp-value">@Format.UtcClock(Model.RenderedAt.UtcDateTime)</span></span>
        <button type="button" id="a-ink" class="v2-ink" hidden>Ink</button>
    </span>
</header>

<div class="v2-title">
    @* ЗАГОЛОВОК НАЗЫВАЕТ НАХОДКУ, а не пересчитывает строки. «Five listings quote ADA.» — это
       оглавление таблицы, которая и так ниже; вторая половина — то, ради чего страницу открыли.

       ТЕКСТ ПОСТОЯННЫЙ, ДВИГАЮТСЯ ТОЛЬКО ЦИФРЫ. Раньше здесь стояла одна из пяти фраз, и самая
       крупная строка на экране меняла длину при каждой смене состояния. Теперь слова стоят на
       месте, а меняется число — каждое в своём слоте, выключенное вправо.

       Числа набраны МОНОШИРИННЫМ, и это не вкус: дисплейная гарнитура не несёт табличных цифр,
       поэтому «1» и «8» в ней разной ширины, и слот удержал бы строку, но не сами цифры внутри.
       Слова остаются дисплейными; из неё выходит только то, что меняется.

       Прочерк вместо нуля, когда судить не о чем: страница, где ещё ничего не наблюдали или где
       никто не заявил такта, НЕ говорит «всё в своём окне».

       Живым потоком это не переписывается: .v2-title лежит снаружи и #band-table, и #band-now —
       единственных [data-live-region] здесь. Тикающий клиент (studio-ages.js) обновляет слоты
       каждую секунду по тем же вызовам, что и возрасты под цифрами. *@
    @{ var counts = Statement.Counts(Model.Rows); }
    <h1>@Model.Listings listings quote @Model.BaseFamily.
        <em class="v2-statement" data-statement-verdict>Past window <b data-statement-late
            title="Calls past their own window">@StatementCounts.Slot(counts.Late)</b> ·
            degraded <b data-statement-degraded
            title="Feeds past twelve windows — they have stopped meaning anything">@StatementCounts.Slot(counts.Degraded)</b></em></h1>
    <span class="v2-meta">
        @Model.PlatformCount platforms · @perp perp · @spot spot ·
        @fieldsEach fields each · @figures figures · @books books · @series series
    </span>
</div>

<div class="v2-controls">
    <a class="v2-back" href="~/">Back to list</a>

    @* LIVE, и теперь за ним поток. Хуки — те же, что у первой страницы (.a-liverow, #a-live,
       .a-switch-label, #a-live-note): у этих двух страниц ОДИН клиент живого потока, потому что
       вся тонкая часть у него не в разметке, а в поведении при обрыве — пять попыток, слово
       вместо тишины, отказ по заполненности. Второй экземпляр этого поведения был бы вторым
       местом, где рвущийся поток однажды промолчит.

       Кнопка приходит скрытой и показывается скриптом: без EventSource страница остаётся
       статической — полной и верной, — а видимый неработающий тумблер был бы обещанием. *@
    <span class="a-liverow" data-live-url="@Url.Action("Live", "PairsV2", new { baseFamily = Model.BaseFamily })">
        <button type="button" id="a-live" class="v2-switch" role="switch" aria-checked="false" hidden>
            <i></i><em class="a-switch-label">Live</em>
        </button>
        @* Слово о состоянии потока стоит ВНУТРИ .a-liverow, потому что клиент ищет его там же,
           где кнопку: разнести их — и обрыв будет сообщён в никуда. В обычном состоянии его не
           видно — эталон в этом ряду держит только тумблеры и возраст снимка, — а вот об обрыве
           страница обязана сказать словами, и тогда оно появляется. *@
        <span id="a-live-note" class="v2-livenote"></span>
    </span>
    @* EXPAND ALL убран вместе с раскрытием: все двадцать две колонки видны сразу, разворачивать
       нечего. Кнопка, которой нечего открыть, — обещание, которого не будет. *@

    @* ── Телефон ─────────────────────────────────────────────────────────────
       На 390 px таблица семи групп на пять площадок — это 950 px сетки, то есть горизонтальная
       прокрутка поверх вертикальной и ни одного сравнения, которое можно сделать глазами.

       Два режима, и по умолчанию — СРАВНЕНИЕ ОДНОГО ПОЛЯ: одна метрика, все листинги, отсортированы,
       с барами. Это тот же вопрос, ради которого страница сделана, только заданный по одному полю
       за раз, потому что больше на ладонь не помещается честно. Второй режим — карточка на листинг,
       когда читателя интересует одна площадка целиком. *@
    <button type="button" id="m-mode" class="v2-switch v2-mobile-only" aria-pressed="false">
        <i></i><em>By listing</em>
    </button>

    <span class="v2-note">
        A snapshot, @Format.SpacedAge(oldest) old. Nothing here is hidden except what you folded.
    </span>

    @* Что ниже — списком, чтобы под сгибом не было сюрпризов. *@
    <nav class="v2-toc v2-mobile-only" aria-label="Bands on this page">
        <a href="#band-table">1 Every figure</a>
        <a href="#band-now">2 Now</a>
        <a href="#band-time">3 Over time</a>
        <a href="#band-tape">4 The tape</a>
        <a href="#band-trust">5 What is behind</a>
    </nav>
</div>

<partial name="_V2Table" model="Model" />

@* ── выбор измерения: одно на обе полосы ─────────────────────────────────────
   Полосы 2 и 3 отвечают на ОДИН выбор: как площадки стоят сейчас и как они к этому пришли.
   В первом наброске селектор висел только на нижней, а верхняя была прибита к глубине — из-за
   этого они читались как две несвязанные вещи, и вопрос «почему книги не меняются, когда я
   выбираю открытый интерес» оставался без ответа. *@
<div class="v2-cutbar" id="band-cuts">
    <span class="csx-eyebrow v2-cutbar-label">One field, two views</span>
    <span class="csx-eyebrow v2-cutbar-sub">Bands 2 and 3 answer the same choice: how it stands now, and how it got there</span>
    <span class="v2-cutpicks">
        @{ var bookNote = V2Notes.Book(Model); }
        @foreach (var c in cuts)
        {
            @* Заголовок и подпись полосы 2 меняются вместе со срезом, поэтому строки едут с
               кнопкой, которая их выбирает: иначе их пришлось бы держать вторым списком в
               скрипте — тем самым, который однажды разойдётся с этим. *@
            <button type="button" class="v2-cutpick" data-cut="@c.Key"
                    data-title="@(c.Key == "price" ? "The books" : "Now, across venues")"
                    data-note="@(c.Key == "price" ? bookNote : c.Unit)"
                    data-series="@c.Name · @c.Unit"
                    data-unit="@(c.Key == "depth25" ? "base units · bid ◂ ▸ ask, one scale" : c.Unit)"
                    data-rank-note="@c.RankNote"
                    aria-pressed="@(c.Key == "price" ? "true" : "false")">@c.Name</button>
        }
    </span>
</div>

<partial name="_V2Now" model="Model" />

@* ── полоса 3: во времени, по площадкам ──────────────────────────────────────── *@
<section class="v2-band" id="band-time">
    <div class="v2-band-head">
        <span class="csx-eyebrow v2-band-no">3 · Over time, across venues</span>
        @* B3: everything between here and .v2-cols is the timeframe/series choice — swapped by
           studio-v2-band3.js on a click, never the rest of the header. display:contents keeps the
           wrapper transparent to the flex layout: its children are the flex items, not the div. *@
        <div id="band3-head" style="display:contents">
            <partial name="_V2Band3Head" model="Model" />
        </div>
        @* Имя поля, затем COLUMNS — так COLUMNS stays the rightmost control, matching band 2's own
           header. It used to sit the other way round, with the field name trailing it. *@
        <span class="csx-eyebrow v2-band-field" id="cut-time-sub">@cuts[0].Name</span>
        <span class="v2-cols" role="group" aria-label="Chart columns" data-cols-key="charts" data-cols-target=".v2-cuts">
            <span class="csx-eyebrow v2-cols-label">Columns</span>
            @for (var n = 5; n >= 1; n--)
            {
                <button type="button" class="v2-cols-btn" data-cols="@n"
                        title="@(n == 1 ? "1 column" : $"Up to {n} columns")" aria-pressed="false">
                    <span class="v2-cols-icon" aria-hidden="true">@for (var i = 0; i < n; i++) { <i></i> }</span>
                </button>
            }
        </span>
    </div>

    @* Цена рисуется свечами той же вендоренной библиотекой, что и на первой странице, и по тому
       же контракту разметки (.a-chart[data-candles]) — второй рендерер значил бы два разных
       представления одних и тех же баров. Остальные измерения — часовые ряды, они линия.
       B3: id'd for studio-v2-band3.js, which replaces only its INNER content on a switch — the
       div's own data-cols/data-cut stay put, so the reader's column choice survives a switch. *@
    <div class="v2-cuts" id="band3-cuts" data-cols="4" data-cut="price">
        <partial name="_V2Band3Cuts" model="Model" />
    </div>

    @foreach (var c in cuts.Where(c => c.Source != V2CutSource.Candles))
    {
        <div class="v2-cuts" data-cols="4" data-cut="@c.Key" hidden>
            @{ var any = Model.Rows.Any(r => V2Cuts.Series(r, c).Any(v => v is not null)); }
            @if (!any)
            {
                <p class="v2-empty">No hourly series is kept for @c.Name.</p>
            }
            else
            {
                @* Каждая линия НОРМИРОВАНА ПО СЕБЕ — иначе площадка с втрое большей книгой сплющила
                   бы остальные в прямые, — и именно поэтому у неё обязаны быть подписаны концы:
                   без них линия говорит только «росло/падало», а на вопрос «с чего и до чего» не
                   отвечает вовсе. Под полосой — общие минимум и максимум среза по всем площадкам,
                   то, чего отдельная линия сказать не может. FUNDING — исключение (Prompt 2, U-2):
                   ноль значит что-то одно на каждой площадке, поэтому её ось общая и симметричная
                   относительно нуля, а не своя на каждую линию. *@
                var fundingMaxAbs = c.Key == "funding"
                    ? Model.Rows.SelectMany(r => V2Cuts.Series(r, c)).Where(v => v is not null)
                        .Select(v => Math.Abs(v!.Value)).DefaultIfEmpty(0).Max()
                    : 0;

                // Prompt 2, U-9: band 3's cards follow band 2's own order for this cut — the same
                // NOW figure, the same direction (c.HighIsBest) — so a reader who just read band 2
                // top-to-bottom finds the same venue first here. Band 1 is unaffected; only this
                // band's row order changes.
                double? NowOf(VenueRowModel x)
                {
                    Model.Stress.TryGetValue(x.Row.InstrumentId, out var s);
                    return V2Cuts.Now(x, c, s);
                }

                var orderedRows = c.HighIsBest
                    ? Model.Rows.OrderByDescending(x => NowOf(x) ?? double.MinValue).ToList()
                    : Model.Rows.OrderBy(x => NowOf(x) ?? double.MaxValue).ToList();

                var drawn = new List<string>();
                var missing = new List<string>();
                foreach (var r in orderedRows)
                {
                    var vals = V2Cuts.Series(r, c);
                    if (vals.Count(v => v is not null) == 0)
                    {
                        missing.Add(r.Row.ExchangeName + " " + r.Row.Symbol);
                    }
                }

                foreach (var r in orderedRows)
                {
                    var vals = V2Cuts.Series(r, c);
                    var held = vals.Count(v => v is not null);
                    if (held == 0)
                    {
                        continue;
                    }

                    var seen = vals.Where(v => v is not null).Select(v => v!.Value).ToList();
                    var first = seen[0];
                    var last = seen[^1];

                    // Prompt 2, U-4: below eight held points a line is two or three dots joined by
                    // a guess, not a shape — "Same rule applies to the sparkline cards in band 3".
                    // The card still renders (figure and footer only), and the hatch that normally
                    // covers only the un-held HEAD of the axis covers the whole plot instead.
                    var thin = held < 8;

                    string? path = thin ? null : c.Key == "funding"
                        ? Format.SparkPathScaled(vals, -fundingMaxAbs, fundingMaxAbs, 260, 64)
                        : Format.SparkPath(vals, 260, 64);

                    // P0-2: the same "last point's own age" disclosure the candle cards carry,
                    // read off the SAME window list (r.Metrics.Windows) the line itself is drawn
                    // on — index-aligned with vals, so the last non-null index names the hour.
                    var lastIndex = vals.ToList().FindLastIndex(v => v is not null);
                    var lastWindow = lastIndex >= 0 ? r.Metrics.Windows[lastIndex] : (DateTime?)null;
                    var lastAgeSeconds = lastWindow is { } lw
                        ? (Model.RenderedAt - new DateTimeOffset(DateTime.SpecifyKind(lw, DateTimeKind.Utc))).TotalSeconds
                        : (double?)null;
                    const int hourSeconds = 3600;
                    var stale = lastAgeSeconds is { } age2 && age2 > 2 * hourSeconds;

                    // P0-2: same hatch, SVG form — the sparkline has no chart-library container to
                    // hang a CSS background on, so the un-held share of the axis is a literal
                    // pattern fill behind the line instead.
                    //
                    // Кромка берётся у самой линии (Format.SparkX), а не как доля ширины: доля
                    // ширины считает шаг как 260/n, а линия ставит точки с шагом 259/(n-1), и
                    // штриховка каждый раз не доходила до первой точки на несколько единиц.
                    var hatchIndex = vals.ToList().FindIndex(v => v is not null);
                    var hatchWidth = thin ? 260
                        : hatchIndex > 0 && vals.Count > 1 ? Format.SparkX(hatchIndex, vals.Count, 260) : 0;
                    <div class="v2-cut@(stale ? " v2-cut--stale" : "")">
                        <span class="v2-cut-plat"><b>@r.Row.ExchangeName</b> <em>@r.Row.Symbol</em></span>
                        <svg class="v2-line" viewBox="0 0 260 64" preserveAspectRatio="none" aria-hidden="true">
                            @if (hatchWidth > 0)
                            {
                                <defs>
                                    <pattern id="v2-hatch-@r.Row.InstrumentId-@c.Key" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                                        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--border-hairline)" stroke-width="1" />
                                    </pattern>
                                </defs>
                                <rect x="0" y="0" width="@hatchWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" height="64"
                                      fill="url(#v2-hatch-@r.Row.InstrumentId-@c.Key)" />
                            }
                            @if (path is not null && c.Key == "funding")
                            {
                                @* Prompt 2, U-2: zero baseline plus a sign-split fill. lo = -max,
                                   hi = +max is symmetric by construction, so zero always lands at
                                   y=32 (SparkPathScaled's own doc) — the same closed shape (curve
                                   to baseline), clipped to the upper and lower half in turn, is
                                   exactly "green where the curve is above zero, magenta where it
                                   is below" without splitting the path itself. *@
                                <defs>
                                    <clipPath id="v2-fundup-@r.Row.InstrumentId-@c.Key"><rect x="0" y="0" width="260" height="32" /></clipPath>
                                    <clipPath id="v2-funddown-@r.Row.InstrumentId-@c.Key"><rect x="0" y="32" width="260" height="32" /></clipPath>
                                </defs>
                                <line x1="0" y1="32" x2="260" y2="32" stroke="var(--border-hairline)" stroke-width="1" vector-effect="non-scaling-stroke" />
                                <path d="@(path) L 260 32 L 0 32 Z" fill="var(--candle-up)" fill-opacity=".25" stroke="none" clip-path="url(#v2-fundup-@r.Row.InstrumentId-@c.Key)" />
                                <path d="@(path) L 260 32 L 0 32 Z" fill="var(--candle-down)" fill-opacity=".25" stroke="none" clip-path="url(#v2-funddown-@r.Row.InstrumentId-@c.Key)" />
                                <path d="@path" fill="none" stroke="var(--text-heading)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
                            }
                            else if (path is not null)
                            {
                                @* Заливка под линией — та же кривая, замкнутая по нижнему краю:
                                   она не добавляет данных, но даёт линии вес, которого у волоска в
                                   один пиксель на светлом фоне нет. *@
                                <path d="@(path) L 260 64 L 0 64 Z" fill="currentColor" fill-opacity=".12" stroke="none" />
                                <path d="@path" fill="none" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" />
                            }
                        </svg>
                        <span class="v2-cut-scale">
                            <span>@Format.Num(last, c.Decimals) @c.Short</span>
                            @if (c.Key == "funding")
                            {
                                // Prompt 2, U-2: absolute change over the held window in bp/day,
                                // sign-coloured — not the percentage delta every other cut shows,
                                // which reads oddly beside a figure that is already signed.
                                var changeBpd = thin ? (double?)null : (last - first) * 10000;
                                <span class="@(changeBpd is > 0 ? "v2-delta--up" : changeBpd is < 0 ? "v2-delta--down" : "")">
                                    @(changeBpd is null ? "" : (changeBpd > 0 ? "+" : "") + Format.Num(changeBpd, 1) + " bp/d")
                                </span>
                            }
                            else
                            {
                                var delta = thin || first == 0 ? (double?)null : (last - first) / Math.Abs(first) * 100;
                                <span class="@(delta is > 0 ? "v2-delta--up" : delta is < 0 ? "v2-delta--down" : "")">
                                    @(delta is null ? "" : (delta > 0 ? "+" : "") + Format.Num(delta, 1) + "%")
                                </span>
                            }
                        </span>
                        <span class="v2-cut-age">
                            @if (lastWindow is { } lw2)
                            {
                                @:last bar @Format.UtcDayMonthClock(lw2) · @Format.SpacedAge(lastAgeSeconds) ago ·
                            }
                            @held of @vals.Count hours held
                            @* B4: gap_seconds distinguishes a quiet market from a blind collector —
                               the shortfall above can be either, and only this number says which.
                               Silent at zero, the common case, rather than printing "0s blind" on
                               every panel. *@
                            @if (r.Metrics.GapSecondsHeld > 0)
                            {
                                @:· @(r.Metrics.GapSecondsHeld)s blind
                            }
                        </span>
                    </div>
                }

                @* Одной строкой снизу, а не по разу на площадку: пять одинаковых абзацев
                   «Not measured on this venue.» занимают пять клеток сетки и говорят одно. *@
                @if (missing.Count > 0)
                {
                    <p class="v2-legend v2-cuts-foot">Not measured: @string.Join(", ", missing).</p>
                }
            }
        </div>
    }
</section>


@* ── полосы 4 и 5 рядом ──────────────────────────────────────────────────────
   Лента узкая и длинная, покрытие широкое и низкое; поставленные друг под друга, они гнали
   страницу вниз и разводили два ответа на один вопрос «чему тут верить» на два экрана. *@
<div class="v2-pair">

@* ── полоса 4: лента ────────────────────────────────────────────────────────── *@
<section class="v2-band" id="band-tape">
    <div class="v2-band-head">
        <span class="csx-eyebrow v2-band-no">4 · The tape</span>
        @* Пик за час, посчитанный, а не переписанный из макета: секунда, в которую по этому
           активу прошло больше всего сделок на всех площадках сразу. *@
        <span class="csx-eyebrow v2-band-sub">up to @Format.Num(Model.TapePeakPerSecond, 0) fills a second on this asset ·
            the last @Model.Tape.Count shown</span>
        @* Тумблер, за которым что-то стоит. Лента — единственное на странице, что живёт само,
           поэтому она и единственное, что имеет смысл опрашивать: включённый FOLLOW раз в пять
           секунд просит те же восемнадцать сделок и подставляет их на место. Выключенный —
           оставляет то, что вы читаете, ровно там, где оно есть. *@
        @* Prompt 2, U-7: the band's own age, so a reader with FOLLOW off can see AT A GLANCE
           whether "the tape" is five seconds old or five minutes — the toggle is right beside
           it, one look answers "should I press this". studio-v2.js rewrites this text on every
           poll while FOLLOW is on ("following · 5 s"); it starts as printed here, off. *@
        @{
            var newest = Model.Tape.Count > 0 ? Model.Tape.Max(t => t.EventTime) : (DateTime?)null;
            var tapeAgeSeconds = newest is { } newestAt
                ? (Model.RenderedAt - new DateTimeOffset(DateTime.SpecifyKind(newestAt, DateTimeKind.Utc))).TotalSeconds
                : (double?)null;
        }
        <span class="csx-eyebrow v2-tape-status @(tapeAgeSeconds is > 60 ? "v2-tape-status--stale" : "")" id="tape-status">
            @(tapeAgeSeconds is null ? "no prints yet" : "last print " + Format.SpacedAge(tapeAgeSeconds) + " ago")
        </span>
        <span class="v2-follow">
            <button type="button" id="tape-follow" class="v2-toggle" role="switch" aria-checked="false"
                    data-url="@Url.Action("Tape", "PairsV2", new { baseFamily = Model.BaseFamily })"
                    title="ask the venues for this asset's fills every five seconds and keep the newest at the top">
                <span class="v2-toggle-knob"></span>
            </button>
            <label for="tape-follow">Follow</label>
        </span>
    </div>

    @{
        // Prompt 2, U-7: the p95 print size the SIZE bar is measured against. "The last 200
        // prints on this asset" would need its own query past the eighteen this band already
        // holds; read from the held batch instead — the same simplification the Tape() JSON
        // endpoint below makes, so a snapshot render and a FOLLOW poll agree on what p95 means.
        var sizeSample = Model.Tape.Select(t => t.Qty).OrderBy(q => q).ToList();
        var p95 = Format.Percentile(sizeSample, 0.95);
    }
    <div class="v2-tape">
        <div class="v2-tape-head">
            <span>Time</span><span>Venue</span><span>Side</span>
            <span class="v2-r">Price</span><span class="v2-r">Size</span>
        </div>
        @* Тело ленты отдельным узлом: FOLLOW заменяет ЕГО, а не полосу, поэтому шапка,
           заголовок и подпись под лентой остаются на месте между опросами. *@
        <div class="v2-tape-body" id="tape-body">
            @if (Model.Tape.Count == 0)
            {
                <p class="v2-empty">
                    No fills recorded in the last hour. The trades dataset is collected per venue — an
                    empty tape here is either a quiet asset or a venue whose trades are switched off,
                    and band 5 below says which.
                </p>
            }
            @foreach (var t in Model.Tape)
            {
                var owner = Model.Rows.FirstOrDefault(r => r.Row.InstrumentId == t.InstrumentId);
                var kind = t.TradeType ?? "fill";
                var loud = kind is "liquidation" or "partial_liquidation" or "termination";
                var sizePct = p95 is { } m && m > 0 ? Math.Min(100.0, t.Qty / m * 100.0) : 0;
                var overP95 = p95 is { } m2 && t.Qty > m2;
                <div class="v2-tape-row v2-tape-row--@t.TakerSide @(loud ? "v2-tape-row--loud" : "")">
                    @* hh:mm:ss в обычных чернилах, .mmm тускло — лента покрывает час, и часы
                       должны быть видны: без них 00:21 читается позже 59:04. *@
                    <span>@t.EventTime.ToString("HH:mm:ss")<em>@t.EventTime.ToString(".fff")</em></span>
                    <span title="@(owner?.Row.ExchangeName ?? "—")">@Format.VenueCode(owner?.Row.ExchangeName ?? "—")</span>
                    <span class="v2-side v2-side--@t.TakerSide">@t.TakerSide.Substring(0, 1).ToUpperInvariant()</span>
                    <span class="v2-r v2-tape-price">@Format.Num(t.Price, 6)</span>
                    <span class="v2-r v2-tape-size @(overP95 ? "v2-tape-size--over" : "")">
                        <i style="width:@sizePct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></i>
                        <b>@Format.Num(t.Qty, 0)</b>
                    </span>
                </div>
            }
        </div>
    </div>
    <p class="v2-legend">
        The tape is the one thing on this page that moves on its own, because a tape is a tape.
        Three fills can carry one millisecond between them and they are three rows, not one.
        Everything else changes when a pass lands.
    </p>
</section>

@* ── полоса 5: что стоит за цифрами ─────────────────────────────────────────── *@
<section class="v2-band" id="band-trust">
    <div class="v2-band-head">
        <span class="csx-eyebrow v2-band-no">5 · What is behind the figures</span>
        <span class="csx-eyebrow v2-band-sub">coverage per dataset · one colour, one metric, one axis of venues ·
            gaps stay open until they close</span>
    </div>

    @* ВСЕ наборы, из которых страница рисует, а не только те, по которым что-то записано:
       набор, который никто не собрал, раньше просто исчезал из полосы — то есть полоса «что стоит
       за цифрами» молчала ровно там, где читателю нужнее всего, у цифры, которой нет. *@
    <div class="v2-cov" style="--vcols:@Model.Rows.Count">
        <span class="v2-cov-corner"></span>
        @foreach (var r in Model.Rows)
        {
            @* ОДНА строка и одно слово: там, где площадка в таблице одна, это её имя; где их две
               (Binance в USDT и в USDC) — котировка, потому что именно она их и различает. *@
            <span class="v2-cov-vh">@(Model.Rows.Count(x => x.Row.ExchangeName == r.Row.ExchangeName) > 1
                ? r.Row.QuoteAsset : r.Row.ExchangeName)</span>
        }
        @foreach (var d in V2Coverage.Datasets)
        {
            @* Подпись строки — из списка наборов полосы, а не из общего словаря имён: полоса 5
               перечисляет наборы эталона его же словами, и второй источник для той же надписи
               однажды даст в одной строке два разных названия.
               B4: TRACKED datasets only get the disclosure trigger — an untracked one (snapshot,
               trades, book) never has a coverage row to show (V2Coverage.Cell's own NotTracked
               branch), so a trigger there would open a panel that always says so and never
               anything else. *@
            @if (d.Tracked)
            {
                <button type="button" class="v2-cov-dh v2-cov-dh--open" title="@d.Draws" aria-expanded="false"
                        data-disclose-url="@Url.Action("CoverageDetail", "PairsV2", new { ids = string.Join(",", Model.Rows.Select(r => r.Row.InstrumentId)), dataset = d.Code })"
                        data-disclose-target="coverage-@d.Code">@d.Label</button>
            }
            else
            {
                <span class="v2-cov-dh" title="@d.Draws">@d.Label</span>
            }
            @foreach (var r in Model.Rows)
            {
                @* P0-3 (UX audit): six states, not four, and none of them "—" — every cell in this
                   grid used to be able to print a bare dash, which on WEEX SNAPSHOT read as "never
                   collected" while the gap list two panels down named a four-hour outage for
                   exactly that cell. See V2Coverage.Cell for what each state means. *@
                var cell = V2Coverage.Cell(Model, d, r);
                <span class="v2-cov-cell @cell.Class"
                      style="@(cell.Percent is { } pct ? $"--held:{pct}%" : "")"
                      data-cell="@(r.Row.SegmentCode):@d.Code"
                      title="@cell.Title">@cell.Text</span>
            }
            @if (d.Tracked)
            {
                <div class="v2-disclose" id="coverage-@d.Code" hidden style="grid-column:1/-1"></div>
            }
        }
    </div>
    @* Шкала подписана И названа окном: голое «84» в клетке — это не процент чего угодно. *@
    <div class="v2-cov-key">
        <span>0 %</span>
        <span class="v2-cov-ramp"></span>
        <span>100 % of the window held</span>
    </div>
    @* P0-3: the matrix's six states, in words — a notch and a dotted border are shapes, not
       colours, and this is where a reader who cannot tell green from magenta finds out what they
       mean without needing to. *@
    <p class="v2-legend">
        notch = gap in window · dotted = throttled · hatched = not provided by venue · live/stale
        = not a windowed dataset
    </p>
    <div class="v2-gaps">
        <span class="csx-eyebrow">Open and closed gaps</span>
        @{
            var lines = GapLine.Fold(Model.Gaps);

            // P0-4 (UX audit): the SAME array the H1 counts and band 1's cell rule marks — a call
            // past its own window right now gets a synthetic OPEN row here too, so a reader who
            // reads the headline, then the table, then this list, sees one fact told three times
            // rather than three numbers that might not agree. StripCall.Label ("Price"/"Depth"/
            // "OI") maps onto the matrix's dataset codes for data-cell — Depth IS r.Ages.DepthSeconds,
            // the same clock V2Coverage.Cell reads for the "book" dataset's own LIVE/STALE state.
            var lateCalls = Statement.LateCalls(Model.Rows);
            string LateDataset(string label) => label switch
            {
                "Price" => "snapshot", "Depth" => "book", "OI" => "open_interest", _ => label.ToLowerInvariant(),
            };

            @* NEVER — третье состояние, и оно не разрыв: набор, которого у площадки не бывает,
               ничего не терял. Берётся из матрицы наборов, а не из журнала обрывов, потому что
               в журнале его и не может быть. *@
            var never = Model.Rows
                .SelectMany(x => V2Coverage.Datasets.Select(d => (Row: x.Row, Dataset: d)))
                .Where(x => !Model.Modes.TryGetValue((x.Row.SegmentCode, x.Dataset.Code), out var m) || m != "collect")
                .Select(x => (Who: Names.Segment(x.Row.SegmentCode) + " · " + x.Dataset.Label, x.Dataset))
                .Distinct()
                .ToList();
        }
        @if (lines.Count == 0 && never.Count == 0 && lateCalls.Count == 0)
        {
            <p class="v2-empty v2-empty--inline">Nothing has broken on these venues in the last day.</p>
        }
        else
        {
            foreach (var late in lateCalls)
            {
                <div class="v2-gap" data-cell="@late.Row.Row.SegmentCode:@LateDataset(late.Call.Label)">
                    <span class="v2-gap-what">@late.Row.Row.ExchangeName · @late.Call.Label</span>
                    <span class="v2-gap-state v2-gap-state--open">open</span>
                    <span class="v2-gap-why">Past its window</span>
                    <span class="v2-gap-when">open @Format.SpacedAge(late.Call.AgeSeconds)</span>
                </div>
            }

            foreach (var g in lines)
            {
                @* P0-3: the matrix key is by DATASET code, and a gap row's own Collector is the
                   collector_gap vocabulary — almost always the same string, except "book", whose
                   collector is named "depth" from before "book" existed as its own dataset. The
                   reverse lookup is the one place that has to know that, so the key matches the
                   matrix cell's data-cell on both ends. *@
                var gapDataset = V2Coverage.Datasets.FirstOrDefault(ds => ds.GapCollector == g.Collector)?.Code ?? g.Collector;
                <div class="v2-gap" data-cell="@g.SegmentCode:@gapDataset">
                    <span class="v2-gap-what">@Names.Segment(g.SegmentCode) · @Names.Dataset(g.Collector)</span>
                    <span class="v2-gap-state @(g.Open ? "v2-gap-state--open" : "")">@(g.Open ? "open" : "closed")</span>
                    <span class="v2-gap-why">@GapVoice.Say(g.Cause)@(g.Detail is null ? "" : " · " + g.Detail)@(g.Count > 1 ? $" × {g.Count}" : "")</span>
                    <span class="v2-gap-when">@Format.UtcClock(g.From) → @(g.Open ? "open" : Format.UtcClock(g.To))</span>
                </div>
            }

            foreach (var n in never)
            {
                <div class="v2-gap">
                    <span class="v2-gap-what">@n.Who</span>
                    <span class="v2-gap-state v2-gap-state--never">never</span>
                    <span class="v2-gap-why">Not collected from this venue</span>
                    <span class="v2-gap-when">—</span>
                </div>
            }
        }
    </div>

    @* ── что ещё есть у этого актива ───────────────────────────────────────────
       Перепись наборов и того, куда за каждым идти. Цифр здесь нет намеренно: на «сколько
       лежит» отвечает сетка покрытия двумя строками выше, и два разных числа про одно на одном
       экране всегда читаются как ошибка. *@
    @{
        // Копия эталона дословно: это перепись наборов, а не отчёт о том, сколько чего лежит
        // сегодня — цифры отсюда убраны, потому что на них уже отвечает сетка покрытия двумя
        // полосами выше, и две разные цифры про одно на одном экране всегда читаются как ошибка.
        var reach = new (string Name, string What, string Where, string Href, string? Cut)[]
        {
            ("Candles",
             "1m stored, 5 / 15 / 60 / 240 / 720 / 1440 derived · mark and index series kept apart",
             "The cut → Price", "#band-cuts", "price"),

            ("Funding history",
             "every payment, per venue interval, normalised on read",
             "The cut → Funding", "#band-cuts", "funding"),

            ("Level book",
             "25 levels a side, top of book kept at full rate",
             "Band 2, or the book endpoint", "#band-now", null),

            ("Trades",
             "every fill with taker side, venue id and venue clock",
             "Band 4, or a day file", "#band-tape", null),

            ("Liquidations",
             "events whole, plus five-minute buckets and the side ratio",
             "The cut → Liquidations", "#band-cuts", "liquidations"),

            ("Coverage & gaps",
             "what we hold, where it broke and why",
             "Band 5", "#band-trust", null),
        };
    }
    <div class="v2-reach">
        <span class="csx-eyebrow">Everything else this asset has</span>
        @foreach (var e in reach)
        {
            <div class="v2-reach-row">
                <span class="v2-reach-name">@e.Name</span>
                <span class="v2-reach-what">@e.What</span>
                <span class="v2-reach-where"><a href="@e.Href" data-goto-cut="@e.Cut">@e.Where</a></span>
            </div>
        }
    </div>
</section>

</div>

<footer class="v2-foot">
    <span>Not investment advice · Own funds only</span>
    @*
        ОБЯЗАТЕЛЬСТВО ПО ЛИЦЕНЗИИ, а не любезность. У этой страницы Layout = null, подвал общий
        она не наследует, и без этой строки страница со свечами вышла бы без ссылки, которой
        требует документация TradingView к attributionLogo: уведомление в коде И ссылка на
        https://www.tradingview.com/ на странице, доступной пользователю. NOTICE рядом с
        вендоренным файлом закрывает пункт 4(d) Apache 2.0 сам по себе; эта строка закрывает второе.
    *@
    <span>Candles by <a href="https://www.tradingview.com/" rel="noopener">TradingView</a> Lightweight&nbsp;Charts™</span>
    <span class="v2-foot-right">blynai.eu · MB „BlynAI“</span>
</footer>

@* Библиотека грузится только если есть что рисовать: 198 КБ на странице без свечей — это
   198 КБ, потраченных, чтобы не нарисовать ничего. *@
@if (V2Band3.Drawable(Model).Count > 0)
{
    <script src="~/vendor/lightweight-charts/lightweight-charts-5.2.1.standalone.production.js?v=1"></script>
    <script src="~/studio-candles.js?v=8"></script>
}
<script src="~/studio-ages.js?v=7"></script>
<script src="~/studio-live.js?v=3"></script>
<script src="~/studio-v2.js?v=23"></script>
<script src="~/studio-disclose.js?v=2"></script>
<script src="~/studio-v2-band3.js?v=2"></script>
</body>
</html>
