@using CryptoSmithX.WebApp.Studio.Data
@model PairPageModel
@{
    // Same reason as _V2Band3Head: one template for the first paint and the AJAX swap.
    var drawable = V2Band3.Drawable(Model);
    var priceScale = V2Band3.PriceScale(Model);
}
@if (drawable.Count == 0)
{
    <p class="v2-empty">No venue here has two closed bars yet.
        @if (Model.Band3Series != "trade")
        {
            @:Only Binance publishes mark and index candles — every other venue's @Model.Band3Series
            @:series is empty by construction, not thin.
        }
    </p>
}
else
{
    foreach (var r in drawable)
    {
        var bars = V2Band3.Of(Model, r);
        var json = System.Text.Json.JsonSerializer.Serialize(
            bars.Windows.Select((w, i) => new
            {
                time = new DateTimeOffset(DateTime.SpecifyKind(w, DateTimeKind.Utc)).ToUnixTimeSeconds(),
                o = bars.Bars[i]?.Open,
                h = bars.Bars[i]?.High,
                l = bars.Bars[i]?.Low,
                c = bars.Bars[i]?.Close
            }));
        var sc = priceScale[r.Row.QuoteAsset];
        var last = bars.Bars.LastOrDefault(b => b is not null);
        var pd = Format.Decimals(r.Row.PriceStep, fallback: 4);
        // B3: source/updated_at, in the tooltip on the one bar this line already names — the last
        // CLOSED one — rather than on the axis (plan's own instruction: per-bar hover would need
        // the chart library's own crosshair wiring, which this pass does not add).
        var lastTitle = last is null ? null
            : $"source: {last.Source ?? "—"} · updated_at: {Format.Utc(last.UpdatedAt)}";

        // P0-2 (UX audit): how old the newest bar actually is, against the SAME instant the rest
        // of the page's ages are measured from (Model.RenderedAt) — never DateTime.UtcNow here,
        // for the reason every other age on this page gives (blueprint §5): a row served from a
        // cached payload must still report a truthful age, and that is only true if every age on
        // the render is a subtraction against the one instant the render was built at.
        var lastAgeSeconds = last is null ? (double?)null
            : (Model.RenderedAt - new DateTimeOffset(DateTime.SpecifyKind(last.OpenTime, DateTimeKind.Utc))).TotalSeconds;
        var intervalSeconds = bars.Timeframe * 60;
        // Twice the bar's own interval, not a flat "2 hours": a 1-minute panel is stale at 2
        // minutes behind and an hourly one is not stale until 2 hours behind, on the same page,
        // now that B3's own timeframe selector can show either.
        var stale = lastAgeSeconds is { } age && age > 2 * intervalSeconds;

        // P0-2: the share of the panel's own axis that holds no bar at all — hatched rather than
        // left blank, because blank paper on this page must never mean "no data" (rule 3). The
        // common shape of a gap here is thin history at the OLD end (backfill has not reached
        // that far yet), so it hatches from the axis's start up to the first bar actually held —
        // not every scattered gap individually.
        //
        // Ширина этой штриховки БОЛЬШЕ НЕ СЧИТАЕТСЯ ЗДЕСЬ. Отсюда она выходила долей ширины
        // карточки, а ось графика устроена не так: у панели, где первый бар восьмой, штриховка
        // не доходила до него, а где шестнадцатый — заезжала под свечу и говорила про неё «бара
        // нет». Единственная система координат, в которой это можно посчитать верно, — ось самой
        // библиотеки, поэтому считает studio-candles.js, из тех же rows, что он рисует.
        <div class="v2-cut@(stale ? " v2-cut--stale" : "")">
            @* Площадка дисплейным начертанием, символ — акцентным моно, и OHLC последнего
               закрытого часа справа: график отвечает на «как шло», а на «чем кончилось»
               по пикселям не отвечает никто. *@
            <span class="v2-cut-plat">
                <b>@r.Row.ExchangeName</b> <em>@r.Row.Symbol</em>
                @if (last is not null)
                {
                    <span class="v2-ohlc" title="@lastTitle">O @Format.Num(last.Open, pd) H @Format.Num(last.High, pd)
                        L @Format.Num(last.Low, pd) C @Format.Num(last.Close, pd)</span>
                }
                @* B3: bars the rollup only partly covered — meaningless at 1m (bar_count is
                   always 1 there), so CandleSeries.Partial already reads zero and this stays
                   silent rather than printing "0 partly covered" on every panel. *@
                @if (bars.Partial > 0)
                {
                    <span class="v2-cut-partial">@bars.Partial of @bars.Windows.Count partly covered</span>
                }
            </span>
            @* P0-2: the newest bar's own instant, named — a candle panel used to show HOW price
               moved and stay silent about WHEN, so a card could sit a day behind its neighbours
               with nothing on it to say so. Magenta (v2-cut--stale, above) once the newest bar is
               more than two of its own intervals old. *@
            <span class="v2-cut-age">
                @if (last is null)
                {
                    @:No closed bar yet.
                }
                else
                {
                    @:last bar @Format.UtcDayMonthClock(last.OpenTime) · @Format.SpacedAge(lastAgeSeconds) ago
                    @:· @bars.Present of @bars.Windows.Count bars held
                }
            </span>
            <div class="a-chart v2-chart" data-held="@bars.Present" data-total="@bars.Windows.Count"
                 data-candles="@json"
                 data-scale-lo="@sc.Lo.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                 data-scale-hi="@sc.Hi.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                 data-decimals="@Format.Decimals(r.Row.PriceStep, fallback: 4)"></div>
        </div>
    }
}
