@using CryptoSmithX.WebApp.Studio.Data
@model PairPageModel
@{
    // Партиал, а не кусок страницы, потому что ЭТО и есть то, что пересылает живой поток: одна
    // разметка на первую отрисовку и на каждое обновление. Второй экземпляр той же таблицы —
    // ровно тот способ, которым страница начинает расходиться сама с собой через месяц.

    // Prompt 2.1, W-1: LAST TRADE stays out of the grid while every row is "—" — computed here,
    // from the same rows array every render already has, rather than a track this table always
    // pays for on the one column that is usually empty by construction (Hyperliquid's last_price
    // is the book's own mid, never a trade).
    var lastTradeHasData = Model.Rows.Any(r => r.Row.LastTradeAt is not null);
}
@* ── полоса 1: таблица ─────────────────────────────────────────────────────── *@
<section class="v2-band" id="band-table" data-live-region="table">
    <div class="v2-band-head">
        <span class="csx-eyebrow v2-band-no">1 · Every figure</span>
        @* Prompt 2, U-10: "a group opens in place" named a disclosure mechanism this band no
           longer has — every field has been its own column, no group to open, since the
           collapsed-group design was retired. *@
        <span class="csx-eyebrow v2-band-sub">Seven questions, not seven calls ·
            sizes and open interest in base units through the venue’s own multiplier</span>
    </div>

    @* Таблица шире экрана и прокручивается ВНУТРИ СЕБЯ: страница по горизонтали не едет. *@
    <div class="v2-scroll">
    <div class="v2-grid" style="--tracks:@V2Columns.Tracks(lastTradeHasData)">
        @* ── ПОЛОСЫ ВЫЗОВОВ ──────────────────────────────────────────────────────
           Одна на вызов, шириной в его колонки. Три источника отвечают с разной частотой и
           ломаются порознь, и какой из них стоит за цифрой — первое, что про неё нужно знать.
           Полосу можно провести только над ПОДРЯД идущими колонками, поэтому колонки и стоят
           по вызовам; семь вопросов никуда не делись — по ним поля выбраны, и они же написаны
           единицами под заголовками. *@
        <div class="v2-calls">
            <span></span>
            @foreach (var b in V2Columns.Bands(lastTradeHasData))
            {
                <span class="v2-call" data-tone="@b.Call.ToString().ToLowerInvariant()"
                      style="grid-column:span @b.Span">@b.Label</span>
            }
        </div>

        <div class="v2-hrow">
            <span class="v2-hcell v2-hcell--listing">Listing</span>
            @foreach (var c in V2Columns.Visible(lastTradeHasData))
            {
                <span class="v2-hcell" data-tone="@c.Call.ToString().ToLowerInvariant()"
                      data-cut="@c.Cut" data-col="@c.Field">
                    @{
                        // Prompt 2, U-6: the label wraps after the noun ("SPREAD" over "BPS"),
                        // never wherever the browser happens to break the line — one text node,
                        // one <br>, wrapped in its own span so the break works normally inside a
                        // flex container (.v2-hname is display:inline-flex; a <br> as a direct
                        // flex child is not a line break at all).
                        var fullLabel = c.LabelBreak is null ? c.Label : c.Label + " " + c.LabelBreak;
                    }
                    @if (c.Cut is null)
                    {
                        <span class="v2-hname">
                            <span class="v2-hname-text">@c.Label@if (c.LabelBreak is not null) { <br /> @c.LabelBreak }</span>
                        </span>
                    }
                    else
                    {
                        @* Заголовок, у которого есть история, — кнопка: он уводит полосы 2 и 3 на
                           это поле. Таблица по нему не сортирует (studio-v2.js's own sort() has no
                           live selector to reach any more — Prompt 2, U-6), поэтому заголовок
                           этого больше не обещает: ни стрелки, ни слова "sort by it" в title. *@
                        <button type="button" class="v2-hname v2-hname--cut" data-goto-cut="@c.Cut"
                                aria-pressed="@(c.Cut == "price" ? "true" : "false")"
                                title="Show @fullLabel now and over time">
                            <span class="v2-hname-text">@c.Label@if (c.LabelBreak is not null) { <br /> @c.LabelBreak }</span>
                        </button>
                    }
                </span>
            }
        </div>

        @foreach (var r in Model.Rows)
        {
            Model.Stress.TryGetValue(r.Row.InstrumentId, out var stress);

            var sorts = string.Join(" ", V2Cuts.All.Select(c =>
                $"data-sort-{c.Key}=\"{V2Cuts.Now(r, c, stress)?.ToString("R", System.Globalization.CultureInfo.InvariantCulture)}\""));

            Model.Books.TryGetValue(r.Row.InstrumentId, out var book);
            var strip = StripModel.Build(r);

            @* Prompt D-2: the address a live slot is delivered to. The cell already carries its
               own data-group, so a slot is [data-instrument] + [data-group] + which half of a
               paired cell — no index into anything, which is the mechanism the rows have already
               come apart on once. *@
            <div class="v2-row" data-instrument="@r.Row.InstrumentId" @Html.Raw(sorts)>
                @* B2: the listing cell opens the instrument's identity/limits/status/spec — the
                   same on-click-once-then-toggle mechanism A1–A4 use (studio-disclose.js), which
                   this page now also loads. *@
                <span class="v2-listing a-venue" role="button" tabindex="0" aria-expanded="false"
                      data-disclose-url="@Url.Action("InstrumentDetail", "PairsV2", new { instrumentId = r.Row.InstrumentId })"
                      data-disclose-target="instrument-@r.Row.InstrumentId">
                    <span class="v2-plat">@r.Row.ExchangeName <em>@r.Row.SegmentKind</em></span>
                    <span class="v2-symbol">
                        @r.Row.Symbol
                        @* Prompt 2.1, W-1 / Prompt 3, N-3: "×1", not "1 : 1" — the MULTIPLIER
                           column is gone (folded here, its only home now), and ×1 reads as the
                           same fact in the same three characters every other multiplier uses. *@
                        <em>×@Format.Num(r.Row.ContractMultiplier, 0)</em>
                        @* Сказано СЛОВОМ, а не только вычтено из счётчика. Закрытая сессия и
                           умерший фид дают одну и ту же неподвижную цифру, и без подписи читатель
                           видит свежий возраст под ценой, которая не менялась с пятницы, — ровно
                           то недоразумение, ради которого колонка и заводилась. Пусто там, где
                           площадка флага не публикует: неизвестная сессия — не утверждение. *@
                        @if (Freshness.Closed(r.Row.MarketOpen))
                        {
                            <em class="v2-shut" title="The venue says this market is not trading right now. Its age is shown and not judged: nothing is due from a closed market.">shut</em>
                        }
                    </span>

                    @* Три вызова на ОДНОЙ рампе, каждый по своей доле СВОЕГО окна: цена ждёт 30 с,
                       свип 30–120 с, открытый интерес 300 с, поэтому три близких возраста
                       расходятся по полоске в три разных места. *@
                    <span class="v2-strip a-strip">
                        @if (strip.Placed.Count > 0)
                        {
                            <i class="a-strip-span" style="left:@StripModel.Pct(strip.SpanFrom);width:@strip.SpanWidth"></i>
                            foreach (var call in strip.Placed)
                            {
                                <i class="a-strip-tick@(call.Position >= 1 ? " a-strip-tick--spent" : "")"
                                   style="left:@StripModel.Pct(call.Position)"
                                   data-at="@call.InstantMs"
                                   data-win="@call.WindowSeconds?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                   title="@call.Label"></i>
                            }
                        }
                    </span>

                    @* P0-4 (UX audit): the fresh/old summary line is gone — it said one call's age
                       TWICE (once here, once again below in the full three-call line), and the
                       △ on it duplicated the strip's own tick and the full line's own magenta.
                       The strip places the three calls; the line below names all three, and the
                       late one is already magenta there (.v2-ages .a-spent, unchanged). *@
                    <span class="v2-ages a-strip-calls">
                        @foreach (var call in strip.Calls)
                        {
                            <span class="@(call.PastWindow ? "a-spent" : "")"
                                  data-label="@call.Label"
                                  data-at="@call.InstantMs"
                                  data-win="@call.WindowSeconds?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                  data-cadence="@call.CadenceSeconds?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                  ><span class="a-lab">@call.Label</span> <span class="a-tok">@Format.SpacedAge(call.AgeSeconds)</span></span>
                        }
                    </span>
                </span>

                @foreach (var c in V2Columns.Visible(lastTradeHasData))
                {
                    var cell = V2Cells.Field(r, c.Field, stress, book);
                    var column = V2Ranks.ColumnOf(c.Field);
                    var rank = column is { } rc ? Model.Verdicts.Of(r.Row.InstrumentId, rc) : Verdict.None;
                    var mark = rank == Verdict.None ? null : V2Ranks.ClassWord(c.Field, rank);
                    // Prompt 1.5: the mark's title names the population its rank was computed
                    // in — inside this listing's own quote asset for a per-quote column, across
                    // every listing on the page for a WholePair one — so a chip never leaves the
                    // reader to guess what it won against.
                    var quoteRule = mark is not null && V2Ranks.IsQuoteScoped(c.Field);
                    var markText = rank == Verdict.None ? null : V2Ranks.Mark(c.Field, rank);
                    var markTitle = rank == Verdict.None ? null : V2Ranks.Title(c.Field, rank, quoteRule, r.Row.QuoteAsset);
                    // Prompt 2, U-4: a sparkline under eight points is two or three dots joined by
                    // a guess, not a shape — the slot stays empty rather than draw a line the
                    // reader would read as trend from noise.
                    var series = V2Columns.Series(r, c);
                    var spark = c.Spark && series.Count(v => v is not null) >= 8
                        ? Format.SparkPath(series, 60, 14)
                        : null;
                    var age = V2Columns.Freshness(r, c);

                    // B1: a paired column (bid/ask, bid size/ask size) carries a second field's
                    // cell and rank — computed exactly as it would be for a column of its own,
                    // because it still is one, only sharing a cell rather than a track.
                    var pairCell = V2Cell.None;
                    string? pairMark = null;
                    string? pairMarkText = null;
                    string? pairMarkTitle = null;
                    string? pairTone = null;
                    if (c.PairedField is { } pf)
                    {
                        pairCell = V2Cells.Field(r, pf, stress, book);
                        var pairColumn = V2Ranks.ColumnOf(pf);
                        var pairRank = pairColumn is { } prc ? Model.Verdicts.Of(r.Row.InstrumentId, prc) : Verdict.None;
                        pairMark = pairRank == Verdict.None ? null : V2Ranks.ClassWord(pf, pairRank);
                        var pairQuoteRuleInner = pairMark is not null && V2Ranks.IsQuoteScoped(pf);
                        pairMarkText = pairRank == Verdict.None ? null : V2Ranks.Mark(pf, pairRank);
                        pairMarkTitle = pairRank == Verdict.None ? null : V2Ranks.Title(pf, pairRank, pairQuoteRuleInner, r.Row.QuoteAsset);
                        pairTone = pairRank == Verdict.None ? null : V2Ranks.ToneWord(pairRank);
                    }

                    // P0-4: one predicate — Freshness.PastWindow, the same one the age text below
                    // already uses for its own magenta (.v2-cellage--late) — now also marks the
                    // cell itself, so the H1 count, this rule and the age's own colour can never
                    // read as three different opinions about whether the same call is late.
                    // A market the venue says is shut is not a late one: nothing is due from it,
                    // and by Monday a perfectly healthy venue with sessions would otherwise be the
                    // reddest thing on the page. The age is still shown — the reader is owed the
                    // number — it is simply not judged.
                    var late = Freshness.PastWindow(age.Age, age.Window, age.Cadence, r.Row.MarketOpen);

                    @* Prompt D-2: the source is on the CELL, never on the page. A feed only
                       starts where the exchange has a ws_url, so live is always partial — a
                       page-wide flag would silently mix a two-second figure with a ten-second one.
                       Latest until a socket says otherwise, which is also what a venue with no
                       socket keeps saying in live mode. *@
                    <span class="v2-cell@(late ? " v2-cell--late" : "")" data-group="@c.Field" data-tone="@c.Call.ToString().ToLowerInvariant()"
                          data-src="latest" data-label="@c.Label">
                        @* Марка и число — один блок с одной заливкой под обоими; слово стоит мелко
                           у головы числа. Число держит свой цвет: покрасить измерение в цвет
                           суждения о нём значит сказать, что это другая величина. *@
                        @if (c.PairedField is null)
                        {
                            <span class="v2-fig @(cell.Value is null ? "v2-fig--none" : "")">
                                <span class="v2-part @(mark is null ? "" : "v2-part--" + mark + " v2-part--" + V2Ranks.ToneWord(rank))">
                                    @if (markText is not null) { <i title="@markTitle">@markText</i> }
                                    <span>@cell.Text</span>
                                </span>
                            </span>
                            @if (cell.Sub is not null)
                            {
                                <span class="v2-figsub">@cell.Sub</span>
                            }
                            @* Prompt 2.1, W-3: DEPTH 25BPS's own second sub-line — the two folded
                               bands. Two sub-lines max on this page; nothing emits a third. *@
                            @if (cell.Sub2 is not null)
                            {
                                <span class="v2-figsub">@cell.Sub2</span>
                            }
                        }
                        else
                        {
                            @* Bid top-left, ask bottom-right — the same "one cell, two mirrored
                               figures" the depth stripes already use, only stacked instead of
                               side by side: each still carries its OWN rank, and one venue can
                               hold the best bid and the worst ask at once. *@
                            <span class="v2-fig v2-fig--pair">
                                <span class="v2-part @(mark is null ? "" : "v2-part--" + mark + " v2-part--" + V2Ranks.ToneWord(rank)) @(cell.Value is null ? "v2-fig--none" : "")">
                                    @if (markText is not null) { <i title="@markTitle">@markText</i> }
                                    <span>@cell.Text</span>
                                </span>
                                <span class="v2-part @(pairMark is null ? "" : "v2-part--" + pairMark + " v2-part--" + pairTone) @(pairCell.Value is null ? "v2-fig--none" : "")">
                                    @if (pairMarkText is not null) { <i title="@pairMarkTitle">@pairMarkText</i> }
                                    <span>@pairCell.Text</span>
                                </span>
                            </span>
                        }
                        @if (spark is not null)
                        {
                            @* Prompt 2, U-4: 56×12, one weight, one ink — --text-faint for the
                               line whichever call wrote the column, a 2px dot in --text-heading
                               marking the current value, no fill. The call's own colour still
                               names the column via the band and the header rule; the sparkline's
                               job is only shape. *@
                            var dot = Format.SparkLastPoint(series, 56, 12);
                            <svg class="v2-spark" viewBox="0 0 56 12" preserveAspectRatio="none" aria-hidden="true">
                                <path d="@spark" fill="none" stroke="currentColor" stroke-width="1"
                                      vector-effect="non-scaling-stroke" />
                                @if (dot is { } d)
                                {
                                    <circle cx="@d.X.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                            cy="@d.Y.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                            r="1" fill="var(--text-heading)" stroke="none" />
                                }
                            </svg>
                        }
                        @* Prompt 2, U-3: the age line is gone except where it is the one thing
                           worth saying — a call past its own window. A fresh call's age is
                           already the strip in the listing cell; repeating it, in the same faint
                           ink, on every one of twenty cells a row was the line this removes. The
                           slot stays reserved (same height late or not) so a row never grows the
                           moment one cell in it goes stale. *@
                        @* Prompt D-2: TWO ages, and both spans are in the DOM in both modes.
                           The live one is the venue's own observation, the written one is what a
                           backtest will see — and the second is the one that must never be hidden
                           to make the page look faster than it is.

                           Reserved rather than added when live: switching modes must not move a
                           row. This table already cost a CLS of 0.12 on ages that merely ticked,
                           and that was without anything appearing. In Latest the live half is a
                           dash, which is this page's word for "not measured" everywhere else. *@
                        <span class="v2-cellage @(late ? "v2-cellage--late" : "")">
                            <span data-age-live>@Format.Dash</span><span data-age-written>@(late ? Format.SpacedAge(age.Age) + " ago" : "")</span>
                        </span>
                    </span>
                }
            </div>
            <div class="v2-disclose" id="instrument-@r.Row.InstrumentId" hidden></div>
        }
    </div>
    </div>

    @* P0-1 / P0-5 (UX audit): this paragraph replaces the old one, which claimed a bar REPLACES the
       BEST chip — false; both exist, on different columns, for different reasons. The sentence
       this file needs to keep true from here on is the one below, not the one that used to be
       here.
       Prompt 1.5: BEST/WORST retired the same way TIGHT/WIDE did — MAX and MIN state the fact
       (which figure is the population's own extreme) rather than a recommendation, which is what
       BEST always risked reading as on a page that takes no side in the trade. *@
    <p class="v2-legend">
        MAX and MIN mark the highest and lowest figure — inside a quote for prices and turnover,
        across every listing for bps and base units. They state a fact, not a recommendation.
        <b>—</b> is not measured and never a zero. A late call is a magenta rule on its cells, one
        clock per call in the listing cell.
    </p>
</section>
