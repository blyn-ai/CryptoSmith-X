@using CryptoSmithX.WebApp.Studio.Data
@model PairPageModel
@{
    // Партиал, а не кусок страницы, потому что ЭТО и есть то, что пересылает живой поток: одна
    // разметка на первую отрисовку и на каждое обновление. Второй экземпляр той же таблицы —
    // ровно тот способ, которым страница начинает расходиться сама с собой через месяц.
    var groups = V2Groups.All;
}
@* ── полоса 1: таблица ─────────────────────────────────────────────────────── *@
<section class="v2-band" id="band-table" data-live-region="table">
    <div class="v2-band-head">
        <span class="csx-eyebrow v2-band-no">1 · Every figure</span>
        <span class="csx-eyebrow v2-band-sub">Seven questions, not seven calls · a group opens in place ·
            sizes and open interest in base units through the venue’s own multiplier</span>
    </div>

    <div class="v2-grid" style="--cols:@(groups.Count)">
        <div class="v2-hrow">
            <span class="v2-hcell v2-hcell--listing">Listing</span>
            @foreach (var g in groups)
            {
                @* ДВА действия — две кнопки. У дизайнера каретка меняет срез, а раскрытие одно
                   на всю таблицу; здесь раскрытие ещё и по группам, и вешать оба смысла на
                   один клик значило бы, что предсказать, что случится, нельзя. Имя раскрывает
                   группу на месте, каретка уводит полосы 2 и 3 на это поле. *@
                <span class="v2-hcell" data-group="@g.Key" data-tone="@g.Tone.ToString().ToLowerInvariant()">
                    <span class="v2-hrow">
                        <button type="button" class="v2-gtoggle" data-group="@g.Key" aria-expanded="false">@g.Name</button>
                        @if (g.Cut is not null)
                        {
                            <button type="button" class="v2-caret" data-goto-cut="@g.Cut"
                                    aria-pressed="@(g.Cut == "price" ? "true" : "false")"
                                    title="Show this field now and over time, across every listing">↓</button>
                        }
                    </span>
                    <span class="v2-hunit">@g.Unit</span>
                </span>
            }
        </div>

        @foreach (var r in Model.Rows)
        {
            <div class="v2-row">
                @{ var strip = StripModel.Build(r); }
                @* a-venue / a-strip — ХУКИ ПЕРВОЙ СТРАНИЦЫ, а не её оформление: возрасты на обеих
                   двигает один studio-ages.js, и второй экземпляр этих часов был бы вторым местом,
                   где правило 2 однажды разойдётся с Freshness.cs. Оформление своё, из v2-*. *@
                <span class="v2-listing a-venue">
                    <span class="v2-plat">@r.Row.ExchangeName <em>@r.Row.SegmentKind</em></span>
                    <span class="v2-symbol">
                        @r.Row.Symbol
                        <em>@(r.Row.ContractMultiplier == 1 ? "1 : 1" : "× " + Format.Num(r.Row.ContractMultiplier, 0))</em>
                    </span>

                    @* Три вызова стоят на ОДНОЙ рампе, каждый по своей доле СВОЕГО окна: цена
                       ждёт 30 с, свип 30–120 с, открытый интерес 300 с. Поэтому три близких
                       возраста расходятся по полоске в три разных места — в этом её смысл, а
                       прозой «Price 4s · Depth 2m · OI 3m» его не было вовсе. *@
                    <span class="v2-strip a-strip">
                        @if (strip.Placed.Count > 0)
                        {
                            <i class="a-strip-span" style="left:@StripModel.Pct(strip.SpanFrom);width:@strip.SpanWidth"></i>
                            foreach (var call in strip.Placed)
                            {
                                <i class="a-strip-tick@(call.Position >= 1 ? " a-strip-tick--spent" : "")"
                                   style="left:@StripModel.Pct(call.Position)"
                                   data-at="@call.InstantMs"
                                   data-win="@call.WindowSeconds?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                   title="@call.Label"></i>
                            }
                        }
                    </span>

                    @* Концы НАЗЫВАЮТ вызов, стоящий на каждом конце рампы, — выбранный по его
                       доле своего окна, той же арифметикой, что расставила метки. Слот под △
                       занят всегда и пуст, пока сказать нечего: иначе знак въезжал бы в строку
                       и толкал слова влево на своём кегле. *@
                    <span class="v2-strip-ends a-strip-ends">
                        <span data-fresh title="@StripModel.EndTitle(strip.LeastSpent, StripModel.LeastSpentLabel)"><span class="a-lab">@(strip.Degraded ? "" : StripModel.EndLabel(strip.LeastSpent))</span> <span class="a-tok">@(strip.Degraded ? "" : StripModel.EndToken(strip.LeastSpent))</span></span>
                        <span data-old class="@(strip.MostSpentPastWindow ? "a-spent" : "")"
                              title="@StripModel.EndTitle(strip.MostSpent, StripModel.MostSpentLabel)"><i class="a-tri">@(strip.MostSpentPastWindow ? Format.PastWindowMark : "")</i><span class="a-lab">@(strip.Degraded ? StripModel.DegradedText : StripModel.EndLabel(strip.MostSpent))</span> <span class="a-tok">@(strip.Degraded ? "" : StripModel.EndToken(strip.MostSpent))</span></span>
                    </span>

                    <span class="v2-ages a-strip-calls">
                        @foreach (var call in strip.Calls)
                        {
                            <span class="@(call.PastWindow ? "a-spent" : "")"
                                  data-label="@call.Label"
                                  data-at="@call.InstantMs"
                                  data-win="@call.WindowSeconds?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                  ><span class="a-lab">@call.Label</span> <span class="a-tok">@Format.ShortAge(call.AgeSeconds)</span></span>
                        }
                    </span>
                </span>

                @foreach (var g in groups)
                {
                    Model.Stress.TryGetValue(r.Row.InstrumentId, out var stress);
                    var head = g.Headline is { } col ? V2Cells.Headline(r, col) : V2Cells.Headline(r, g, stress);
                    <span class="v2-cell" data-group="@g.Key" data-label="@g.Name" data-unit="@g.Unit">
                        <span class="v2-fig @(head.Value is null ? "v2-fig--none" : "")">@head.Text</span>
                        @if (head.Sub is not null)
                        {
                            <span class="v2-figsub">@head.Sub</span>
                        }
                        @if (g.Headline is { } bc && head.Value is not null)
                        {
                            <span class="v2-bar" data-tone="@g.Tone.ToString().ToLowerInvariant()">
                                <i style="width:@Format.BarWidth(head.Value, Model.Scales.Of(r.Row.InstrumentId, bc))"></i>
                            </span>
                        }

                        @* Спарклайн — история ТОГО ЖЕ числа, что стоит крупно, за те же двадцать
                           четыре часа, что рисует полоса 3. Он здесь потому, что свёрнутая
                           таблица — единственное место на странице, где направление видно у всех
                           площадок сразу: полоса 3 отвечает на «как пришло вот это одно поле» и
                           больше одного поля показать не может.

                           У двух групп из семи истории нет вовсе — оборот за скользящие сутки это
                           одно число, а возраст меряется от «сейчас», — и там остаётся лог-бар
                           (правило 11). Пустой рамки вместо линии не рисуем. *@
                        @{ var spark = Format.SparkPath(V2Groups.Spark(r, g), 120, 22); }
                        @if (spark is not null)
                        {
                            <svg class="v2-spark" data-tone="@g.Tone.ToString().ToLowerInvariant()"
                                 viewBox="0 0 120 22" preserveAspectRatio="none" aria-hidden="true">
                                <path d="@spark" fill="none" stroke="currentColor" stroke-width="1"
                                      vector-effect="non-scaling-stroke" />
                            </svg>
                        }

                        <span class="v2-fields" hidden>
                            @foreach (var f in g.Fields)
                            {
                                var cell = V2Cells.Field(r, f.Field, stress);

                                @* РАНГ НА КАЖДОЙ ЦИФРЕ, а не на группе. Verdicts считает его давно
                                   и по каждой колонке отдельно; до сих пор на второй странице он
                                   не показывался нигде, то есть «как эта цифра стоит у семи
                                   площадок» страница считала и молчала.

                                   Заливка ложится на подпись И значение целиком, а не чипом рядом:
                                   чип — ещё один элемент в строке из двух, а заливка это та же
                                   строка, только помеченная. Оба конца или ни одного — один BEST
                                   без WORST не сравнение, а похвала. *@
                                var column = V2Ranks.ColumnOf(f.Field);
                                var rank = column is { } rc ? Model.Verdicts.Of(r.Row.InstrumentId, rc) : Verdict.None;
                                <span class="v2-field @(rank == Verdict.None ? "" : "v2-field--" + V2Ranks.Word(f.Field, rank))"
                                      title="@(rank == Verdict.None ? null : V2Ranks.Word(f.Field, rank).ToUpperInvariant() + " of the listings this figure can be compared against")">
                                    <em>@f.Label</em><b class="@(cell.Value is null ? "v2-fig--none" : "")">@cell.Text</b>
                                </span>
                            }
                        </span>
                    </span>
                }
            </div>
        }
    </div>

    <p class="v2-legend">
        A bar is the figure against the largest listing in the same unit, log-scaled — it replaces the
        BEST chip, which could not tell a book a hundred times larger from one a hair larger.
        <b>—</b> is not measured and never a zero. Ages live in the listing cell, one clock per call,
        because a figure’s age is a fact about the call that wrote it and not about the cell.
    </p>
</section>
