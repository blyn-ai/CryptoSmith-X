@using CryptoSmithX.WebApp.Studio.Data
@model PairPageModel
@{
    // Партиал, а не кусок страницы, потому что ЭТО и есть то, что пересылает живой поток: одна
    // разметка на первую отрисовку и на каждое обновление. Второй экземпляр той же таблицы —
    // ровно тот способ, которым страница начинает расходиться сама с собой через месяц.
}
@* ── полоса 1: таблица ─────────────────────────────────────────────────────── *@
<section class="v2-band" id="band-table" data-live-region="table">
    <div class="v2-band-head">
        <span class="csx-eyebrow v2-band-no">1 · Every figure</span>
        <span class="csx-eyebrow v2-band-sub">Seven questions, not seven calls · a group opens in place ·
            sizes and open interest in base units through the venue’s own multiplier</span>
    </div>

    @* Таблица шире экрана и прокручивается ВНУТРИ СЕБЯ: страница по горизонтали не едет. *@
    <div class="v2-scroll">
    <div class="v2-grid" style="--tracks:@V2Columns.Tracks">
        @* ── ПОЛОСЫ ВЫЗОВОВ ──────────────────────────────────────────────────────
           Одна на вызов, шириной в его колонки. Три источника отвечают с разной частотой и
           ломаются порознь, и какой из них стоит за цифрой — первое, что про неё нужно знать.
           Полосу можно провести только над ПОДРЯД идущими колонками, поэтому колонки и стоят
           по вызовам; семь вопросов никуда не делись — по ним поля выбраны, и они же написаны
           единицами под заголовками. *@
        <div class="v2-calls">
            <span></span>
            @foreach (var b in V2Columns.Bands)
            {
                <span class="v2-call" data-tone="@b.Call.ToString().ToLowerInvariant()"
                      style="grid-column:span @b.Span">@b.Label</span>
            }
        </div>

        <div class="v2-hrow">
            <span class="v2-hcell v2-hcell--listing">Listing</span>
            @foreach (var c in V2Columns.All)
            {
                <span class="v2-hcell" data-tone="@c.Call.ToString().ToLowerInvariant()"
                      data-cut="@c.Cut" data-col="@c.Field">
                    @if (c.Cut is null)
                    {
                        <span class="v2-hname">@c.Label</span>
                    }
                    else
                    {
                        @* Заголовок, у которого есть история, — кнопка: он уводит полосы 2 и 3 на
                           это поле и сортирует по нему таблицу. У остальных истории нет, и
                           кнопка обещала бы то, чего не будет. *@
                        <button type="button" class="v2-hname v2-hname--cut" data-goto-cut="@c.Cut"
                                aria-pressed="@(c.Cut == "price" ? "true" : "false")"
                                title="Show @c.Label now and over time, and sort by it">@c.Label<i>↓</i></button>
                    }
                </span>
            }
        </div>

        @foreach (var r in Model.Rows)
        {
            var sorts = string.Join(" ", V2Cuts.All.Select(c =>
                $"data-sort-{c.Key}=\"{V2Cuts.Now(r, c)?.ToString("R", System.Globalization.CultureInfo.InvariantCulture)}\""));

            Model.Stress.TryGetValue(r.Row.InstrumentId, out var stress);
            Model.Books.TryGetValue(r.Row.InstrumentId, out var book);
            var strip = StripModel.Build(r);

            <div class="v2-row" @Html.Raw(sorts)>
                @* B2: the listing cell opens the instrument's identity/limits/status/spec — the
                   same on-click-once-then-toggle mechanism A1–A4 use (studio-disclose.js), which
                   this page now also loads. *@
                @* P0-1: data-quote drives the 3px quote-group rule (studio-v2.css) — the same
                   attribute the chips below carry when their own rank was computed inside this
                   quote asset, so a reader can trace a BEST chip's colour back to the row it
                   belongs to. *@
                <span class="v2-listing a-venue" role="button" tabindex="0" aria-expanded="false"
                      data-quote="@r.Row.QuoteAsset"
                      data-disclose-url="@Url.Action("InstrumentDetail", "PairsV2", new { instrumentId = r.Row.InstrumentId })"
                      data-disclose-target="instrument-@r.Row.InstrumentId">
                    <span class="v2-plat">@r.Row.ExchangeName <em>@r.Row.SegmentKind</em></span>
                    <span class="v2-symbol">
                        @r.Row.Symbol
                        <em>@(r.Row.ContractMultiplier == 1 ? "1 : 1" : "× " + Format.Num(r.Row.ContractMultiplier, 0))</em>
                    </span>

                    @* Три вызова на ОДНОЙ рампе, каждый по своей доле СВОЕГО окна: цена ждёт 30 с,
                       свип 30–120 с, открытый интерес 300 с, поэтому три близких возраста
                       расходятся по полоске в три разных места. *@
                    <span class="v2-strip a-strip">
                        @if (strip.Placed.Count > 0)
                        {
                            <i class="a-strip-span" style="left:@StripModel.Pct(strip.SpanFrom);width:@strip.SpanWidth"></i>
                            foreach (var call in strip.Placed)
                            {
                                <i class="a-strip-tick@(call.Position >= 1 ? " a-strip-tick--spent" : "")"
                                   style="left:@StripModel.Pct(call.Position)"
                                   data-at="@call.InstantMs"
                                   data-win="@call.WindowSeconds?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                   title="@call.Label"></i>
                            }
                        }
                    </span>

                    @* P0-4 (UX audit): the fresh/old summary line is gone — it said one call's age
                       TWICE (once here, once again below in the full three-call line), and the
                       △ on it duplicated the strip's own tick and the full line's own magenta.
                       The strip places the three calls; the line below names all three, and the
                       late one is already magenta there (.v2-ages .a-spent, unchanged). *@
                    <span class="v2-ages a-strip-calls">
                        @foreach (var call in strip.Calls)
                        {
                            <span class="@(call.PastWindow ? "a-spent" : "")"
                                  data-label="@call.Label"
                                  data-at="@call.InstantMs"
                                  data-win="@call.WindowSeconds?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                  ><span class="a-lab">@call.Label</span> <span class="a-tok">@Format.SpacedAge(call.AgeSeconds)</span></span>
                        }
                    </span>
                </span>

                @foreach (var c in V2Columns.All)
                {
                    var cell = V2Cells.Field(r, c.Field, stress, book);
                    var column = V2Ranks.ColumnOf(c.Field);
                    var rank = column is { } rc ? Model.Verdicts.Of(r.Row.InstrumentId, rc) : Verdict.None;
                    var mark = rank == Verdict.None ? null : V2Ranks.Word(c.Field, rank);
                    // P0-1: only a chip whose rank was computed INSIDE this listing's quote asset
                    // gets the group rule — a WholePair chip (sizes, OI, spread, book reach) ranked
                    // across every quote on the page and the rule would misname the comparison.
                    var quoteRule = mark is not null && V2Ranks.IsQuoteScoped(c.Field);
                    var spark = c.Spark ? Format.SparkPath(V2Columns.Series(r, c), 60, 14) : null;
                    var age = V2Columns.Freshness(r, c);

                    // B1: a paired column (bid/ask, bid size/ask size) carries a second field's
                    // cell and rank — computed exactly as it would be for a column of its own,
                    // because it still is one, only sharing a cell rather than a track.
                    var pairCell = V2Cell.None;
                    string? pairMark = null;
                    if (c.PairedField is { } pf)
                    {
                        pairCell = V2Cells.Field(r, pf, stress, book);
                        var pairColumn = V2Ranks.ColumnOf(pf);
                        var pairRank = pairColumn is { } prc ? Model.Verdicts.Of(r.Row.InstrumentId, prc) : Verdict.None;
                        pairMark = pairRank == Verdict.None ? null : V2Ranks.Word(pf, pairRank);
                    }
                    var pairQuoteRule = pairMark is not null && c.PairedField is { } pf2 && V2Ranks.IsQuoteScoped(pf2);

                    // P0-4: one predicate — Freshness.PastWindow, the same one the age text below
                    // already uses for its own magenta (.v2-cellage--late) — now also marks the
                    // cell itself, so the H1 count, this rule and the age's own colour can never
                    // read as three different opinions about whether the same call is late.
                    var late = Freshness.PastWindow(age.Age, age.Window);

                    <span class="v2-cell@(late ? " v2-cell--late" : "")" data-group="@c.Field" data-tone="@c.Call.ToString().ToLowerInvariant()"
                          data-label="@c.Label">
                        @* Марка и число — один блок с одной заливкой под обоими; слово стоит мелко
                           у головы числа. Число держит свой цвет: покрасить измерение в цвет
                           суждения о нём значит сказать, что это другая величина. *@
                        @if (c.PairedField is null)
                        {
                            <span class="v2-fig @(cell.Value is null ? "v2-fig--none" : "")">
                                <span class="v2-part @(mark is null ? "" : "v2-part--" + mark)"
                                      data-quote="@(quoteRule ? r.Row.QuoteAsset : null)">
                                    @if (mark is not null) { <i>@mark</i> }
                                    <span>@cell.Text</span>
                                </span>
                            </span>
                            @if (cell.Sub is not null)
                            {
                                <span class="v2-figsub">@cell.Sub</span>
                            }
                        }
                        else
                        {
                            @* Bid top-left, ask bottom-right — the same "one cell, two mirrored
                               figures" the depth stripes already use, only stacked instead of
                               side by side: each still carries its OWN rank, and one venue can
                               hold the best bid and the worst ask at once. *@
                            <span class="v2-fig v2-fig--pair">
                                <span class="v2-part @(mark is null ? "" : "v2-part--" + mark) @(cell.Value is null ? "v2-fig--none" : "")"
                                      data-quote="@(quoteRule ? r.Row.QuoteAsset : null)">
                                    @if (mark is not null) { <i>@mark</i> }
                                    <span>@cell.Text</span>
                                </span>
                                <span class="v2-part @(pairMark is null ? "" : "v2-part--" + pairMark) @(pairCell.Value is null ? "v2-fig--none" : "")"
                                      data-quote="@(pairQuoteRule ? r.Row.QuoteAsset : null)">
                                    @if (pairMark is not null) { <i>@pairMark</i> }
                                    <span>@pairCell.Text</span>
                                </span>
                            </span>
                        }
                        @if (spark is not null)
                        {
                            <svg class="v2-spark" data-tone="@c.Call.ToString().ToLowerInvariant()"
                                 viewBox="0 0 60 14" preserveAspectRatio="none" aria-hidden="true">
                                <path d="@spark" fill="none" stroke="currentColor" stroke-width="1"
                                      vector-effect="non-scaling-stroke" />
                            </svg>
                        }
                        @* Возраст ВЫЗОВА, написавшего эту клетку, а не строки: свип четырёхминутной
                           давности под двухсекундной ценой — ровно та причина, по которой часы
                           здесь считаются по вызовам. *@
                        <span class="v2-cellage @(Freshness.PastWindow(age.Age, age.Window) ? "v2-cellage--late" : "")">@Format.SpacedAge(age.Age) ago</span>
                    </span>
                }
            </div>
            <div class="v2-disclose" id="instrument-@r.Row.InstrumentId" hidden></div>
        }
    </div>
    </div>

    @* P0-1 / P0-5 (UX audit): this paragraph replaces the old one, which claimed a bar REPLACES the
       BEST chip — false; both exist, on different columns, for different reasons. The sentence
       this file needs to keep true from here on is the one below, not the one that used to be
       here. *@
    <p class="v2-legend">
        Chips on prices and turnover rank inside a quote — the rule on the chip is the quote. Chips
        on bps and base units rank across every listing.
        <b>—</b> is not measured and never a zero. A late call is a magenta rule on its cells, one
        clock per call in the listing cell.
    </p>
</section>
