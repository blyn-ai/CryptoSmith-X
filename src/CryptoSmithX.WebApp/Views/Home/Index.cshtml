@{
    Layout = null;
    ViewData["Title"] = "CryptoSmith X";
    var failed = TempData["LoginFailed"] is true;
}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CryptoSmith X</title>
<meta name="description" content="CryptoSmith X — a perpetual futures trading bot by MB BlynAI. Closed testing.">
<meta property="og:title" content="CryptoSmith X">
<meta property="og:description" content="Fast markets guess and forget. Strategies decide and record. Every decision is replayable.">
<meta property="og:type" content="website">
<meta property="og:locale" content="en">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href="/ds/styles.css">
<link rel="stylesheet" href="/ui-mocks/assets/site.css">
</head>
<body>
<div class="shell">
  <div class="rule"></div>

  <div class="split">

    <!-- ─── знак и заголовок ─── -->
    <section class="pane pane--brand">
      <div class="brand">
        <img src="/ds/assets/cryptosmith-mark.svg" width="44" height="44" alt="">
        <div>
          <p class="wordmark">CryptoSmith <span>X</span></p>
          <p class="tagline"><span>Perps &amp; Crypto</span><span>Trade Bot</span></p>
        </div>
      </div>

      <div class="tags">
        <a class="tag tag--gold" href="/zurnalas">Closed testing</a>
        <a class="tag tag--violet" href="mailto:alfa@@blynai.eu?subject=Alfa%20%E2%80%94%20registracija">Alpha — soon</a>
      </div>

      <h1>Fast markets guess and forget.<br>
         <em>Strategies decide and record.</em></h1>

      <div class="prose">
        <p>Heuristics and algorithmic inference work together. CryptoSmith X starts with its own
           market data hub: every 10 seconds it reads perpetual markets across four exchanges —
           Kraken, Binance, WEEX and Hyperliquid — and the live count sits in the telemetry.
           Every pair is scored on dozens of parameters: EMA crossings, RSI, momentum, ATR
           volatility, the spread, volumes, order-book depth, funding, open interest and the
           market regime.</p>
        <p>All of it collapses into one score, and the score becomes a decision. Direction, size
           against the risk limits, stop-loss and targets — set automatically, with no hand on
           the wheel. Each bot is its own container against one exchange account: your keys,
           your data, your journal.</p>
        <p>Every decision is recorded — what it saw, which signals weighed, what the risk was,
           and what it turned down. Only what was knowable at that moment: no look-ahead, no
           missing data invented. Backtest, dry run and live trading execute the same code, so
           any record can be replayed.</p>
      </div>
    </section>

    <!-- ─── карточки ─── -->
    <section class="pane pane--data">
      <div class="cards">
        <div class="card">
          <div class="card__head">
            <span>Telemetry</span>
            <span class="live" id="live" hidden>Live</span>
          </div>
          <svg class="spark" id="spark" viewBox="0 0 300 74" preserveAspectRatio="none" aria-hidden="true" hidden>
            <defs>
              <linearGradient id="eqLine" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#F5B84F"/>
                <stop offset=".55" stop-color="#C98F63"/>
                <stop offset="1" stop-color="#6B4EDB"/>
              </linearGradient>
              <linearGradient id="eqFill" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="rgba(245,184,79,.16)"/>
                <stop offset="1" stop-color="rgba(107,78,219,.14)"/>
              </linearGradient>
            </defs>
            <path id="sparkFill" d="" fill="url(#eqFill)"/>
            <path id="sparkLine" d="" fill="none" stroke="url(#eqLine)" stroke-width="2"
                  stroke-linejoin="round" stroke-linecap="round"/>
          </svg>
          <div class="spark-empty" id="sparkEmpty">—</div>
          <div class="card__foot" id="stats">—</div>
        </div>

        <div class="card">
          <div class="card__head">
            <span>Positions</span>
            <span class="meta" id="posCount">—</span>
          </div>
          <div id="posList"><div class="pos-loading">—</div></div>
        </div>
      </div>

      <p class="venues">Kraken · Binance · WEEX · Hyperliquid</p>
    </section>

    <!-- ─── вход ─── -->
    <section class="auth">
      <p class="auth__label">Sign in</p>

      <form id="login" method="post" action="/Auth/Login" style="display:flex;flex-direction:column;gap:16px">
        @Html.AntiForgeryToken()
        <div class="field">
          <label for="username">User</label>
          <input id="username" name="username" type="text" autocomplete="username" autofocus placeholder="name">
        </div>
        <div class="field">
          <label for="pw">Password</label>
          <input id="pw" name="password" type="password" autocomplete="current-password" placeholder="••••••••">
        </div>

        <div class="row">
          <label class="check"><input type="checkbox" name="rememberMe" value="true" checked> Remember me</label>
          <a href="mailto:alfa@@blynai.eu?subject=Slapta%C5%BEodis">Forgot?</a>
        </div>

        <button class="btn" type="submit">Sign in</button>
        <p class="alert" id="loginError" @(failed ? "" : "hidden") role="alert">No such user. Access is currently limited to closed-testing participants.</p>
      </form>

      <p class="or">Or</p>

      <div class="socials">
        <button type="button" data-name="Google" aria-label="Google">
          <svg viewBox="0 0 24 24"><path d="M21.35 11.1H12v2.98h5.35c-.23 1.4-1.66 4.1-5.35 4.1-3.22 0-5.85-2.67-5.85-5.95S8.78 6.28 12 6.28c1.83 0 3.06.78 3.76 1.45l2.56-2.47C16.68 3.72 14.53 2.8 12 2.8 6.92 2.8 2.8 6.92 2.8 12s4.12 9.2 9.2 9.2c5.31 0 8.83-3.73 8.83-8.99 0-.6-.06-1.06-.15-1.51z"/></svg>
        </button>
        <button type="button" data-name="Apple" aria-label="Apple">
          <svg viewBox="0 0 24 24"><path d="M16.36 12.72c-.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.7-3.19-1.73-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.87-.76-1.48.02-2.84.86-3.6 2.18-1.53 2.66-.39 6.6 1.1 8.76.73 1.06 1.6 2.25 2.74 2.2 1.1-.04 1.52-.71 2.85-.71 1.33 0 1.71.71 2.87.69 1.19-.02 1.94-1.08 2.66-2.14.84-1.23 1.19-2.42 1.2-2.48-.03-.01-2.3-.88-2.3-3.5zM14.2 6.3c.6-.74 1.01-1.76.9-2.78-.87.04-1.93.58-2.56 1.31-.56.65-1.06 1.7-.93 2.7.97.08 1.97-.49 2.59-1.23z"/></svg>
        </button>
        <button type="button" data-name="GitHub" aria-label="GitHub">
          <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85 0 1.34-.01 2.42-.01 2.75 0 .27.18.58.69.48A10 10 0 0 0 22 12c0-5.52-4.48-10-10-10z"/></svg>
        </button>
        <button type="button" data-name="Facebook" aria-label="Facebook">
          <svg viewBox="0 0 24 24"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94z"/></svg>
        </button>
        <button type="button" data-name="X" aria-label="X">
          <svg viewBox="0 0 24 24"><path d="M17.53 3h3.02l-6.6 7.54L21.75 21h-5.9l-4.62-6.04L5.94 21H2.92l7.06-8.07L2.5 3h6.05l4.18 5.52L17.53 3z"/></svg>
        </button>
      </div>
      <p class="socials__msg" id="socialMsg" hidden aria-live="polite"></p>

      <p class="auth__note">
        Accounts are created by invitation only. Alpha sign-up —
        <a class="link-u" href="mailto:alfa@@blynai.eu">alfa@@blynai.eu</a>
      </p>
      <p class="auth__fine">Not investment advice · Own funds only</p>
    </section>
  </div>

  <footer>
    <p>MB BlynAI is not a financial institution, an investment manager or a provider of financial services.
       <button type="button" class="linkish" id="openLegal">Read more</button></p>
    <p class="copy">blynai.eu · © 2026 MB „BlynAI“</p>
  </footer>
</div>

<dialog class="modal" id="legal" aria-labelledby="legalTitle">
  <button class="modal__close" type="button" id="closeLegal" aria-label="Close">&times;</button>
  <div class="modal__in">
    <h2 id="legalTitle">MB BlynAI</h2>
    <p>MB BlynAI is not a financial institution, an investment manager or a provider of financial
       services. The company gives no investment advice, does not accept or hold third-party money
       or crypto assets, and does not operate third-party exchange accounts. It trades its own
       funds only; published results are research data, not an offer or a forecast.</p>

    <h3>Trading own funds</h3>
    <p>The software runs as two independent instances — LUKAS and BYKO. Same code, separate
       accounts, separate journals.</p>
    <ul>
      <li>only the company's and its members' funds are traded;</li>
      <li>each instance runs on its own exchange account with its own API keys;</li>
      <li>strategy, risk limits and parameters are set by the members themselves;</li>
      <li>there are no client funds, and there will be none.</li>
    </ul>

    <h3>No third-party assets</h3>
    <p>The company:</p>
    <ul>
      <li>does not accept or hold third-party money or crypto assets;</li>
      <li>does not operate third-party exchange accounts;</li>
      <li>holds no API permissions that would let it dispose of anyone else's funds, and asks for none;</li>
      <li>accepts no investments and gives no individual investment advice.</li>
    </ul>

    <h3>Published results</h3>
    <p>Published figures are historical research data for a specific instance and a specific
       period. They do not guarantee future results and are not an offer, a forecast or individual
       investment advice. Failed experiments are published the same as successful ones.</p>

    <h3>Company status</h3>
    <p>MB BlynAI is a small partnership registered in the Republic of Lithuania. Members — Lukas
       Peciukonis and Denisas Bykovas. Director — Lukas Peciukonis. Contact —
       <a href="mailto:info@@blynai.eu">info@@blynai.eu</a>.</p>
  </div>
</dialog>

<script>
((() => {
  'use strict';

  /* Живой API бота. CORS открыт (access-control-allow-origin: *). */
  const CFG = { apiBase: 'https://blynai.meetluko.eu', botInstanceId: 'futures-lukas-live', cycleSeconds: 120 };
  const DASH = '\u2014';
  const $ = (id) => document.getElementById(id);
  const num = (n) => (typeof n === 'number' && isFinite(n)) ? n.toLocaleString('en-GB') : DASH;

  /* 1 open · 2+ open — English needs no case table, only a plural */
  function openLabel(n){
    if (typeof n !== 'number') return DASH;
    return n + (n === 1 ? ' open' : ' open');
  }

  async function getJSON(path){
    try {
      const r = await fetch(CFG.apiBase + path, { headers: { accept: 'application/json' } });
      if (!r.ok) return null;
      const ct = r.headers.get('content-type') || '';
      if (!ct.includes('application/json')) return null;
      return await r.json();
    } catch (_) { return null; }
  }

  function drawSpark(values){
    const svg = $('spark'), line = $('sparkLine'), fill = $('sparkFill'), empty = $('sparkEmpty');
    const ys = (values || []).filter((v) => typeof v === 'number' && isFinite(v));
    if (ys.length < 2){ svg.setAttribute('hidden',''); empty.removeAttribute('hidden'); return; }
    empty.setAttribute('hidden',''); svg.removeAttribute('hidden');
    const W = 300, H = 74, PAD = 10;
    const lo = Math.min(...ys), hi = Math.max(...ys), span = (hi - lo) || 1;
    const pts = ys.map((v,i) => [
      (i / (ys.length - 1)) * W,
      H - PAD - ((v - lo) / span) * (H - PAD * 2)
    ]);
    const d = pts.map(([x,y],i) => (i ? 'L' : 'M') + x.toFixed(1) + ' ' + y.toFixed(1)).join(' ');
    line.setAttribute('d', d);
    fill.setAttribute('d', d + ' L' + W + ' ' + H + ' L0 ' + H + ' Z');
  }

  async function loadStats(){
    const d = await getJSON('/api/public-stats');
    $('stats').textContent =
      'Pairs ' + num(d && d.marketsNow) +
      ' \u00b7 Cycle ' + CFG.cycleSeconds + ' s' +
      ' \u00b7 Decisions ' + num(d && d.decisionsTotal);
  }

  let blackout = false;

  async function loadStatus(){
    const d = await getJSON('/api/bot-status');
    const live = $('live');
    if (!d){ live.setAttribute('hidden',''); return; }
    blackout = !!(d.entryBlackout && d.entryBlackout.isActive);
    if (blackout){
      live.textContent = 'Entries paused';
      live.classList.add('is-paused');
    } else if (d.runtimeState === 'running' && !d.isStale){
      live.textContent = 'Live';
      live.classList.remove('is-paused');
    } else {
      live.textContent = d.isStale ? 'Data is stale' : (d.runtimeState || DASH);
      live.classList.add('is-paused');
    }
    live.removeAttribute('hidden');
  }

  function pnlSpan(v){
    const el = document.createElement('span');
    el.className = 'pos__pnl';
    if (typeof v === 'number' && isFinite(v)){
      el.textContent = (v > 0 ? '+' : '') + v.toFixed(2) + '%';
      if (v < 0) el.classList.add('is-down');
    } else el.textContent = DASH;
    return el;
  }

  async function loadDashboard(){
    const d = await getJSON('/api/dashboard?botInstanceId=' + encodeURIComponent(CFG.botInstanceId));

    drawSpark(d && d.equity && Array.isArray(d.equity.days) ? d.equity.days.map((x) => x.close) : null);

    const open = (d && Array.isArray(d.positions)) ? d.positions : null;
    $('posCount').textContent = open ? openLabel(open.length) : DASH;

    const list = $('posList');
    list.textContent = '';

    if (open && open.length){
      for (const p of open){
        const row  = document.createElement('div'); row.className = 'pos';
        const sym  = document.createElement('span'); sym.className  = 'pos__pair'; sym.textContent = p.pair || DASH;
        const side = document.createElement('span'); side.className = 'pos__side'; side.textContent = (p.side || '').toUpperCase() || DASH;
        if (String(p.side).toUpperCase() === 'LONG') side.classList.add('is-long');
        row.append(sym, side, pnlSpan(p.unrealizedPnlPercent));
        list.append(row);
      }
      return;
    }

    const box = document.createElement('div'); box.className = 'pos pos--empty';
    const head = document.createElement('span'); head.textContent = 'No open positions';
    box.append(head);

    const trades = d && d.today && Array.isArray(d.today.trades) ? d.today.trades : [];
    const last = trades[trades.length - 1];
    if (last){
      const note = document.createElement('span'); note.className = 'mono';
      note.textContent = 'Last \u2014 ' + (last.pair || DASH) + ' ' + (last.side || '');
      box.append(note);
    }
    if (blackout){
      const bo = document.createElement('span'); bo.className = 'mono muted';
      bo.textContent = 'ENTRIES PAUSED \u2014 NIGHT WINDOW';
      box.append(bo);
    }
    list.append(box);
  }

  const msg = $('socialMsg');
  document.querySelectorAll('.socials button').forEach((b) => {
    b.addEventListener('click', () => {
      msg.textContent = b.dataset.name + ' \u2014 currently disabled';
      msg.removeAttribute('hidden');
    });
  });

  const legal = $('legal');
  $('openLegal').addEventListener('click', () => legal.showModal());
  $('closeLegal').addEventListener('click', () => legal.close());
  legal.addEventListener('click', (e) => { if (e.target === legal) legal.close(); });

  async function refresh(){ loadStats(); await loadStatus(); loadDashboard(); }
  refresh();
  setInterval(refresh, 60000);
})());
</script>
</body>
</html>
