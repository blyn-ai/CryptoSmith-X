@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnv
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("admin");
    var name = User.Identity?.Name;
    var env = HostEnv.IsDevelopment() ? "Local" : HostEnv.EnvironmentName;
    // Theme is read on the SERVER so the first paint is already correct — a
    // client-side patch would strobe on every one of the 10 s refreshes.
    var theme = Context.Request.Cookies["csx_theme"] == "light" ? "light" : "dark";
}
<!doctype html>
<html lang="en" data-theme="@theme">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>@(ViewData["Title"] ?? "CryptoSmith X")</title>
    @* Not ds/assets/favicon.svg — that is a different drawing altogether (angle brackets,
       not the mark). The master is brand/logo/cryptosmith-favicon.svg; the .ico is
       generated from it by brand/logo/make-favicons.py. *@
    <link rel="icon" href="~/favicon.ico" sizes="48x48 32x32 16x16">
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="~/ds/styles.css" asp-append-version="true">
    <link rel="stylesheet" href="~/app.css" asp-append-version="true">
    <link rel="stylesheet" href="~/theme-light.css" asp-append-version="true">
    @await RenderSectionAsync("head", required: false)
</head>
<body>
    <div class="top-rule"></div>
    @if (isAuth)
    {
        <div class="shell">
            <aside class="side">
                <div class="side-brand">
                    @* Ink mark on ink, paper mark on paper — the logo rule. CSS picks. *@
                    <img class="mark-ink" src="~/ds/assets/cryptosmith-mark.svg" alt="">
                    <img class="mark-paper" src="~/ds/assets/cryptosmith-mark-paper.svg" alt="">
                    <div>
                        <span class="wordmark">CryptoSmith <span>X</span></span>
                        <span class="side-sub">@(isAdmin ? "Admin console" : "Trader")</span>
                    </div>
                </div>
                @await Component.InvokeAsync("SideNav")
            </aside>
            <div class="col">
                <header class="head">
                    <span class="env">@env</span>
                    @await RenderSectionAsync("live", required: false)
                    @if (isAdmin)
                    {
                        <form method="get" action="/Admin/Search" class="head-search">
                            <input type="search" name="q" placeholder="symbol, asset, bot…" autocomplete="off">
                        </form>
                    }
                    <span class="who"><b>@name</b> · @(isAdmin ? "ADMIN" : "USER")</span>
                    <form method="post" action="/auth/logout">
                        @Html.AntiForgeryToken()
                        <button class="linkbtn" type="submit">Sign out</button>
                    </form>
                    <partial name="_ThemeToggle" />
                </header>
                <main class="main">
                    @RenderBody()
                </main>
                <footer class="foot">
                    <span>CryptoSmith X · @env</span>
                    <span class="sp"></span>
                    <a href="https://blynai.eu">blynai.eu</a>
                </footer>
            </div>
        </div>
    }
    else
    {
        <div class="theme-float"><partial name="_ThemeToggle" /></div>
        @RenderBody()
    }
    @* Scripts carry a manual cache-bust: the Script TagHelper's asp-append-version
       trips a Razor compiler bug on this SDK line, while the link helper is fine.
       Bump v= when either file changes. *@
    <script src="~/theme-toggle.js?v=2"></script>
    <script defer src="~/live.js?v=1"></script>
</body>
</html>
