@model IReadOnlyList<CryptoSmithX.WebApp.Models.CollectionCard>
@{
    ViewData["Title"] = "Collections";
}

<div class="page-head">
    <div class="t"><p class="eyebrow">Admin · operations</p><h1>Collections</h1></div>
    <p class="page-note">The catalogue of data kinds. Defaults live here; a venue row appears only where a human departed from them.</p>
</div>

<div class="coll-cards">
    @foreach (var c in Model)
    {
        <div class="panel">
            <div class="panel-h">
                <h2>@c.Name @if (c.Kind == "derived") { <span class="tag dashed">derived</span> }</h2>
                <span class="meta">@c.Code</span>
            </div>
            <div class="panel-b" style="padding:14px 18px 12px;display:flex;flex-direction:column;gap:13px">
                <p style="margin:0;font:400 12.5px/1.55 var(--font-body);color:var(--text-body);text-wrap:pretty">@c.Description</p>
                <div style="display:flex;gap:26px;flex-wrap:wrap">
                    <span class="ex-stat"><i>Default mode</i><b>@(c.DefaultMode switch { "collect" => "collect", "on_demand" => "on demand", _ => "disabled" })</b></span>
                    <span class="ex-stat"><i>Interval</i><b>@(c.DefaultIntervalS is { } iv ? $"{iv} s" : "—")</b></span>
                    <span class="ex-stat"><i>Retention</i><b>@(c.DefaultRetentionDays is { } rd ? $"{rd} d" : "never")</b></span>
                </div>
            </div>
            @if (c.Venues.Count > 0)
            {
                <div class="th r-coll-venue"><span>Venue</span><span>Mode</span><span>Departs from default</span></div>
                @foreach (var v in c.Venues)
                {
                    var departs = v.Mode != c.DefaultMode;
                    <div class="tr r-coll-venue" style="align-items:center">
                        <span class="mono" style="font-size:12px">@v.ExchangeName</span>
                        <span class="tag @(v.Mode switch { "collect" => "enabled", "on_demand" => "planned", _ => "disabled" })">@(v.Mode switch { "collect" => "collect", "on_demand" => "on demand", _ => "disabled" })</span>
                        @if (v.Note is not null)
                        {
                            <span class="code" style="white-space:normal;text-wrap:pretty;color:var(--text-muted)">@v.Note</span>
                        }
                        else if (!departs)
                        {
                            <span class="code" style="white-space:normal;color:var(--text-faint)">follows the default</span>
                        }
                        else
                        {
                            <span class="code" style="white-space:normal;text-wrap:pretty;color:var(--csx-gold-ink)">mode @v.Mode — no reason recorded</span>
                        }
                    </div>
                }
            }
            else
            {
                <p class="panel-note">No enabled exchanges yet.</p>
            }
        </div>
    }
</div>
