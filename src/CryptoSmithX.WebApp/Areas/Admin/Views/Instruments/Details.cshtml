@model InstrumentDetails
@using CryptoSmithX.WebApp.Data
@{
    ViewData["Title"] = Model.Symbol;
    var s = Model.Snapshot;
    string StatusTag(string x) => x == "trading" ? "enabled" : x is "halted" or "delisted" ? "" : "maintenance";

    // Close-line chart, the throughput pattern: area fill + line, server-rendered SVG, no library.
    Func<IReadOnlyList<double>, string, string, string> Chart = (values, colour, id) =>
    {
        if (values.Count < 2)
        {
            return "<div class=\"empty\"><p>Not enough points yet.</p></div>";
        }
        var area = Spark.Area(values, 600, 84);
        var line = Spark.Points(values, 600, 84);
        return $"<svg class=\"chart\" height=\"84\" viewBox=\"0 0 600 84\" preserveAspectRatio=\"none\">"
             + $"<defs><linearGradient id=\"{id}\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"{colour}\"/><stop offset=\"100%\" stop-color=\"transparent\"/></linearGradient></defs>"
             + $"<polygon points=\"{area}\" fill=\"url(#{id})\" opacity=\".35\"></polygon>"
             + $"<polyline points=\"{line}\" stroke=\"{colour}\" stroke-width=\"1.75\"></polyline></svg>";
    };
}

<div class="page-head">
    <div class="t">
        <p class="eyebrow">Admin · <a href="/Admin/Instruments">instruments</a> · <a href="/Admin/Exchanges/Details/@Model.ExchangeCode">@Model.ExchangeCode</a></p>
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
            <h1 class="mono">@Model.Symbol</h1>
            <span class="tag @StatusTag(Model.Status)">@Model.Status</span>
            @if (!Model.Collect) { <span class="tag gold">collect off</span> }
        </div>
        <p class="page-note" style="margin-top:6px">
            <a href="/Admin/Exchanges/Details/@Model.ExchangeCode">@Model.ExchangeCode</a> ·
            <a href="/Admin/Assets/Details/@Model.BaseAsset">@Model.BaseAsset</a>/@Model.QuoteAsset ·
            listed @Format.Utc(Model.ListedAt) · first seen @Format.Utc(Model.FirstSeenAt) · last seen @Format.Utc(Model.LastSeenAt)
        </p>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;align-items:flex-end">
        <a class="linkbtn" href="/Admin/Instruments">← Instruments</a>
        @if (Model.Siblings.Count > 0)
        {
            <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end">
                <span class="code" style="align-self:center">@Model.BaseAsset also on</span>
                @foreach (var sib in Model.Siblings)
                {
                    <a class="tag" href="/Admin/Instruments/Details/@sib.Id" title="@sib.Symbol">@sib.ExchangeCode</a>
                }
            </div>
        }
    </div>
</div>

@if (TempData["Error"] is string err) { <div class="alert alert-error">@err</div> }
@if (TempData["Saved"] is string saved) { <div class="alert alert-ok">@saved</div> }

<div class="grid2">
    <div class="stack">
        @* ── Snapshot ─────────────────────────────────────────── *@
        <div class="panel">
            <div class="panel-h"><h2>Current snapshot</h2><span class="meta">market_snapshot_latest</span></div>
            @if (s is null)
            {
                <div class="empty"><h3>No snapshot yet</h3><p>Nothing has been recorded for this instrument.</p></div>
            }
            else
            {
                <div class="kpis kpis-4" style="grid-template-columns:repeat(2,minmax(0,1fr));margin:0;padding:16px">
                    <div class="kpi"><p class="kpi-l">Last</p><p class="kpi-v">@Format.Num(s.LastPrice, 2)</p></div>
                    <div class="kpi"><p class="kpi-l">Mark</p><p class="kpi-v">@Format.Num(s.MarkPrice, 2)</p></div>
                    <div class="kpi"><p class="kpi-l">Funding</p><p class="kpi-v">@Format.Num(s.FundingRate, 6)</p></div>
                    <div class="kpi"><p class="kpi-l">OI notional</p><p class="kpi-v">@Format.Num(s.OpenInterestNotional, 0)</p></div>
                </div>
                <div class="scroll">
                    <div class="tr" style="grid-template-columns:1fr 1fr"><span class="muted">Bid / ask</span><span class="num">@Format.Num(s.BidPrice, 2) / @Format.Num(s.AskPrice, 2)</span></div>
                    <div class="tr" style="grid-template-columns:1fr 1fr"><span class="muted">Spread</span><span class="num">@Format.Num(s.SpreadBps, 1) bps</span></div>
                    <div class="tr" style="grid-template-columns:1fr 1fr"><span class="muted">Bid / ask size</span><span class="num">@Format.Num(s.BidSize, 3) / @Format.Num(s.AskSize, 3)</span></div>
                    <div class="tr" style="grid-template-columns:1fr 1fr"><span class="muted">Index</span><span class="num">@Format.Num(s.IndexPrice, 2)</span></div>
                    <div class="tr" style="grid-template-columns:1fr 1fr"><span class="muted">Open interest</span><span class="num">@Format.Num(s.OpenInterest, 2)</span></div>
                    <div class="tr" style="grid-template-columns:1fr 1fr"><span class="muted">Turnover 24h</span><span class="num">@Format.Num(s.Turnover24h, 0)</span></div>
                    <div class="tr" style="grid-template-columns:1fr 1fr"><span class="muted">Depth 10 bps (bid / ask)</span><span class="num">@Format.Num(s.DepthBid10, 0) / @Format.Num(s.DepthAsk10, 0)</span></div>
                    <div class="tr" style="grid-template-columns:1fr 1fr"><span class="muted">Depth 25 bps</span><span class="num">@Format.Num(s.DepthBid25, 0) / @Format.Num(s.DepthAsk25, 0)</span></div>
                    <div class="tr" style="grid-template-columns:1fr 1fr"><span class="muted">Depth 50 bps</span><span class="num">@Format.Num(s.DepthBid50, 0) / @Format.Num(s.DepthAsk50, 0)</span></div>
                </div>
                <div style="display:flex;gap:16px;flex-wrap:wrap;padding:12px 16px;border-top:1px solid var(--border-hairline)">
                    <span class="code">snapshot <b style="color:var(--text-body)">@Format.Age(s.SnapshotAgeSeconds)</b></span>
                    <span class="code">depth <b style="color:var(--text-body)">@Format.Age(s.DepthAgeSeconds)</b></span>
                    <span class="code">last candle <b style="color:var(--text-body)">@Format.Age(Model.Coverage.LastCandleAgeSeconds)</b></span>
                    <span class="code">funding <b style="color:var(--text-body)">@Format.Age(Model.Coverage.LastFundingAgeSeconds)</b></span>
                </div>
            }
        </div>

        @* ── Price ────────────────────────────────────────────── *@
        <div class="panel">
            <div class="panel-h">
                <h2>Price</h2>
                <span class="chips">
                    @foreach (var tf in Model.Timeframes)
                    {
                        var label = tf < 60 ? $"{tf}m" : $"{tf / 60}h";
                        <a class="chip @(tf == Model.Timeframe ? "is-on" : "")" href="/Admin/Instruments/Details/@Model.Id?tf=@tf">@label</a>
                    }
                </span>
            </div>
            <div class="panel-b">
                @if (Model.Candles.Count >= 2)
                {
                    @Html.Raw(Chart(Model.Candles.Select(c => c.Close).ToList(), "var(--violet-400)", "csxPrice"))
                    <div class="chart-x"><span>@Format.Utc(Model.Candles[0].OpenTime)</span><span class="mid">close · @Model.Candles.Count bars</span><span>@Format.Utc(Model.Candles[^1].OpenTime)</span></div>
                }
                else
                {
                    <div class="empty"><h3>No candles</h3><p>No bars stored for this timeframe yet.</p></div>
                }
            </div>
        </div>

        @* ── Microstructure ───────────────────────────────────── *@
        <div class="panel">
            <div class="panel-h"><h2>Microstructure</h2><span class="meta">market_metric_hour · 48 h</span></div>
            @if (Model.Metrics.Count >= 2)
            {
                <div class="panel-b" style="border-bottom:1px solid var(--border-hairline)">
                    <p class="eyebrow" style="margin-bottom:6px">Open interest</p>
                    @Html.Raw(Chart(Model.Metrics.Select(m => m.OpenInterestLast).ToList(), "var(--violet-400)", "csxOi"))
                </div>
                <div class="panel-b" style="border-bottom:1px solid var(--border-hairline)">
                    <p class="eyebrow" style="margin-bottom:6px">Funding rate</p>
                    @Html.Raw(Chart(Model.Metrics.Select(m => m.FundingRateLast).ToList(), "var(--lilac-500)", "csxFund"))
                </div>
                <div class="panel-b">
                    <p class="eyebrow" style="margin-bottom:6px">Spread bps</p>
                    @Html.Raw(Chart(Model.Metrics.Select(m => m.SpreadBpsAvg ?? 0).ToList(), "var(--gold-400)", "csxSpread"))
                </div>
            }
            else
            {
                <div class="empty"><h3>No hourly slices yet</h3><p>The first hourly rows appear after an hour of collection.</p></div>
            }
        </div>
    </div>

    <div class="stack">
        @* ── Collection control ───────────────────────────────── *@
        <div class="panel" style="padding:18px">
            <h2 style="margin-bottom:5px">Collection</h2>
            <p style="margin:0 0 14px;font:400 12px/1.5 var(--font-body);color:var(--text-muted)">Our decision — whether the Hub gathers snapshots, candles, depth and funding for this listing. Discovery keeps watching it either way. Not the same as the exchange's observed status (<span class="tag @StatusTag(Model.Status)" style="font-size:8.5px">@Model.Status</span>).</p>
            <form method="post" action="/Admin/Instruments/SaveCollect/@Model.Id">
                @Html.AntiForgeryToken()
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px">
                    <button class="sw" role="switch" aria-checked="@(Model.Collect ? "true" : "false")" type="submit" name="collect" value="@(Model.Collect ? "false" : "true")"><i></i></button>
                    <span class="sev @(Model.Collect ? "ok" : "")">@(Model.Collect ? "collecting" : "not collecting")</span>
                </div>
                <div class="field"><label for="note">Note</label><input id="note" name="note" type="text" value="@Model.CollectNote" placeholder="why on/off"></div>
                <button class="btn btn-sm" type="submit" name="collect" value="@(Model.Collect ? "true" : "false")" style="margin-top:8px">Save note</button>
            </form>
            @if (!Model.Collect)
            {
                <div class="err" style="margin-top:14px">
                    <b>Collection disabled</b>
                    <div><span class="t">@(string.IsNullOrEmpty(Model.CollectNote) ? "No reason given." : Model.CollectNote)</span><span class="m">by @(Model.CollectChangedBy ?? "—") · @Format.Utc(Model.CollectChangedAt)</span></div>
                </div>
            }
        </div>

        @* ── Data coverage ────────────────────────────────────── *@
        <div class="panel" style="padding:18px">
            <h2 style="margin-bottom:12px">Data coverage</h2>
            @if (Model.Coverage.Silent)
            {
                <div class="err" style="margin-bottom:14px">
                    <b>Silent</b>
                    <div><span class="t">The exchange is collecting but this instrument has no fresh snapshot.</span><span class="m">stale beyond three snapshot intervals</span></div>
                </div>
            }
            <div class="tr" style="grid-template-columns:1fr auto"><span class="muted">1-minute bars, 24 h</span><span class="num">@Model.Coverage.Minutes24h / 1440</span></div>
            <div class="tr" style="grid-template-columns:1fr auto"><span class="muted">Holes, 24 h</span><span class="num @(Model.Coverage.Holes24h > 0 ? "warn" : "")">@Model.Coverage.Holes24h</span></div>
            <div class="tr" style="grid-template-columns:1fr auto"><span class="muted">Candles</span><span class="num">@Format.Utc(Model.Coverage.CandleFrom) → @Format.Utc(Model.Coverage.CandleTo)</span></div>
            <div class="tr" style="grid-template-columns:1fr auto"><span class="muted">Funding history</span><span class="num">@Format.Utc(Model.Coverage.FundingFrom) → @Format.Utc(Model.Coverage.FundingTo)</span></div>
            <p class="panel-note">Holes are measured against a full day of 1-minute bars; a shorter candle range above just means the instrument is younger than a day.</p>
        </div>

        @* ── Funding history ──────────────────────────────────── *@
        <div class="panel">
            <div class="panel-h"><h2>Funding history</h2><span class="meta">last @Model.Funding.Count</span></div>
            @if (Model.Funding.Count == 0)
            {
                <div class="empty"><h3>No funding yet</h3><p>No funding payments recorded.</p></div>
            }
            @foreach (var f in Model.Funding)
            {
                <div class="tr" style="grid-template-columns:1fr auto"><span class="code">@Format.Utc(f.FundingTime)</span><span class="num @(f.Rate < 0 ? "" : "")">@Format.Num(f.Rate, 6)</span></div>
            }
        </div>
    </div>
</div>
