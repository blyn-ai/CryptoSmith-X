@model ExchangeDetails
@using CryptoSmithX.WebApp.Data
@{
    var e = Model.Exchange;
    var cfg = Model.Config;
    ViewData["Title"] = e.Name;
    ViewData["SegmentCode"] = e.Code;
    var tab = ViewData["Tab"] as string ?? "overview";

    string CollHealth(ExchangeCollectorRow c) => c.ConsecutiveFailures >= 3 ? "fail" : c.ConsecutiveFailures >= 1 ? "warn" : "ok";
    var worst = Model.Collectors.Where(c => c.LastError is not null).OrderByDescending(c => c.ConsecutiveFailures).FirstOrDefault();
    var maxFails = Model.Collectors.Count == 0 ? 0 : Model.Collectors.Max(c => c.ConsecutiveFailures);
    var health = maxFails >= 3 ? "fail" : maxFails >= 1 ? "warn" : "ok";
    var pulse = health == "ok" ? "pulse" : "pulse-gold";
    var statuses = new[] { "planned", "enabled", "disabled", "maintenance", "abandoned" };

    string StatusTag(string s) => s; // css carries one face per lifecycle status
    var overrides = new int?[] { cfg.SnapshotIntervalS, cfg.CandleIntervalS, cfg.DiscoveryIntervalMin, cfg.FundingIntervalMin, cfg.DepthIntervalS }.Count(x => x is not null);

    string GlobalHint(string key) => Model.GlobalIntervals.TryGetValue(key, out var v) ? $"global {v}" : "global";
    string OverrideNote(int? val, string key) => val is null ? "" : $"overrides {GlobalHint(key)}";
}
@section live { <span class="live">live · 10 s</span> }

<div class="page-head" style="margin-bottom:12px;align-items:center">
    <div class="t" style="gap:6px">
        <p class="eyebrow">Admin · <a href="/Admin/Exchanges">exchanges</a> · @e.ExchangeName · @e.Code · @e.Kind</p>
        <div style="display:flex;align-items:center;gap:11px;flex-wrap:wrap">
            <h1>@e.Name</h1>
            @await Html.PartialAsync("_ExchangeHeadBadge", Model)
        </div>
    </div>
    <div style="display:flex;gap:14px;align-items:center">
        <a class="linkbtn" href="/Admin/Instruments?segment=@e.Code">Instruments →</a>
        <a class="linkbtn" href="/Admin/Exchanges">← Exchanges</a>
    </div>
</div>

@if (TempData["Error"] is string err) { <div class="alert alert-error" style="margin-bottom:12px">@err</div> }
@if (TempData["Saved"] is string saved) { <div class="alert alert-ok" style="margin-bottom:12px">@saved</div> }

@if (e.Status == "enabled" && worst is not null && CollHealth(worst) != "ok")
{
    <div class="err" style="margin-bottom:12px">
        <b>Error</b>
        <div><span class="t">@worst.LastError</span><span class="m">@e.Code · @worst.Collector · @Format.Age(worst.LastErrorAgeSeconds) ago · collector_status.last_error</span></div>
    </div>
}

<div style="display:flex;gap:14px;flex-wrap:wrap;align-items:center;margin-bottom:14px">
    <div class="chips">
        <a class="chip @(tab == "overview" ? "is-on" : "")" href="/Admin/Exchanges/Details/@e.Code">overview</a>
        <a class="chip" href="/Admin/Exchanges/Runs/@e.Code">runs</a>
        <a class="chip @(tab == "settings" ? "is-on" : "")" href="/Admin/Exchanges/Details/@e.Code?tab=settings"><span>settings</span>@if (overrides > 0) { <span class="dot warn" style="margin-left:5px"></span> }</a>
    </div>
    <span style="flex:1"></span>
    @await Html.PartialAsync("_ExchangeStatRow", Model)
</div>

@if (tab == "settings")
{
    <div class="panel" style="padding:18px;max-width:940px">
        <div class="panel-h" style="margin-bottom:4px">
            <h2>Configuration</h2>
            @if (overrides > 0) { <span class="tag maintenance">@overrides override@(overrides == 1 ? "" : "s")</span> }
        </div>
        <p style="margin:0 0 16px;font:400 12px/1.5 var(--font-body);color:var(--text-muted)">What a human writes; nothing observed is stored here. Status lives on the overview, behind its guard.</p>
        <form method="post" action="/Admin/Exchanges/Save/@e.Code" data-live-skip>
            @Html.AntiForgeryToken()
            <div class="cfg-grid">
                <div class="field"><label for="name">Name</label><input id="name" name="name" type="text" value="@e.Name"></div>
                <div class="field"><label for="description">Description</label><input id="description" name="description" type="text" value="@e.Description"></div>
                <div class="field"><label>Adapter</label><input type="text" value="@cfg.Adapter" disabled></div>
                <div class="field"><label for="baseUrl">Base URL</label><input id="baseUrl" name="baseUrl" type="text" value="@cfg.BaseUrl" placeholder="https://…"></div>
                <div class="field"><label for="chartsUrl">Charts URL</label><input id="chartsUrl" name="chartsUrl" type="text" value="@cfg.ChartsUrl" placeholder="candles host / path"></div>
                <div class="field"><label for="wsUrl">WebSocket URL</label><input id="wsUrl" name="wsUrl" type="text" value="@cfg.WsUrl" placeholder="wss://… — blank = REST only"></div>
                <div class="field"><label for="quoteAssets">Quote assets</label><input id="quoteAssets" name="quoteAssets" type="text" value="@string.Join(", ", cfg.QuoteAssets)" placeholder="USD, USDT, USDC"></div>
                <div class="field"><label for="blacklist">Blacklist</label><input id="blacklist" name="blacklist" type="text" value="@string.Join(", ", cfg.Blacklist)" placeholder="symbols, comma-separated"></div>
            </div>

            <p class="eyebrow" style="margin:6px 0 2px">Intervals — empty uses the global</p>
            <div class="form-row">
                <div class="field"><label for="snapshotIntervalS">Snapshot (s)</label><input id="snapshotIntervalS" name="snapshotIntervalS" type="text" value="@(cfg.SnapshotIntervalS?.ToString())" placeholder="@GlobalHint("snapshot_interval_s")"><span class="code" style="color:var(--gold-400)">@OverrideNote(cfg.SnapshotIntervalS, "snapshot_interval_s")</span></div>
                <div class="field"><label for="candleIntervalS">Candles (s)</label><input id="candleIntervalS" name="candleIntervalS" type="text" value="@(cfg.CandleIntervalS?.ToString())" placeholder="@GlobalHint("candle_interval_s")"><span class="code" style="color:var(--gold-400)">@OverrideNote(cfg.CandleIntervalS, "candle_interval_s")</span></div>
                <div class="field"><label for="depthIntervalS">Depth (s)</label><input id="depthIntervalS" name="depthIntervalS" type="text" value="@(cfg.DepthIntervalS?.ToString())" placeholder="@GlobalHint("depth_interval_s")"><span class="code" style="color:var(--gold-400)">@OverrideNote(cfg.DepthIntervalS, "depth_interval_s")</span></div>
            </div>
            <div class="form-row">
                <div class="field"><label for="discoveryIntervalMin">Discovery (min)</label><input id="discoveryIntervalMin" name="discoveryIntervalMin" type="text" value="@(cfg.DiscoveryIntervalMin?.ToString())" placeholder="@GlobalHint("discovery_interval_min")"><span class="code" style="color:var(--gold-400)">@OverrideNote(cfg.DiscoveryIntervalMin, "discovery_interval_min")</span></div>
                <div class="field"><label for="fundingIntervalMin">Funding (min)</label><input id="fundingIntervalMin" name="fundingIntervalMin" type="text" value="@(cfg.FundingIntervalMin?.ToString())" placeholder="@GlobalHint("funding_interval_min")"><span class="code" style="color:var(--gold-400)">@OverrideNote(cfg.FundingIntervalMin, "funding_interval_min")</span></div>
            </div>

            <button class="btn" type="submit" style="margin-top:6px">Save changes</button>
            @if (cfg.UpdatedBy is not null) { <p class="panel-note">Last edited by @cfg.UpdatedBy</p> }
        </form>
        <dl class="legend">
            <dt>enabled</dt><dd>collect</dd>
            <dt>maintenance</dt><dd>deliberate pause, not an alert</dd>
            <dt>planned</dt><dd>no adapter yet</dd>
            <dt>abandoned</dt><dd>history only</dd>
        </dl>
    </div>
}
else
{
    <div class="grid2 grid2-hold">
        <div class="stack">
            @if (e.Status == "enabled")
            {
                @await Html.PartialAsync("_DataFeedsPanel", Model)

                @foreach (var d in Model.FeedDialogs)
                {
                    @await Html.PartialAsync("_FeedDialog", d)
                }

                @await Html.PartialAsync("_ThroughputPanel", Model)
                @await Html.PartialAsync("_LatencyPanel", Model)
            }
            else
            {
                <div class="panel"><div class="empty lg"><h3>@e.Status.ToUpperInvariant()</h3><p>This exchange is not collecting, so it has no health, latency or freshness to show. Enable it from the Lifecycle control to start.</p></div></div>
            }
        </div>

        <div class="stack">
            @* A hole in the data and a quiet market look identical on every other panel here.
               This is the only one that says which it was, so it sits above the rest. *@
            <div class="panel">
                <div class="panel-h"><h2>Not observed</h2><span class="meta">COLLECTION_GAP · 48 H</span></div>
                @if (Model.Gaps.Count == 0)
                {
                    <div class="empty"><h3>No gaps</h3><p>Every collector on this venue has been answering for the last two days.</p></div>
                }
                else
                {
                    @* Two lines per row, not four columns: this panel lives in the narrow rail and a
                       table here collides with itself. Collector and duration read across the top,
                       cause and start time underneath. *@
                    @foreach (var g in Model.Gaps)
                    {
                        var open = g.GapEnd is null;
                        <div class="tr" style="grid-template-columns:1fr auto;row-gap:3px;padding:9px 16px" title="@g.Detail">
                            <span class="mono">@g.Collector</span>
                            <span class="num @(open ? "fail" : "muted")">@(open ? "open" : Format.Age(g.SecondsLong))</span>
                            <span class="code" style="grid-column:1/-1;color:var(--text-faint)">@g.Cause.Replace('_', ' ') · @Format.Utc(g.GapStart)</span>
                        </div>
                    }
                    <p class="panel-note">An open gap is still happening. These intervals were not observed at all — they are not zeros, and nothing in the charts above should be read across them.</p>
                }
            </div>

            @await Html.PartialAsync("_StalestPanel", Model)

            @* data-live-skip: the edit/locked toggle is client state; a tick must not reset it. *@
            <div class="panel guard" style="padding:16px 18px" data-lifecycle data-live-skip>
                <div class="panel-h" style="margin-bottom:10px"><h2>Lifecycle</h2><span class="tag gold">protected</span></div>
                <div style="display:flex;align-items:center;gap:9px;margin-bottom:12px">
                    <span class="dot @(e.Status == "enabled" ? $"{health} {pulse}" : "none")"></span>
                    <span class="tag @StatusTag(e.Status)">@e.Status</span>
                    <span class="code">@Model.Collectors.Count collectors</span>
                </div>

                <div data-status-locked>
                    <button class="btn btn-ghost btn-sm" type="button" data-status-edit>Change status…</button>
                    <p style="margin:10px 0 0;font:400 12px/1.5 var(--font-body);color:var(--text-muted)">Stopping the integration halts every collector for this venue and its instruments go stale immediately. It is not an undoable click.</p>
                </div>

                <form method="post" action="/Admin/Exchanges/Status/@e.Code" style="display:none"
                      data-status-form data-code="@e.Code" data-current="@e.Status"
                      data-collectors="@Model.Collectors.Count" data-trading="@e.TradingInstruments">
                    @Html.AntiForgeryToken()
                    <p class="eyebrow" style="margin:0 0 6px">New status</p>
                    <div class="chips" data-status-chips style="margin-bottom:12px">
                        @foreach (var st in statuses)
                        {
                            <label class="chip @(st == e.Status ? "is-on" : "")"><input type="radio" name="newStatus" value="@st" @(st == e.Status ? "checked" : "") style="position:absolute;opacity:0;width:0;height:0" data-status-radio>@st</label>
                        }
                    </div>
                    <div class="err" style="margin-bottom:12px"><b>Confirm</b><div><span class="t" data-impact></span><span class="m">Type the exchange code to release the guard.</span></div></div>
                    <div class="field"><label for="confirmCode">Exchange code</label><input id="confirmCode" name="confirmCode" type="text" autocomplete="off" spellcheck="false" placeholder="@e.Code" data-confirm></div>
                    <div style="display:flex;gap:12px;align-items:center">
                        <button class="btn btn-sm" type="submit" data-apply disabled style="opacity:.4;cursor:not-allowed">Apply</button>
                        <button class="linkbtn" type="button" data-status-cancel>Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* Guarded Lifecycle + stat-scroll. Delegated on document so it survives live.js swapping <main>. *@
<script>
(function () {
    if (window.__csxExchWired) { return; }
    window.__csxExchWired = true;

    document.addEventListener('click', function (ev) {
        if (ev.target.closest('[data-status-edit]')) { setEditing(ev.target, true); return; }
        if (ev.target.closest('[data-status-cancel]')) { setEditing(ev.target, false); return; }
        var scroll = ev.target.closest('[data-scroll="stalest"]');
        if (scroll) {
            ev.preventDefault();
            var t = document.getElementById('stalest');
            if (t) { window.scrollTo({ top: t.getBoundingClientRect().top + window.scrollY - 78, behavior: 'smooth' }); }
        }
    });
    document.addEventListener('change', function (ev) {
        var form = ev.target.closest('[data-status-form]');
        if (form && ev.target.matches('[data-status-radio]')) { recompute(form); }
    });
    document.addEventListener('input', function (ev) {
        if (ev.target.matches('[data-confirm]')) { recompute(ev.target.closest('[data-status-form]')); }
    });

    function setEditing(el, editing) {
        var panel = el.closest('[data-lifecycle]');
        if (!panel) { return; }
        var locked = panel.querySelector('[data-status-locked]');
        var form = panel.querySelector('[data-status-form]');
        if (!locked || !form) { return; }
        locked.style.display = editing ? 'none' : '';
        form.style.display = editing ? '' : 'none';
        if (editing) {
            var code = form.querySelector('[data-confirm]');
            if (code) { code.value = ''; code.focus(); }
            recompute(form);
        }
    }

    function recompute(form) {
        if (!form) { return; }
        var current = form.dataset.current, code = form.dataset.code;
        form.querySelectorAll('[data-status-chips] .chip').forEach(function (l) {
            var r = l.querySelector('input');
            l.classList.toggle('is-on', !!(r && r.checked));
        });
        var picked = form.querySelector('[data-status-radio]:checked');
        var pick = picked ? picked.value : current;
        var impact = form.querySelector('[data-impact]');
        if (impact) {
            if (pick === current) { impact.textContent = 'No change — ' + code + ' is already ' + current + '.'; }
            else if (pick === 'enabled') { impact.textContent = code + ' → enabled starts collecting.'; }
            else { impact.textContent = code + ' → ' + pick + ' stops ' + form.dataset.collectors + ' collectors; ' + form.dataset.trading + ' trading instruments go stale at once.'; }
        }
        var typed = (form.querySelector('[data-confirm]') || {}).value || '';
        var ok = pick !== current && typed.trim().toLowerCase() === code.toLowerCase();
        var apply = form.querySelector('[data-apply]');
        if (apply) {
            apply.disabled = !ok;
            apply.style.opacity = ok ? '' : '.4';
            apply.style.cursor = ok ? '' : 'not-allowed';
        }
    }
})();
</script>

@* Edit feed dialog: mode/transport chips, the loss guard vs. the calm counter-case, and the
   own/dataset cascade highlight. Delegated on document, same reason as above. *@
<script>
(function () {
    if (window.__csxFeedWired) { return; }
    window.__csxFeedWired = true;

    document.addEventListener('click', function (ev) {
        var edit = ev.target.closest('[data-feed-edit]');
        if (edit) {
            var dlg = document.getElementById('feed-dialog-' + edit.getAttribute('data-feed-edit'));
            if (dlg) { dlg.style.display = 'flex'; recompute(dlg); syncModal(); }
            return;
        }
        if (ev.target.closest('[data-dialog-close]')) {
            var open = ev.target.closest('[data-feed-dialog]');
            if (open) { open.style.display = 'none'; syncModal(); }
            return;
        }
        if (ev.target.classList.contains('modal-scrim')) { ev.target.style.display = 'none'; syncModal(); }
    });

    // body.has-modal pauses live.js while a dialog is open: the page behind a modal has no
    // business changing, and the dialog itself is data-live-skip so a tick could not touch it anyway.
    function syncModal() {
        var anyOpen = Array.prototype.some.call(document.querySelectorAll('[data-feed-dialog]'), function (d) { return d.style.display === 'flex'; });
        document.body.classList.toggle('has-modal', anyOpen);
    }

    document.addEventListener('change', function (ev) {
        if (ev.target.matches('[data-mode-radio], [data-transport-radio]')) {
            recompute(ev.target.closest('[data-feed-dialog]'));
        }
    });
    document.addEventListener('input', function (ev) {
        if (ev.target.matches('[data-guard-code], [data-interval], [data-retention]')) {
            recompute(ev.target.closest('[data-feed-dialog]'));
        }
    });

    function recompute(dlg) {
        if (!dlg) { return; }
        var original = dlg.dataset.originalMode, historyless = dlg.dataset.history === 'none', code = dlg.dataset.dataset;

        dlg.querySelectorAll('[data-mode-chips] .chip, [data-transport-chips] .chip').forEach(function (l) {
            var r = l.querySelector('input');
            l.classList.toggle('is-on', !!(r && r.checked));
        });

        var pickedEl = dlg.querySelector('[data-mode-radio]:checked');
        var picked = pickedEl ? pickedEl.value : original;
        var stops = original === 'collect' && picked !== 'collect';

        var guard = dlg.querySelector('[data-guard]'), calm = dlg.querySelector('[data-calm]');
        if (guard) { guard.style.display = (stops && historyless) ? '' : 'none'; }
        if (calm) { calm.style.display = (stops && !historyless) ? '' : 'none'; }

        var tag = dlg.querySelector('[data-mode-tag]');
        if (tag) { tag.textContent = picked === 'collect' ? 'collect' : picked === 'on_demand' ? 'on demand' : 'disabled'; }

        var save = dlg.querySelector('[data-save]');
        var typed = (dlg.querySelector('[data-guard-code]') || {}).value || '';
        var needsGuard = stops && historyless;
        var ok = !needsGuard || typed.trim().toLowerCase() === code.toLowerCase();
        if (save) {
            save.textContent = stops ? 'Stop collecting' : 'Save changes';
            save.disabled = !ok;
            save.style.opacity = ok ? '' : '.4';
            save.style.cursor = ok ? '' : 'not-allowed';
        }

        ['interval', 'retention'].forEach(function (kind) {
            var input = dlg.querySelector('[data-' + kind + ']');
            var strip = dlg.querySelector('[data-' + kind + '-cascade]');
            if (!input || !strip) { return; }
            var cells = strip.querySelectorAll('span');
            var hasOwn = input.value.trim() !== '';
            cells.forEach(function (c) { c.classList.remove('is-eff', 'is-own'); });
            cells[hasOwn ? 0 : 1].classList.add('is-eff');
            if (hasOwn) { cells[0].classList.add('is-own'); }
        });
    }

    document.querySelectorAll('[data-feed-dialog]').forEach(recompute);
})();
</script>
