@model MarketDataConsole
@{
    ViewData["Title"] = "Market data";
}
@section head {
    <meta http-equiv="refresh" content="10">
}
<main>
    <div class="page-head">
        <div>
            <p class="eyebrow">Admin · read-only</p>
            <h1>Market data</h1>
        </div>
        <span class="who">asOf <b>@Model.AsOf.UtcDateTime.ToString("HH:mm:ss")Z</b> · refreshes 10 s</span>
    </div>

    <h2>Collectors</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Exchange</th><th>Collector</th><th class="num">Last success</th><th class="num">Failures</th><th class="num">Expected</th><th>Last error</th></tr>
            </thead>
            <tbody>
                @if (Model.Collectors.Count == 0)
                {
                    <tr><td colspan="6" class="dash">No collectors reporting.</td></tr>
                }
                @foreach (var c in Model.Collectors)
                {
                    <tr>
                        <td>@c.exchangeCode</td>
                        <td>@c.collector</td>
                        <td class="num muted">@Format.Age((double?)c.lastSuccessAgeSeconds)</td>
                        <td class="num @((int)c.consecutiveFailures > 0 ? "down" : "")">@c.consecutiveFailures</td>
                        <td class="num muted">@(c.instrumentsExpected ?? (object)Format.Dash)</td>
                        <td class="muted">@(c.lastError ?? (object)Format.Dash)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h2 class="section">Stale instruments <span class="muted">(@Model.Stale.Count)</span></h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Exchange</th><th>Symbol</th><th class="num">Received</th><th class="num">Age</th></tr>
            </thead>
            <tbody>
                @if (Model.Stale.Count == 0)
                {
                    <tr><td colspan="4" class="up">None — every trading instrument is fresh.</td></tr>
                }
                @foreach (var s in Model.Stale)
                {
                    <tr>
                        <td>@s.exchangeCode</td>
                        <td>@s.symbol</td>
                        <td class="num muted">@Format.Utc((DateTime?)s.receivedAt)</td>
                        <td class="num down">@Format.Age((double?)s.ageSeconds)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h2 class="section">Snapshot <span class="muted">(@Model.Snapshot.Count)</span></h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Exchange</th><th>Symbol</th><th class="num">Last</th><th class="num">Bid</th><th class="num">Ask</th><th class="num">Spread bps</th><th class="num">Mark</th><th class="num">Funding</th><th class="num">OI notional</th><th class="num">Age</th></tr>
            </thead>
            <tbody>
                @if (Model.Snapshot.Count == 0)
                {
                    <tr><td colspan="10" class="dash">No snapshot rows yet.</td></tr>
                }
                @foreach (var r in Model.Snapshot)
                {
                    <tr>
                        <td>@r.exchangeCode</td>
                        <td>@r.symbol</td>
                        <td class="num">@Format.Num((double?)r.lastPrice, 4)</td>
                        <td class="num muted">@Format.Num((double?)r.bidPrice, 4)</td>
                        <td class="num muted">@Format.Num((double?)r.askPrice, 4)</td>
                        <td class="num muted">@Format.Num((double?)r.spreadBps, 1)</td>
                        <td class="num muted">@Format.Num((double?)r.markPrice, 4)</td>
                        <td class="num muted">@Format.Num((double?)r.fundingRate, 6)</td>
                        <td class="num muted">@Format.Num((double?)r.openInterestNotional, 0)</td>
                        <td class="num muted">@Format.Age((double?)r.ageSeconds)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h2 class="section">Instruments <span class="muted">(@Model.Instruments.Count)</span></h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Exchange</th><th>Symbol</th><th>Base</th><th>Quote</th><th>Status</th><th class="num">Last seen</th></tr>
            </thead>
            <tbody>
                @if (Model.Instruments.Count == 0)
                {
                    <tr><td colspan="6" class="dash">No instruments discovered yet.</td></tr>
                }
                @foreach (var i in Model.Instruments)
                {
                    <tr>
                        <td>@i.exchangeCode</td>
                        <td>@i.symbol</td>
                        <td>@i.baseAsset</td>
                        <td class="muted">@i.quoteAsset</td>
                        <td class="muted">@i.status</td>
                        <td class="num muted">@Format.Utc((DateTime?)i.lastSeenAt)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>
