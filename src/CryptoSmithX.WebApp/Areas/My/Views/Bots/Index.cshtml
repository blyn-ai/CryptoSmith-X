@model IReadOnlyList<BotListItem>
@{
    ViewData["Title"] = "My bots";
}
<main>
    <div class="page-head">
        <div>
            <p class="eyebrow">Your bots</p>
            <h1>My bots</h1>
        </div>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Instance</th><th>Enabled</th><th>Last heartbeat</th><th></th></tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="dash">You have no bots yet.</td></tr>
                }
                @foreach (var b in Model)
                {
                    <tr>
                        <td><a href="/My/Bots/Details/@b.Id">@b.BotInstanceId</a></td>
                        <td>@if (b.IsEnabled) { <span class="badge badge-on">on</span> } else { <span class="badge badge-off">off</span> }</td>
                        <td class="muted">@Format.Age(b.HeartbeatAgeSeconds)</td>
                        <td><a href="/My/Bots/Details/@b.Id">Open</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>
