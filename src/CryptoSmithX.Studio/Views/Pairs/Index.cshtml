@model PairListModel
@{
    ViewData["Title"] = "Pairs — Studio — CryptoSmith X";
    ViewData["Eyebrow"] = "Market monitor · pairs";
    ViewData["RenderedAt"] = Model.RenderedAt;
    ViewData["ShowCollected"] = false;

    var busiest = Model.Pairs.Count == 0 ? 0 : Model.Pairs.Max(p => p.Venues);
}

<main class="a-main">

    <div class="a-statement-row">
        <h1 class="a-statement">
            @if (Model.Pairs.Count == 0)
            {
                <text>Nothing matches that.</text>
            }
            else
            {
                @* Two counts and no adjective. Venues and listings are different numbers — one venue
                   can list BTC/USDT and BTC/USDC at once — and the busiest pair is the one figure
                   here that says how much of a comparison this site can actually make.

                   When the board is full, the first sentence says so in the loudest type on the
                   page rather than in a footnote: this list is capped, and a page that printed
                   "200 pairs on this board" over a filter matching 4,812 of them would be showing
                   less than it has and saying nothing about it. The ordering is busiest-first, so
                   the second sentence is true either way — what a full board cuts is always the
                   thin end. *@
                @if (Model.Truncated)
                {
                    <text>@Model.Pairs.Count of @Model.Matching pairs on this board.</text>
                }
                else
                {
                    <text>@Model.Pairs.Count pair@(Model.Pairs.Count == 1 ? "" : "s") on this board.</text>
                }
                <em>@busiest venue@(busiest == 1 ? "" : "s") on the busiest.</em>
            }
        </h1>
        <span class="csx-eyebrow" style="color:var(--text-faint)">Quotes folded · venues, then listings</span>
    </div>

    @* The one form on the site. GET, so a search is a URL somebody can send to someone else, and so
       nothing here needs an antiforgery token — which matters, because this application's data
       protection keys are ephemeral by design and a token would stop validating across a restart. *@
    <form class="a-search" method="get" action="@Url.Action("Index", "Pairs")">
        <label class="csx-eyebrow" for="q" style="align-self:center">Filter</label>
        <input class="a-input" id="q" name="q" type="search" value="@Model.Search"
               placeholder="BTC, USD, …" spellcheck="false" autocomplete="off" maxlength="32">
        <button class="a-btn" type="submit">Show</button>
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <a class="a-btn" href="@Url.Action("Index", "Pairs")" style="display:inline-flex;align-items:center">Clear</a>
        }
    </form>

    @* The cap, in words, next to the thing it capped. Not at the foot of the page: a reader who
       stops at the last card has to have been told before they got there, and the number that
       matters to them is how many pairs they are NOT looking at. *@
    @if (Model.Truncated)
    {
        <p class="a-note">
            Showing the <b>@Model.Limit</b> pairs carried by the most venues.
            <b>@(Model.Matching - Model.Pairs.Count)</b> more match and are not on this page — this
            board is capped at @Model.Limit cards, which is a rule of the page and not a fact about
            the market. Filter by an asset to reach any of them.
        </p>
    }

    @if (Model.Pairs.Count == 0)
    {
        <div class="a-panel a-empty">
            <h2>No pair matches “@Model.Search”</h2>
            <p class="a-note">
                This board lists the pairs we are collecting, with the quote folded into its family —
                USD, USDT and USDC are one heading and each row on a pair's page still shows the
                venue's own quote. Nothing here says the pair does not trade somewhere; it says we do
                not collect it.
            </p>
        </div>
    }
    else
    {
        <div class="a-pairs">
            @foreach (var p in Model.Pairs)
            {
                @* RouteUrl by NAME, not Url.Action. The default route is registered first — it has
                   to be, or a two-segment pair route swallows every conventional URL on the site —
                   so link generation would otherwise resolve this to /Pairs/Pair?baseFamily=… and
                   the short address the page is designed around would exist only if a visitor typed
                   it. Naming the route asks for the address we mean. *@
                var href = Url.RouteUrl("pair", new
                {
                    controller = "Pairs",
                    action = "Pair",
                    baseFamily = p.BaseFamily,
                    quoteFamily = p.QuoteFamily
                });

                <a class="a-plain a-pair-card" href="@href">
                    <span class="a-pair-name">@p.BaseFamily / @p.QuoteFamily</span>
                    <span class="a-pair-counts">
                        <span title="Order books quoting this pair. Distinct segments, because a venue's spot book and its perp book are two books.">
                            <b>@p.Venues</b> venue@(p.Venues == 1 ? "" : "s")
                        </span>
                        <span title="Instruments folding into this heading. Higher than the venue count where a venue lists the pair against more than one quote in the same family.">
                            <b>@p.Listings</b> listing@(p.Listings == 1 ? "" : "s")
                        </span>
                    </span>
                </a>
            }
        </div>
    }

    <p class="a-note">
        A pair's two halves are <b>families</b>: USD, USDT and USDC fold into one heading so that a
        reader asking about bitcoin gets one row rather than three. Nothing stored is folded — every
        venue's own quote is printed on the comparison page, on every row, and the collector's tables
        still hold USDT as USDT. <b>Venues</b> counts order books; <b>listings</b> counts instruments,
        and they differ wherever one venue lists the pair against two quotes in the same family.
    </p>
</main>
