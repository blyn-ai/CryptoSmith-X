@model Dashboard
@using CryptoSmithX.WebApp.Admin.Data
@{
    ViewData["Title"] = "Status · CryptoSmith X";
    // health string → the css atoms the design system defines
    string Dot(string h) => h switch { "ok" => "ok", "degraded" => "warn", "failing" => "fail", "paused" => "paused", _ => "none" };
    string Sev(string h) => h switch { "ok" => "ok", "degraded" => "warn", "failing" => "fail", "paused" => "paused", _ => "none" };
    string SevText(string h) => h switch { "ok" => "ok", "degraded" => "degraded", "failing" => "failing", "paused" => "paused", _ => "—" };
    string TagCls(string s) => s; // one face per status lives in css (--status-*)
    string ColNum(string h) => h switch { "fail" => "fail", "warn" => "warn", _ => "muted" };
    var clear = Model.Failing == 0 && Model.Degraded == 0;
}
@section live {
    <span class="live"><span class="dot @(clear ? "ok" : "fail") fresh"></span>as of <b>@Model.AsOf.ToString("HH:mm:ss")Z</b> · live · 10 s</span>
}

<div class="page-head"><div class="t"><p class="eyebrow">Admin · overview</p><h1>Status</h1></div></div>

<div class="verdict @(clear ? "is-clear" : "")">
    <span class="dot @(clear ? "ok" : "fail") lg fresh"></span>
    <span class="lbl">@(clear ? "All clear" : $"{Model.Failing} failing · {Model.Degraded} degraded")</span>
    <p>@Model.Verdict</p>
</div>

<div class="kpis">
    <div class="kpi"><p class="kpi-l">Exchanges</p><p class="kpi-v">@Model.ExchangesEnabled / @Model.ExchangesTotal</p><p class="kpi-s">enabled · @Model.ExchangesMaintenance maintenance, @Model.ExchangesPlanned planned</p></div>
    <div class="kpi"><p class="kpi-l">Collectors ok</p><p class="kpi-v @(Model.CollectorsFailing > 0 ? "warn" : "")">@Model.CollectorsOk / @Model.CollectorsTotal</p><p class="kpi-s">@(Model.CollectorsFailing > 0 ? $"{Model.CollectorsFailing} failing" : "all inside interval")</p></div>
    <div class="kpi"><p class="kpi-l">Instruments</p><p class="kpi-v">@Model.InstrumentsTrading</p><p class="kpi-s">trading of @Model.InstrumentsKnown known</p></div>
    <div class="kpi"><p class="kpi-l">Bots online</p><p class="kpi-v @(Model.BotsTotal > 0 && Model.BotsOnline < Model.BotsTotal ? "warn" : Model.BotsTotal == 0 ? "none" : "")">@Model.BotsOnline / @Model.BotsTotal</p><p class="kpi-s">@(Model.SilentBotNote ?? "all reporting")</p></div>
    <div class="kpi"><p class="kpi-l">Events 1 h</p><p class="kpi-v @(Model.EventsLastHour == 0 ? "none" : "")">@Model.EventsLastHour</p><p class="kpi-s">bot_event · last hour</p></div>
</div>

<div class="grid2">
    <div class="stack">
        <div class="panel">
            <div class="panel-h"><h2>Exchange health</h2><span class="meta">Lifecycle · observed health</span></div>
            <div class="scroll">
            @foreach (var e in Model.Exchanges)
            {
                var pts = Spark.Points(e.Spark, 72, 18);
                <div class="tr r-ex @(e.Health == "failing" ? "is-fail" : "")">
                    <span class="tag @TagCls(e.Status)">@e.Status</span>
                    <span class="cell"><span class="dot @Dot(e.Health) @(e.Health == "ok" ? "fresh" : "")"></span><a class="name" href="/Admin/Exchanges/Details/@e.Code">@e.Name</a><span class="code">@e.Code</span></span>
                    <span class="sev @Sev(e.Health)">@SevText(e.Health)</span>
                    <span class="num">@(e.Status == "enabled" ? $"{e.TradingInstruments} / {e.KnownInstruments}" : "—")</span>
                    <span class="num @(e.Health == "failing" ? "fail" : e.Health == "degraded" ? "warn" : "muted")">@(e.Status == "enabled" ? Format.Age(e.WorstAgeSeconds) : "—")</span>
                    @if (pts.Length > 0)
                    {
                        <svg class="spark @(e.Health == "failing" ? "fail" : e.Health == "degraded" ? "warn" : "")" viewBox="0 0 72 18" preserveAspectRatio="none"><polyline points="@pts"></polyline></svg>
                    }
                    else
                    {
                        <span class="num none">—</span>
                    }
                </div>
            }
            </div>
            <p class="panel-note">Sparkline · snapshot rows per 5 min, last 2 h · market_snapshot.received_at</p>
        </div>

        <div class="panel">
            <div class="panel-h"><h2>Ingest volume</h2><span class="meta">bot_event · 15 min buckets · 6 h</span></div>
            <div class="panel-b">
                @if (Model.IngestBuckets.Sum() > 0)
                {
                    <svg class="chart" height="96" viewBox="0 0 600 96" preserveAspectRatio="none">
                        <defs>
                            <linearGradient id="csxCurve" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="var(--gold-400)"/><stop offset="55%" stop-color="var(--gold-600)"/><stop offset="100%" stop-color="var(--violet-700)"/></linearGradient>
                            <linearGradient id="csxFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--tint-violet)"/><stop offset="100%" stop-color="transparent"/></linearGradient>
                        </defs>
                        <polygon points="@Spark.Area(Model.IngestBuckets, 600, 96)" fill="url(#csxFill)"></polygon>
                        <polyline points="@Spark.Points(Model.IngestBuckets, 600, 96)" stroke="url(#csxCurve)"></polyline>
                    </svg>
                    <div class="chart-x"><span>−6 h</span><span class="mid">peak @Model.IngestPeak events · 15 min</span><span>now</span></div>
                }
                else
                {
                    <div class="empty"><h3>No ingest yet</h3><p>Bots POST events to /api/ingest/events. Nothing has arrived in the last six hours.</p></div>
                }
            </div>
        </div>

        <div class="panel">
            <div class="panel-h"><h2>Collectors</h2></div>
            <div class="scroll">
                <div class="th r-col"><span>Exchange</span><span>Collector</span><span style="justify-self:end">Last ok</span><span style="justify-self:end">Fails</span><span style="justify-self:end">Avg ms</span><span>Last error</span></div>
                @if (Model.Collectors.Count == 0)
                {
                    <div class="empty"><h3>No collectors yet</h3><p>Enable an exchange to start collecting.</p></div>
                }
                @foreach (var c in Model.Collectors)
                {
                    <a class="tr r-col @(c.Health == "fail" ? "is-fail" : "")" href="/Admin/Exchanges/Details/@c.SegmentCode">
                        <span class="cell"><span class="dot @c.Health @(c.Health == "ok" ? "fresh" : "")"></span><span class="name">@c.SegmentCode</span></span>
                        <span class="mono muted">@c.Collector</span>
                        <span class="num @ColNum(c.Health)">@Format.Age(c.LastSuccessAgeSeconds)</span>
                        <span class="num @(c.ConsecutiveFailures > 0 ? c.Health : "muted")">@c.ConsecutiveFailures</span>
                        <span class="num muted">@(c.AvgDurationMs?.ToString() ?? "—")</span>
                        <span class="mono @(c.LastError is null ? "faint" : c.Health)" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;@(c.LastError is not null && c.Health != "ok" ? "color:var(--gold-300)" : "")">@(c.LastError ?? "—")</span>
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="stack">
        <div class="panel">
            <div class="panel-h"><h2>Bots</h2></div>
            @if (Model.Bots.Count == 0)
            {
                <div class="empty"><h3>No bots yet</h3><p>Register one under Bots.</p></div>
            }
            @foreach (var b in Model.Bots)
            {
                <a class="tr" style="grid-template-columns:auto 1fr auto;padding:9px 16px" href="/Admin/Bots/Details/@b.Id">
                    <span class="dot @(b.Online ? "ok fresh" : "fail")"></span>
                    <span style="display:flex;flex-direction:column;gap:3px;min-width:0"><span class="name">@b.BotInstanceId</span><span class="code" style="letter-spacing:.08em">@b.TenantCode</span></span>
                    <span class="num @(b.Online ? "muted" : "fail")">@(b.LastHeartbeatAgeSeconds is null ? "never" : Format.Age(b.LastHeartbeatAgeSeconds))</span>
                </a>
            }
        </div>

        <div class="panel">
            <div class="panel-h"><h2>Recent events</h2><span class="meta">bot_event</span></div>
            @if (Model.Events.Count == 0)
            {
                <div class="empty"><h3>No events yet</h3><p>Bots report opens, fills and risk decisions here.</p></div>
            }
            @foreach (var ev in Model.Events)
            {
                <a class="tr" style="grid-template-columns:66px minmax(0,1fr);gap:10px;padding:6px 16px" href="/Admin/Bots/Details/@ev.BotId">
                    <span class="mono faint" style="font-variant-numeric:tabular-nums">@ev.Utc.ToString("HH:mm:ss")</span>
                    <span style="display:flex;flex-direction:column;gap:2px;min-width:0"><span class="name" style="@(ev.IsError ? "color:var(--gold-300)" : "")">@ev.Type</span><span class="code">@ev.TenantCode · @ev.BotInstanceId</span></span>
                </a>
            }
        </div>

        <div class="panel">
            <div class="panel-h"><h2>Tenants</h2></div>
            @if (Model.Tenants.Count == 0)
            {
                <div class="empty"><h3>No tenants yet</h3><p>Create one under Tenants.</p></div>
            }
            @foreach (var t in Model.Tenants)
            {
                <a class="tr" style="grid-template-columns:auto auto;justify-content:space-between;padding:9px 16px;border-bottom:0" href="/Admin/Clients/Details/@t.Code"><span class="mono">@t.Code</span><span class="code">@t.BotCount bot@(t.BotCount == 1 ? "" : "s") · since @t.CreatedAt.ToString("yyyy-MM-dd")</span></a>
            }
        </div>

        <div class="notwired">
            <div class="hd"><span class="tag gold">Not wired</span><h3>Collector latency history</h3></div>
            <p>collector_status holds current state only — avg_duration_ms has no history, so a latency trend cannot be drawn. Migration request: collector_status_history (segment_code text, collector text, sampled_at timestamptz, duration_ms int, ok boolean), one row per loop, retained 7 days. Until it exists this panel shows nothing rather than a shape.</p>
        </div>
    </div>
</div>
