@model PairAtInstant
@using CryptoSmithX.WebApp.Admin.Data
@{
    ViewData["Title"] = $"{Model.Pair} across platforms";
    var at = Model.At;

    // Signed, to the second, never a rounded age: the point of this table is that two rows can be
    // honest and still be minutes apart.
    string Lag(double? s) => s is null ? "—" : (s < 0 ? "+" : "−") + Format.Age(Math.Abs(s.Value));
    string N(double? v, int d = 2) => v is null ? "—" : Format.Num(v, d);
    string Pair2(double? a, double? b, int d = 0) => a is null && b is null ? "—" : $"{N(a, d)} / {N(b, d)}";

    var tfs = new (short Tf, string Label)[]
        { (1, "1m"), (5, "5m"), (15, "15m"), (60, "1h"), (240, "4h"), (720, "12h"), (1440, "1d") };
    var tfLabel = tfs.First(t => t.Tf == Model.Timeframe).Label;

}

<div class="page-head">
    <div class="t">
        <p class="eyebrow">Admin · <a href="/Admin/Pairs">pairs</a> · @Model.Pair</p>
        <h1>@Model.Pair across platforms</h1>
    </div>
    <p class="page-note">As of @Format.Utc(at). Rows are platforms. Each measurement carries its own lag because platforms are not observed together — the candles below are what share a clock.</p>
</div>

<form method="get" action="/Admin/Pairs/At/@Model.Base" style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;margin-bottom:14px">
    <input type="hidden" name="quote" value="@Model.Quote">
    <div class="field" style="width:230px">
        <label for="at">Moment (UTC)</label>
        <input id="at" name="at" type="text" value="@at.ToString("yyyy-MM-dd HH:mm:ss")" spellcheck="false">
    </div>
    <div class="field" style="width:110px">
        <label for="tf">Timeframe</label>
        <select id="tf" name="tf">
            @foreach (var (tf, label) in tfs)
            {
                <option value="@tf" selected="@(tf == Model.Timeframe)">@label</option>
            }
        </select>
    </div>
    <div class="field" style="width:110px">
        <label for="n">Windows</label>
        <input id="n" name="n" type="text" value="@Model.Windows.Count" spellcheck="false">
    </div>
    <button class="btn" type="submit">Show</button>
</form>

@* ── Top of book, one row per platform ───────────────────────────────────────────────────────── *@
<div class="section-h"><b>Top of book</b><i>@Model.Venues.Count platform@(Model.Venues.Count == 1 ? "" : "s")</i><hr></div>

<div class="panel scroll">
    <div class="th r-pair">
        <span>Platform</span><span>Symbol</span><span>State</span>
        <span style="justify-self:end">Price at</span>
        <span style="justify-self:end">Bid</span><span style="justify-self:end">Ask</span>
        <span style="justify-self:end">Spread bps</span>
        <span style="justify-self:end">Bid size</span><span style="justify-self:end">Ask size</span>
        <span style="justify-self:end">Last</span><span style="justify-self:end">Mark</span><span style="justify-self:end">Index</span>
        <span style="justify-self:end">Funding</span>
        <span style="justify-self:end">Open interest</span><span style="justify-self:end">Turnover 24h</span>
        <span style="justify-self:end">OI at</span>
        <span style="justify-self:end">Depth 10bps</span><span style="justify-self:end">Depth 25bps</span><span style="justify-self:end">Depth 50bps</span>
        <span style="justify-self:end">Depth at</span>
    </div>
    @foreach (var v in Model.Venues)
    {
        <div class="tr r-pair" style="@(v.Observed ? "" : "opacity:.6")">
            <span class="cell"><span class="name mono">@v.SegmentCode</span><span class="code">@v.ExchangeName</span></span>
            <span class="cell"><a class="name mono" href="/Admin/Instruments/Details/@v.InstrumentId">@v.Symbol</a><span class="code">@(v.ContractMultiplier == 1 ? "1 : 1" : $"× {v.ContractMultiplier}")</span></span>
            <span><span class="tag @(v.Observed && v.Collect ? "enabled" : "")">@(v.Observed ? (v.Collect ? "observed" : "not collected") : "no observation")</span></span>
            <span class="num muted" style="justify-self:end" title="@Format.Utc(v.ReceivedAt)">@Lag(v.PriceLagSeconds)</span>
            <span class="num" style="justify-self:end">@N(v.BidPrice, 4)</span>
            <span class="num" style="justify-self:end">@N(v.AskPrice, 4)</span>
            <span class="num" style="justify-self:end">@N(v.SpreadBps, 3)</span>
            @* Sizes are multiplied through the contract multiplier, or two platforms are not in the
               same units. The raw figure is in the title so nothing is hidden. *@
            <span class="num" style="justify-self:end" title="raw @N(v.BidSize, 4)">@N(v.BidSizeBase, 2)</span>
            <span class="num" style="justify-self:end" title="raw @N(v.AskSize, 4)">@N(v.AskSizeBase, 2)</span>
            <span class="num" style="justify-self:end">@N(v.LastPrice, 4)</span>
            <span class="num" style="justify-self:end">@N(v.MarkPrice, 4)</span>
            <span class="num" style="justify-self:end">@N(v.IndexPrice, 4)</span>
            <span class="num" style="justify-self:end">@N(v.FundingRate, 6)</span>
            <span class="num" style="justify-self:end">@N(v.OpenInterest, 0)</span>
            <span class="num" style="justify-self:end">@N(v.Turnover24h, 0)</span>
            <span class="num muted" style="justify-self:end">@Lag(v.OpenInterestLagSeconds)</span>
            <span class="num" style="justify-self:end">@Pair2(v.DepthBid10, v.DepthAsk10)</span>
            <span class="num" style="justify-self:end">@Pair2(v.DepthBid25, v.DepthAsk25)</span>
            <span class="num" style="justify-self:end">@Pair2(v.DepthBid50, v.DepthAsk50)</span>
            <span class="num muted" style="justify-self:end" title="@Format.Utc(v.DepthAt)">@Lag(v.DepthLagSeconds)</span>
        </div>
    }
</div>

<p class="panel-note" style="margin:12px 0 var(--gap-card)">
    Rows are <b>not</b> differenced against each other and this page states no cross-platform spread from them: poll passes are unsynchronised, a depth sweep across a large venue takes minutes, and the keep interval is set per segment, so one platform's newest observation before this instant can be seconds old while another's is minutes. The lags say which. Depth columns are bid / ask at that band. Sizes are shown in base units; hover for the venue's own contract figure. <b>—</b> means not measured and never zero — a size of zero is written as 0, because nothing resting at the touch is an observation.
</p>

@* ── Candles, one chart per platform, tied to one time scale ────────────────────────────────── *@
@* A genuinely financial chart, so it gets the real library rather than server SVG — the split
   recorded in plans/notes-charts-and-tradingview.md. Lightweight Charts is already self-hosted in
   wwwroot/vendor/ and already drives the instrument page; this is the same tool, one instance per
   platform, with the time scales tied so panning one pans all. data-live-skip because a tick's
   morph must never recurse into a canvas chart's subtree. *@
<div class="section-h"><b>Candles</b><i>@tfLabel · @Model.Windows.Count windows to @Model.Windows[^1].ToString("HH:mm")Z · zoom or pan any chart and the rest follow</i><hr></div>

<div style="display:flex;flex-direction:column;gap:12px" data-live-skip>
@foreach (var s in Model.Series)
{
    var json = System.Text.Json.JsonSerializer.Serialize(
        s.Candles.Select((c, i) => new
        {
            time = new DateTimeOffset(Model.Windows[i], TimeSpan.Zero).ToUnixTimeSeconds(),
            o = c is null ? (double?)null : c.Open,
            h = c is null ? (double?)null : c.High,
            l = c is null ? (double?)null : c.Low,
            c = c is null ? (double?)null : c.Close,
            v = c?.Volume ?? 0,
        }));
    <div class="panel">
        <div class="panel-h">
            <h2 style="font:var(--type-h3)">@s.SegmentCode <span class="code">@s.Symbol</span></h2>
            <span class="meta">@(s.Low is null ? "no bars in this window" : $"{Format.Num(s.Low, 4)} – {Format.Num(s.High, 4)}")@(s.Missing > 0 ? $" · {s.Missing} of {Model.Windows.Count} windows have no bar" : "")@(s.Incomplete > 0 ? $" · {s.Incomplete} partly covered" : "")@(s.NoVolume > 0 ? $" · {s.NoVolume} with no volume" : "")</span>
        </div>
        <div class="panel-b" style="padding:0">
            @if (s.Present.Count() >= 2)
            {
                <div class="chart-lwc" style="height:240px" data-candles="@json"></div>
            }
            else
            {
                <div class="empty"><h3>No candles</h3><p>This platform has fewer than two @tfLabel bars in the window shown.</p></div>
            }
        </div>
    </div>
}
</div>

<p class="panel-note" style="margin-top:12px">
    The charts share a time scale: zoom or pan any one of them and the others follow, so the same minute stays under the same place on every platform. A window a platform has no bar for is passed through as an empty slot rather than dropped — otherwise the surrounding candles slide together and a platform that went dark looks like it never stopped. Volume sits on its own scale per platform, because volumes differ across venues by orders of magnitude and one shared scale would flatten every smaller platform to nothing.
</p>

@* Inline, not a section: the layout renders only "head" and "live", and the instrument page
   loads its chart the same way. Manual cache-bust rather than asp-append-version — the Script
   TagHelper trips a Razor compiler bug on this SDK; bump v= on change. *@
@if (Model.Series.Any(x => x.Present.Count() >= 2))
{
    <script src="~/vendor/lightweight-charts/lightweight-charts-5.2.1.standalone.production.js?v=1"></script>
    <script src="~/pair-charts.js?v=1"></script>
}
