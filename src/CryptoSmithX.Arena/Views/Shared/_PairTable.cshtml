@model PairPageModel
@*
    The comparison table: seventeen columns, one row per venue, every figure carrying the age of the
    call that wrote it.

    THIS IS A PARTIAL ON PURPOSE. Blueprint §1: the live button raises an SSE stream that redraws
    THIS partial, not a second version of the page. A page that is drawn one way on the first paint
    and another way on every update has two renderers, and the second one is the one nobody reads.

    Everything decided rather than drawn — where a dash goes and where a zero goes, which end of a
    column is marked, what fades and by how much — happened in RowCells and Verdicts before this file
    ran. What is here is one loop over fourteen cells that all look the same. That is the intended
    division: the rules live where the compiler and xunit can see them.
*@
@functions {
    static string ToneToken(CallTone tone) => tone switch
    {
        CallTone.OpenInterest => "oi",
        CallTone.Depth => "depth",
        _ => "ticker"
    };

    static string InkClass(FigureInk ink) => ink switch
    {
        FigureInk.Unmeasured => " a-fig--unmeasured",
        FigureInk.Zero => " a-fig--zero",
        _ => ""
    };

    // The user units the path was computed in, which have to be the viewBox the element is drawn
    // with: an SVG whose viewBox disagrees with its box does not clip and does not overflow, it
    // silently rescales, and a sparkline at the wrong scale still looks like a sparkline.
    //
    // Depth 25bps is the one cell that holds a line AND a mirrored bar (rule 11), and the two share
    // one history slot rather than taking two, so its line is drawn at the height the mirror leaves.
    // Format.SplitSparkHeight carries the argument; RowCells computed the path at the same number.
    static string SparkH(MetricCellModel c) =>
        (c.MirrorBidWidth is not null ? Format.SplitSparkHeight : Format.SparkHeight)
            .ToString(System.Globalization.CultureInfo.InvariantCulture);

    static readonly string SparkW =
        Format.SparkWidth.ToString(System.Globalization.CultureInfo.InvariantCulture);

    // The chip's own hover, and the second half of it is the rule the reader cannot otherwise see.
    // BEST said "best in this column across the venues compared here" while a larger bid sat three
    // rows up in the same column wearing nothing — the degraded venue IS compared here, it is on
    // the page, in the column, with a figure printed, and no line anywhere on the surface said why
    // it had been left out of the ranking. One function for all four chips because TIGHT and WIDE
    // are the spread column's words for the same verdict, and four copies of a sentence are four
    // chances for one of them to keep saying the old thing.
    static string RankTitle(string end) =>
        end + " among the venues compared here — a figure whose call has gone "
        + "degraded is not ranked, and neither is the column it would have won";

    // The crossed book's own hover, and it is deliberately not RankTitle: this chip says why the row
    // is NOT in the comparison, so borrowing the sentence that explains a rank would be the fourth
    // chip claiming to have been ranked.
    const string CrossedTitle =
        "This venue's bid stands at or above its ask, so the figure beside it is the negative "
        + "spread that quotation implies — written as it stands. A crossed book is not a narrow "
        + "spread, so it is left out of this column's ranking at both ends.";
}
@{
    // The fold is a decided feature, so this page is guaranteed to be able to hold Kraken's book in
    // USD beside WEEX's in USDT. Whether it actually does decides how loudly the row has to say so.
    var mixedQuotes = Model.Rows.Select(r => r.Row.QuoteAsset).Distinct(StringComparer.Ordinal).Count() > 1;
}
@* data-live-region marks this element as one the live stream replaces in place. The stream sends
   THIS partial re-rendered, and arena-live.js patches the existing nodes rather than swapping the
   element: the horizontal scroll position of .a-table below lives in a node inside here, and a
   reader who scrolled right to read the depth bands must not be yanked back to bid every time a
   collector pass lands. *@
<section class="a-panel" data-live-region="table">
    <div class="a-table">
        <div class="a-table-inner">

            @* ── Call bands ──────────────────────────────────────────────────────────────────
               Three calls, three stretches, and each stretch is contiguous because the column order
               was chosen to make it so. Turnover sits among the ticker fields because it arrives in
               the ticker response — not beside open interest, where the admin console had it. *@
            <div class="a-bands">
                <span class="a-band a-band--venue">Venue</span>
                <span class="a-band a-band--ticker">Ticker call · one response</span>
                <span class="a-band a-band--oi">Oi call</span>
                <span class="a-band a-band--depth">Depth sweep</span>
            </div>

            <div class="a-eyebrows">
                <span class="a-e-venue">Platform</span>
                <span class="a-e-symbol">Symbol</span>
                <span>St</span>
                <span class="a-e-num">Bid</span>
                <span class="a-e-num">Ask</span>
                <span class="a-e-num">Spread bps</span>
                <span class="a-e-num">Bid size</span>
                <span class="a-e-num">Ask size</span>
                <span class="a-e-num">Last</span>
                <span class="a-e-num">Mark</span>
                <span class="a-e-num">Index</span>
                <span class="a-e-num">Funding</span>
                <span class="a-e-num">Turnover 24h</span>
                <span class="a-e-num">Open interest</span>
                <span class="a-e-num">Depth 10bps</span>
                <span class="a-e-num">Depth 25bps</span>
                <span class="a-e-num">Depth 50bps</span>
            </div>

            @foreach (var venue in Model.Rows)
            {
                var r = venue.Row;
                var strip = StripModel.Build(venue);
                var cells = RowCells.Build(venue, Model.Verdicts, Model.Scales);
                var perp = !string.Equals(r.SegmentKind, "spot", StringComparison.Ordinal);
                var quoteFolded = !string.Equals(r.QuoteAsset, Model.QuoteFamily, StringComparison.Ordinal);

                @* The absolute clocks live in the title. The columns that used to hold them were
                   dropped once every cell carried its own age. *@
                var rowTitle = $"Price {Format.Utc(r.ReceivedAt)} · Depth {Format.Utc(r.DepthAt)} · OI {Format.Utc(r.OpenInterestAt)}";

                <div class="a-row">

                    @* ── Venue ──────────────────────────────────────────────────────────────── *@
                    <span class="a-venue" title="@rowTitle">
                        <span class="a-venue-name">@r.ExchangeName</span>
                        <span class="a-tag @(perp ? "a-tag--perp" : "a-tag--spot")">@r.SegmentKind</span>

                        <span class="a-strip-wrap">
                            @* The one gradient in the system, and it is data. Ticks are positioned by
                               each call's age against ITS OWN window, so three calls on one row can
                               sit in three places while their raw ages look alike. *@
                            <span class="a-strip">
                                @if (strip.Placed.Count > 0)
                                {
                                    <i class="a-strip-span" style="left:@StripModel.Pct(strip.SpanFrom);width:@strip.SpanWidth"></i>
                                    @foreach (var call in strip.Placed)
                                    {
                                        <i class="a-strip-tick@(call.Position >= 1 ? " a-strip-tick--spent" : "")"
                                           style="left:@StripModel.Pct(call.Position)"
                                           data-at="@call.InstantMs"
                                           data-win="@call.WindowSeconds?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                           title="@call.Label"></i>
                                    }
                                }
                            </span>

                            @* The two ends NAME the call sitting at each end of the gradient, chosen
                               by that call's share of its own window — the same arithmetic the ticks
                               are placed by. They used to be the smallest and largest RAW AGE, which
                               under three windows is a different question and routinely a different
                               call: the strip printed "fresh 23 s" under the green end for a price
                               call at 230% of its cadence. StripModel carries the whole account. *@
                            <span class="a-strip-ends">
                                <span data-fresh title="@StripModel.EndTitle(strip.LeastSpent, StripModel.LeastSpentLabel)">@(strip.Degraded ? "" : StripModel.EndText(strip.LeastSpent))</span>
                                <span data-old class="@(strip.MostSpentPastWindow ? "a-spent" : "")"
                                      title="@StripModel.EndTitle(strip.MostSpent, StripModel.MostSpentLabel)">
                                    @if (strip.MostSpentPastWindow)
                                    {
                                        <i class="a-tri">△</i>
                                    }
                                    @(strip.Degraded ? "live data degraded" : StripModel.EndText(strip.MostSpent))
                                </span>
                            </span>

                            <span class="a-strip-calls">
                                @foreach (var call in strip.Calls)
                                {
                                    <span class="@(call.PastWindow ? "a-spent" : "")"
                                          data-label="@call.Label"
                                          data-at="@call.InstantMs"
                                          data-win="@call.WindowSeconds?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)">@call.Label @Format.ShortAge(call.AgeSeconds)</span>
                                }
                            </span>
                        </span>
                    </span>

                    @* ── Symbol ─────────────────────────────────────────────────────────────── *@
                    <span class="a-symbol">
                        <span class="a-symbol-code" title="@r.Symbol">@r.Symbol</span>
                        <span class="a-symbol-meta">
                            @* The venue's real quote, always. The heading folds; the row never does —
                               that is the whole contract of 0024. It takes the accent when it differs
                               from the folded heading, because that is what the reader has to notice
                               before comparing a single figure across two rows. *@
                            <span class="@(quoteFolded ? "a-quote-folded" : "")"
                                  title="@(quoteFolded
                                      ? $"This venue quotes in {r.QuoteAsset}; the page addresses the pair as {Model.BaseFamily}/{Model.QuoteFamily}"
                                      : $"Quoted in {r.QuoteAsset}")">@r.QuoteAsset</span>
                            ·
                            @(r.ContractMultiplier == 1 ? "1 : 1" : "× " + Format.Num(r.ContractMultiplier, 0))
                        </span>
                        @if (!string.Equals(r.Status, "trading", StringComparison.Ordinal))
                        {
                            @* An instrument in halt, post_only or reduce_only stays in the comparison
                               carrying its state. Vanishing without a mark is the same lie as a zero
                               standing in for a dash — which is why the query filters on
                               `status <> 'delisted'` rather than on `= 'trading'`. *@
                            <span class="a-tag a-tag--hold" title="Venue state since @Format.Utc(r.StatusChangedAt)">@r.Status</span>
                        }
                    </span>

                    @* ── State ──────────────────────────────────────────────────────────────── *@
                    <span class="a-state">
                        @if (r.ReceivedAt is null)
                        {
                            <i class="a-dot a-dot--none" title="No data — nothing has been observed for this instrument"></i>
                        }
                        else
                        {
                            <i class="a-dot" title="Observed — a snapshot is present"></i>
                        }
                    </span>

                    @* ── Fourteen metric cells, one loop ─────────────────────────────────────
                       data-at is the ABSOLUTE instant of the call, in Unix ms, and data-win its
                       window in seconds. The script advances the age from those against a monotonic
                       anchor; it never reads the visitor's wall clock, and it never reads a
                       pre-computed age. *@
                    @foreach (var c in cells)
                    {
                        var tint = c.Tint switch
                        {
                            CallTone.OpenInterest => " a-cell--oi",
                            CallTone.Depth => " a-cell--depth",
                            _ => ""
                        };
                        @* Parenthesised deliberately. Razor reads `a-cell@tint` as an email
                           address — the character before the @ is a letter — and emits it verbatim,
                           so the class became the literal "a-cell@tint": no flex column, no vertical
                           order, no call wash, on all seventy cells. The rendered page is the only
                           place that shows it. *@
                        <span class="a-cell@(tint)"
                              style="--w:@c.Weight.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                              title="@c.Title"
                              data-at="@c.InstantMs"
                              data-win="@c.WindowSeconds?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                              data-rank="@c.RankGroup">

                            @* The mark slot. Reserved whether or not anything is in it, so figures
                               sit on one line across the row. *@
                            <span class="a-mark">
                                @if (c.Band == SpreadBand.Crossed)
                                {
                                    @* NOT a rank, so no ground and no rank title: rule 9 gives a
                                       ground to BEST and WORST and to nothing else, and this row
                                       won nothing and lost nothing. It is a fact about that venue's
                                       own two figures, and it stays true however old they get —
                                       which is also why the withdrawal in arena-ages.js names the
                                       three rank classes rather than emptying the mark slot. *@
                                    <span class="a-tag a-tag--crossed" title="@CrossedTitle">Crossed</span>
                                }
                                else if (c.Band != SpreadBand.None)
                                {
                                    <span class="a-tag @(c.Band == SpreadBand.Wide ? "a-tag--worst" : "a-tag--tight")"
                                          title="@RankTitle(c.Band == SpreadBand.Wide ? "Widest spread" : "Narrowest spread")">@(c.Band == SpreadBand.Wide ? "Wide" : "Tight")</span>
                                }
                                @if (c.Verdict == Verdict.Best)
                                {
                                    <span class="a-tag a-tag--best" title="@RankTitle("Best in this column")">Best</span>
                                }
                                else if (c.Verdict == Verdict.Worst)
                                {
                                    <span class="a-tag a-tag--worst" title="@RankTitle("Worst in this column")">Worst</span>
                                }
                                @if (c.Note is not null)
                                {
                                    <span class="a-mark-note" title="Normalised to a day from the venue's own interval. Not ranked.">@c.Note</span>
                                }
                            </span>

                            @if (c.Second is null)
                            {
                                <span class="a-fig@(InkClass(c.Ink))">@c.Text</span>
                            }
                            else
                            {
                                <span class="a-pair">
                                    <span class="a-fig@(InkClass(c.Ink))">@c.Text</span>
                                    <span class="a-pair-sep">/</span>
                                    <span class="a-fig@(InkClass(c.SecondInk))">@c.Second</span>
                                </span>
                            }

                            @* THE HISTORY SLOT, and it is here whatever goes in it — a line, a
                               bar, a mirrored bar, a line and a mirrored bar together on the one
                               column rule 11 gives both to, or nothing at all on mark and index,
                               which rule 11 gives no second dimension. One element with one height
                               rather than four elements with four, because a column that reserves
                               three pixels beside a column that reserves eleven puts their figures
                               on two different lines across the row — measured, and it did. *@
                            <span class="a-hist">
                                @if (c.SparkPath is not null)
                                {
                                    <svg class="a-spark" viewBox="0 0 @SparkW @SparkH(c)"
                                         width="@SparkW" height="@SparkH(c)" aria-hidden="true">
                                        <path d="@c.SparkPath" fill="none" stroke-width="1"
                                              stroke="var(--spark-@(ToneToken(c.SparkTone))@(c.SparkHot ? "-hot" : ""))"></path>
                                    </svg>
                                }
                                @if (c.MirrorBidWidth is not null)
                                {
                                    <span class="a-mirror" aria-hidden="true">
                                        <span class="a-mirror-bid"><i style="width:@c.MirrorBidWidth"></i></span>
                                        <span class="a-mirror-ask"><i style="width:@c.MirrorAskWidth"></i></span>
                                    </span>
                                }
                                @if (c.BarWidth is not null)
                                {
                                    <span class="a-bar" aria-hidden="true">
                                        <i style="width:@c.BarWidth"></i>
                                    </span>
                                }
                            </span>

                            @* The age never fades: a ghosted figure still has to be able to say when
                               it died. It is a SIBLING of the faded children for that reason. *@
                            <span class="a-age@(c.AgeMissing ? " a-age--missing" : c.AgePastWindow ? " a-age--spent" : "")">
                                @if (c.AgePastWindow)
                                {
                                    <i class="a-tri">△</i>
                                }
                                @c.AgeText
                            </span>
                        </span>
                    }
                </div>
            }
        </div>
    </div>

    <div class="a-notebar">
        <p class="a-note">
            Every figure carries the age of the call that wrote it and fades across that call's own
            window — price, open interest and the depth sweep are three calls with three clocks, and
            each cell's window is in its hover. <b>△</b> means the count is no longer being graded;
            <b>degraded</b> means it has stopped meaning anything. <b>Crossed</b> on the spread
            means that venue's bid stands at or above its ask; the figure is the negative spread
            that implies, written as it stands, and the row is left out of the spread ranking
            because a crossed book is not a narrow one. The scale in the venue cell is
            measured in windows and not in seconds, so the two names under it are the call least far
            into its own window and the call furthest into its own — which on a venue whose depth
            pass is minutes wide is not the same pair as the youngest and oldest ages. Depth is bid / ask at that band.
            <b>—</b> is not measured and is never a zero; a <b>0</b> is an observation. Sizes and open
            interest are in base units through the venue's contract multiplier, with the venue's own
            figure in the hover. Funding is quoted per payment and carries its interval and a
            normalised per-day figure; it is <b>not ranked</b>, because which direction is good depends
            on your side of the trade. A line under a figure is that figure's last 25 hours in its
            call's own colour, broken at every hour the venue has no row for; bid, ask and last share
            one line because they share one price series. A <b>degraded</b> figure takes no rank and
            no bar: it sets no column maximum, wins nothing and loses nothing, and when the call under
            a mark goes degraded while this page is open the column drops both its marks and its bars
            rather than leave half a comparison standing.@if (mixedQuotes)
            {<text> <b>Best</b> and <b>worst</b> rank only rows quoting in the same asset for anything
            priced in the quote currency — this page holds more than one quote.</text>}
        </p>
    </div>
</section>
