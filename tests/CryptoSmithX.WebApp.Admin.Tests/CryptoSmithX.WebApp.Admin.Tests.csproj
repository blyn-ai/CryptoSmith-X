<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CryptoSmithX.WebApp.Admin.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CryptoSmithX.WebApp.Admin\CryptoSmithX.WebApp.Admin.csproj" />
  </ItemGroup>
  <!-- The public landing page, copied beside the test binary because its CONTENT is what is under
       test rather than a behaviour a call can reach. Same convention as the Studio suite: copied by
       the csproj rather than located by walking up from the working directory, so the assertion
       fails on the page changing and never on where the tests were run from. -->
  <ItemGroup>
    <Content Include="..\..\src\CryptoSmithX.WebApp.Admin\Program.cs"
             Link="surface\Program.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Admin\Views\Home\Index.cshtml"
             Link="surface\Landing.cshtml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
