<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CryptoSmithX.WebApp.Agent.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CryptoSmithX.WebApp.Agent\CryptoSmithX.WebApp.Agent.csproj" />
  </ItemGroup>

  <!-- Разметка и лист стилей читаются тестом как ФАЙЛЫ: правило «спрятанному атрибутом нужна
       пара [hidden]» проверяется только так, компилятору оно не видно. -->
  <ItemGroup>
    <Content Include="..\..\src\CryptoSmithX.WebApp.Agent\wwwroot\agent.css"
             Link="surface\agent.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Agent\Views\Parameters\Index.cshtml"
             Link="surface\Index.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Agent\Views\Parameters\_Field.cshtml"
             Link="surface\_Field.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Agent\Views\Shared\_Layout.cshtml"
             Link="surface\_Layout.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Agent\wwwroot\parameters.js"
             Link="surface\parameters.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
