<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CryptoSmithX.MarketData.Connectors.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CryptoSmithX.MarketData.Connectors\CryptoSmithX.MarketData.Connectors.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\kraken\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\kraken-ws\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\weex\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\dydx\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\synthetix\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\nado\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\gmx\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\hyperliquid\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\binance\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- binance-ws holds captured wire frames, not only .json: the depth diff run is line-delimited
         (.jsonl) and the routing evidence is an annotated transcript (.txt). -->
    <None Include="Fixtures\binance-ws\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\binance-ws\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\binance-ws\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- weex-ws holds captured wire frames, not only .json: the delta run is line-delimited
         (.jsonl) and the ping/unsubscribe/close captures are annotated transcripts (.txt). -->
    <None Include="Fixtures\weex-ws\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\weex-ws\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\weex-ws\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- aster holds one non-JSON capture too: openinteresthist_404.html, the CloudFront-served HTML
         body /futures/data/openInterestHist answers on this venue (blueprint §1.1/§4.2) — the shape
         the OI-history "return [] instead of calling this at all" behaviour exists because of. -->
    <None Include="Fixtures\aster\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\aster\*.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\aster-ws\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\aster-ws\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\aster-ws\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
