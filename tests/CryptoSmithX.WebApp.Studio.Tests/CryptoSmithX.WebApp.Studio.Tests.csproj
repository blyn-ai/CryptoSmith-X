<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CryptoSmithX.WebApp.Studio.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CryptoSmithX.WebApp.Studio\CryptoSmithX.WebApp.Studio.csproj" />
  </ItemGroup>
  <!-- The two files that have to keep saying the same sentence: the view that marks the element and
       the script that rewrites it every second. Copied beside the test binary rather than located by
       walking up from it, so the assertion fails on the words changing and never on where the tests
       were run from. Same convention as the connector fixtures. -->
  <ItemGroup>
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\wwwroot\studio-ages.js"
             Link="surface\studio-ages.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\Views\Shared\_Statement.cshtml"
             Link="surface\_Statement.cshtml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Three more files whose CONTENT is the thing under test rather than a behaviour a call can
       reach: the route templates and the two registrations in Program.cs, the address the pair page
       emits for its own live stream, and the sentence the board prints when it is showing fewer
       pairs than matched. Each is a rule that can be deleted while everything still compiles and
       every other test still passes. -->
  <ItemGroup>
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\Program.cs"
             Link="surface\Program.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\Controllers\PairsController.cs"
             Link="surface\PairsController.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\Views\Pairs\Pair.cshtml"
             Link="surface\Pair.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\Views\Pairs\Index.cshtml"
             Link="surface\Index.cshtml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The stylesheet and the table that emits into it. Nothing about a design system's rules is
       reachable from a method call: "every history slot is the same height", "a number is never
       wrapped in a Tag" and "no rule is defined that nothing emits" are all properties of these two
       files' TEXT, and every one of them was broken while the project built clean and every other
       test passed. So they are read here. See DesignSystemTests. -->
  <ItemGroup>
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\wwwroot\studio.css"
             Link="surface\studio.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\Views\Shared\_PairTable.cshtml"
             Link="surface\_PairTable.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\Views\Shared\_Layout.cshtml"
             Link="surface\_Layout.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\Views\Pairs\PairNotFound.cshtml"
             Link="surface\PairNotFound.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\Views\Shared\_Stamps.cshtml"
             Link="surface\_Stamps.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\wwwroot\studio-live.js"
             Link="surface\studio-live.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\wwwroot\studio-candles.js"
             Link="surface\studio-candles.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\Views\PairsV2\Asset.cshtml"
             Link="surface\AssetV2.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\wwwroot\studio-v2.css"
             Link="surface\studio-v2.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\wwwroot\studio-v2.js"
             Link="surface\studio-v2.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\Views\PairsV2\_V2Table.cshtml"
             Link="surface\_V2Table.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\Views\PairsV2\_V2Now.cshtml"
             Link="surface\_V2Now.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\Views\Pairs\_VenueDetail.cshtml"
             Link="surface\_VenueDetail.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\Views\Pairs\_AssetRegistry.cshtml"
             Link="surface\_AssetRegistry.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\wwwroot\studio-disclose.js"
             Link="surface\studio-disclose.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The design system's token files and Studio's vendored copies of them, both trees, so a test
       can say what "vendored" means: byte-identical, except where the copy argues its deviation in
       its own header. The three identity-slot tokens the Iconography exception added went missing
       from the copy with no note at all, which reads as drift rather than as a decision, and an
       identity mark ported into this surface would have had its slot height dropped at parse time
       with no error and no console message. -->
  <ItemGroup>
    <Content Include="..\..\src\CryptoSmithX.WebApp.Studio\wwwroot\ds\tokens\*.css"
             Link="surface\ds-vendored\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\web\ds-studio\tokens\*.css"
             Link="surface\ds-system\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
